#!/data/data/com.mio/files/usr/bin/sh
#
# so - `swset` ile arka plana konan videonun sesini açar/kapatır.
#
# Kullanım:
#   so              Arka plandaki videonun sesini açar
#   so <dosya>      Videoyu arka plana koyar ve sesini açar
#   so off          Sesi kapatır (video sessiz oynamaya devam eder)
#   so ses          Ses akışını açar (eller serbest, tekrar tekrar `so` yazmadan)
#   so ses kapat    Ses akışını kapatır
#   so ses +|-      Ses seviyesini arttırır/azaltır (eller serbest, oturum boyunca çalışır)
#   so stop         Sesi durdurur ve arka planı temizler
#   so status       Şu anki durumu gösterir
#   so --help       Bu yardımı gösterir
#
# Notlar:
#   * Video, `swset` ile ayarlandığında varsayılan olarak sessizdir.
#     Ses sadece bu komutla açılır.
#   * Videonun kendi sesi yoksa, aynı isimli bir ses dosyası varsa
#     (video.mp4 + video.mp3 gibi) o dosya çalınır.

if [ -z "${PREFIX:-}" ]; then
    PREFIX=/data/data/com.mio/files/usr
fi

ACTION_SET_AUDIO="com.termux.mio.action.SET_AUDIO"
ACTION_STATUS="com.termux.mio.action.STATUS"
ACTION_AUDIO_STREAM="com.termux.mio.action.AUDIO_STREAM"

REQUEST_DIR="$HOME/.termux/mio"
REQUEST_FILE="$REQUEST_DIR/request"

usage() {
    cat <<EOF
Kullanım: so [seçenek] [dosya]

  so             Arka plandaki videonun sesini açar.
  so <dosya>     Videoyu arka plana koyar ve sesini açar.
  so off         Sesi kapatır.
  so ses         Ses akışını açar (eller serbest; ses açık kalır).
  so ses kapat   Ses akışını kapatır.
  so ses +|-     Ses seviyesini arttırır/azaltır.
  so stop        Sesi ve arka planı durdurur.
  so status      Şu anki durumu gösterir.
  so --help      Bu yardımı gösterir.

Fotoğraf/video ayarlamak için: swset <dosya>
EOF
}

run_am() {
    if [ -x "$PREFIX/bin/termux-am" ]; then
        "$PREFIX/bin/termux-am" "$@"
    elif command -v termux-am >/dev/null 2>&1; then
        termux-am "$@"
    else
        /system/bin/am "$@"
    fi
}

send_command() {
    if run_am broadcast "$@" >/dev/null 2>&1; then
        return 0
    fi
    # Yedek yol: servise startservice ile gönder
    run_am startservice -n com.termux/com.termux.app.TermuxService "$@" >/dev/null 2>&1
}

write_request() {
    mkdir -p "$REQUEST_DIR" 2>/dev/null
    {
        printf 'created=%s\n' "$(date +%s 2>/dev/null || echo 0)"
        printf '%s\n' "$@"
    } > "$REQUEST_FILE" 2>/dev/null
}

absolute_path() {
    case "$1" in
        /*) printf '%s' "$1" ;;
        "~/"*) printf '%s/%s' "$HOME" "${1#\~/}" ;;
        *) printf '%s/%s' "$(pwd)" "$1" ;;
    esac
}

if [ $# -eq 0 ]; then
    write_request "command=so" "name=" "media_type=video" "audio=1" "dir=$(pwd)"
    send_command -a "$ACTION_SET_AUDIO" --es mode on || exit 1
    exit 0
fi

case "$1" in
    -h|--help|help)
        usage
        exit 0
        ;;
    ses|audio|stream|unmute|acik-tut)
        case "$2" in
            kapat|off|sessiz|mute)
                write_request "command=so" "name=" "media_type=video" "audio=0" "dir=$(pwd)"
                send_command -a "$ACTION_AUDIO_STREAM" --es mode off || exit 1
                printf 'so: ses akışı kapatıldı\n'
                ;;
            +|arttir|arttır|up)
                send_command -a "$ACTION_AUDIO_STREAM" --es mode volume-up || exit 1
                printf 'so: ses seviyesi arttırıldı\n'
                ;;
            -|azalt|down)
                send_command -a "$ACTION_AUDIO_STREAM" --es mode volume-down || exit 1
                printf 'so: ses seviyesi azaltıldı\n'
                ;;
            *)
                write_request "command=so" "name=" "media_type=video" "audio=1" "dir=$(pwd)"
                send_command -a "$ACTION_AUDIO_STREAM" --es mode on || exit 1
                printf 'so: ses akışı açıldı (ses açık kalacak)\n'
                printf 'so: ses duyulmuyorsa video sessiz olabilir; menüdeki uyarıya bak\n'
                ;;
        esac
        exit 0
        ;;
    off|kapat|sessiz|mute)
        write_request "command=so" "name=" "media_type=video" "audio=0" "dir=$(pwd)"
        send_command -a "$ACTION_SET_AUDIO" --es mode off || exit 1
        exit 0
        ;;
    stop|durdur)
        write_request "command=so" "name=" "media_type=video" "audio=0" "dir=$(pwd)"
        send_command -a "$ACTION_SET_AUDIO" --es mode stop || exit 1
        exit 0
        ;;
    status|durum)
        send_command -a "$ACTION_STATUS" || exit 1
        exit 0
        ;;
    on|ac)
        shift
        if [ $# -eq 0 ]; then
            write_request "command=so" "name=" "media_type=video" "audio=1" "dir=$(pwd)"
            send_command -a "$ACTION_SET_AUDIO" --es mode on || exit 1
            exit 0
        fi
        FILE="$*"
        ;;
    *)
        FILE="$*"
        ;;
esac

FULL_PATH="$(absolute_path "$FILE")"
write_request "command=so" "name=$FULL_PATH" "media_type=video" "audio=1" "dir=$(pwd)"

if ! send_command -a "$ACTION_SET_AUDIO" --es mode on; then
    printf 'so: komut uygulamaya iletilemedi, Termux uygulaması açık mı?\n' >&2
    exit 1
fi

printf 'so: "%s" arka plana konuyor ve sesi açılıyor\n' "$FILE"
exit 0
