        exit $?
        ;;
    renk|color|renkler|colors)
        if [ $# -eq 0 ]; then
            send "$ACTION_COLORS" --es mode status
            exit $?
        fi
        case "$1" in
            sifirla|sıfırla|reset|varsayilan|varsayılan)
                send "$ACTION_COLORS" --es mode reset
                exit $?
                ;;
            *)
                if [ $# -lt 2 ]; then
                    printf 'mio: kullanım: mio renk <ad> <#RRGGBB>\n' >&2
                    exit 2
                fi
                send "$ACTION_COLORS" --es mode set --es key "$1" --es value "$2"
                exit $?
                ;;
        esac
        ;;
    tema|theme)
        if [ $# -eq 0 ]; then
            printf 'mio: temalar: varsayilan, matrix, gece, mor, sicak\n' >&2
            exit 2
        fi
        send "$ACTION_COLORS" --es mode theme --es name "$1"
        exit $?
        ;;
    tam|tamekran|fullscreen|full)
        send "$ACTION_FULLSCREEN"
        exit $?
        ;;
    ses|ses-tuslari|volume|vol)
        case "$1" in
            +|arttir|arttır|up)
                send "$ACTION_AUDIO_STREAM" --es mode volume-up
                ;;
            -|azalt|down)
                send "$ACTION_AUDIO_STREAM" --es mode volume-down
                ;;
            *)
                send "$ACTION_VOLUME_KEYS"
                ;;
        esac
        exit $?
        ;;
    paket|paketler|packages)
        if [ $# -eq 0 ]; then
            pkg_list
            exit $?
        fi
        PKG_ACTION="$1"
        shift
        case "$PKG_ACTION" in
            kur|kur-fix|install|ekle|add|yukle|yükle)
                if [ $# -eq 0 ]; then
                    printf 'mio: kullanım: mio paket kur <ad>\n' >&2
                    exit 2
                fi
                pkg_install "$1"
                exit $?
                ;;
            guncelle|güncelle|update|upgrade)
                pkg_update_all
                exit $?
                ;;
            baslat|başlat|start|startup|start-up)
                pkg_startup_all
                exit $?
                ;;
            sifirla|sıfırla|ornek|örnek|template|init)
                pkg_create_template
                exit $?
                ;;
            log|gunluk|günlük)
                if [ $# -eq 0 ]; then
                    printf 'mio: kullanım: mio paket log <ad>\n' >&2
                    exit 2
                fi
                pkg_log "$1"
                exit $?
                ;;
            liste|list|durum|status)
                pkg_list
                exit $?
                ;;
            *)
                printf 'mio: bilinmeyen paket komutu \"%s\"\n' "$PKG_ACTION" >&2
                printf 'Kullanım: mio paket [liste|kur <ad>|guncelle|baslat|sifirla|log <ad>]\n' >&2
                exit 2
                ;;
        esac
        ;;
    pkg)
        if [ $# -eq 0 ]; then
            if [ -x "$PREFIX/bin/pkg" ]; then
                mio_run_pkg --help
                exit $?
            fi
            pkg_list
            exit $?
        fi
        case "$1" in
            kur-fix|baslat|başlat|sifirla|sıfırla|ornek|örnek|template|init|log|gunluk|günlük)
                PKG_ACTION="$1"
                shift
                case "$PKG_ACTION" in
                    kur-fix)
                        [ $# -gt 0 ] || { printf 'mio: kullanım: mio paket kur <ad>\n' >&2; exit 2; }
                        pkg_install "$1"
                        exit $?
                        ;;
                    baslat|başlat) pkg_startup_all; exit $? ;;
                    sifirla|sıfırla|ornek|örnek|template|init) pkg_create_template; exit $? ;;
                    log|gunluk|günlük)
                        [ $# -gt 0 ] || { printf 'mio: kullanım: mio paket log <ad>\n' >&2; exit 2; }
                        pkg_log "$1"
                        exit $?
                        ;;
                esac
                ;;
            kur)
                shift
                if [ $# -eq 1 ] && pkg_find "$1" >/dev/null 2>&1; then
                    pkg_install "$1"
                    exit $?
                fi
                mio_run_pkg install "$@"
                exit $?
                ;;
            *)
                mio_run_pkg "$@"
                exit $?
                ;;
        esac
        ;;
    install|kur)
        mio_install_cmd "$@"
        exit $?
        ;;
    teshis|teşhis|diagnose|check|doctor)
        diagnose
        exit 0
        ;;
    menuler|menüler|menu-bar|bar)
        send "$ACTION_STYLE" --es mode toggle-bars
        exit $?
        ;;
    ses|volume|vol)
        case "${1:-}" in
            +|artir|arttir|up) send "$ACTION_VOLUME_KEYS" --es mode up ;;
            -|azalt|down) send "$ACTION_VOLUME_KEYS" --es mode down ;;
            durum|status) send "$ACTION_VOLUME_KEYS" --es mode status ;;
            *) printf 'Kullanım: mio ses + | - | durum\n'; exit 1 ;;
        esac
        exit $?
        ;;
    apt-fix|aptfix|onar)
        # Her şeyi sırayla onarır ve ağa çıkmadan doğrular. Tek komutla "çalışıyor/çalışmıyor" der.
        printf '=== mio apt onarımı ===\n'

        # 0) önek dizin izinlerini ONARIMDAN ÖNCE ölç: paketler 0555 dizin bırakabiliyor ve
        #    dpkg o zaman "unable to create ...dpkg-new: Permission denied" veriyor.
        #    Değer preflight'tan (MIO_PREFIX_RO) geliyor; orada ölçüldü çünkü fix_sources
        #    zaten install_apt_wrappers üzerinden izinleri düzeltiyor.
        _ro_before=${MIO_PREFIX_RO:-}
        if [ -z "$_ro_before" ]; then
            _ro_before=0
            for _d in "$PREFIX/share" "$PREFIX/bin" "$PREFIX/lib" "$PREFIX/etc" "$PREFIX/var" "$PREFIX/tmp"; do
                [ -d "$_d" ] || continue
                [ -w "$_d" ] || _ro_before=$((_ro_before + 1))
            done
        fi
        mio_fix_prefix_perms

        # 1) eksik dizinler
        for d in "$PREFIX/var/lib/apt/lists/partial" "$PREFIX/var/cache/apt/archives/partial" \
                 "$PREFIX/var/lib/dpkg" "$PREFIX/var/log/apt" "$PREFIX/etc/apt/trusted.gpg.d" \
                 "$PREFIX/etc/apt/apt.conf.d" "$PREFIX/etc/apt/sources.list.d" "$PREFIX/tmp"; do
            [ -d "$d" ] || { mkdir -p "$d" 2>/dev/null && printf '  oluşturuldu: %s\n' "$d"; }
        done
        [ -f "$PREFIX/var/lib/dpkg/status" ] || : > "$PREFIX/var/lib/dpkg/status"

        # 2) kaynak dosyası
        if [ ! -s "$PREFIX/etc/apt/sources.list" ] || [ -d "$PREFIX/etc/apt/sources.list" ]; then
            fix_sources
            printf '  sources.list yeniden yazıldı\n'
        fi

        # 3) apt yöntemleri çalıştırılabilir mi
        bad=0
        for m in "$PREFIX/lib/apt/methods"/*; do
            [ -f "$m" ] || continue
            [ -x "$m" ] || chmod 755 "$m" 2>/dev/null
            [ -x "$m" ] || bad=$((bad + 1))
        done
        [ "$bad" -eq 0 ] && printf '  apt yöntemleri: tamam\n' || printf '  apt yöntemleri: %s dosya çalıştırılamıyor\n' "$bad"

        # 4) dpkg'nin aradığı programlar (apt kaynağında DPkg::Path'e bakıyor)
        missing_path=""
        for prog in sh rm tar diff dpkg-deb start-stop-daemon; do
            if [ ! -e "$PREFIX/bin/$prog" ]; then
                missing_path="$missing_path $prog"
            elif [ ! -x "$PREFIX/bin/$prog" ]; then
                chmod 755 "$PREFIX/bin/$prog" 2>/dev/null
            fi
        done
        if [ -n "$missing_path" ]; then
            printf '  EKSİK PROGRAM:%s\n' "$missing_path"
        else
            printf '  dpkg yardımcı programları: tamam (DPkg::Path=%s/bin)\n' "$PREFIX"
        fi

        # 4b) dpkg dosya listeleri: "files list file ... is missing final newline"
        #     hatası kurulumu tamamen durdurur; \0 dolgusu temizlenir ve sonu
        #     satır sonuyla bitmeyen *.list dosyalarına satır sonu eklenir
        if [ -d "$PREFIX/var/lib/dpkg/info" ]; then
            fixed_lists=0
            for _lt in "$PREFIX"/var/lib/dpkg/info/*.mio-tmp*; do
                [ -e "$_lt" ] && rm -f "$_lt" 2>/dev/null && fixed_lists=$((fixed_lists + 1))
            done
            for lf in "$PREFIX"/var/lib/dpkg/info/*.list; do
                [ -f "$lf" ] || continue
                _lftmp="$lf.mio-tmp.$$"
                tr -d '\000' < "$lf" > "$_lftmp" 2>/dev/null || { rm -f "$_lftmp" 2>/dev/null; continue; }
                if [ -s "$_lftmp" ]; then
                    lastc=$(tail -c 1 "$_lftmp" 2>/dev/null | tr '\000\n' 'ZN')
                    if [ "$lastc" != "N" ]; then
                        lastline=$(tail -n 1 "$_lftmp" 2>/dev/null)
                        case "$lastline" in
                            /*) printf '\n' >> "$_lftmp" 2>/dev/null ;;
                            *)  awk 'NR > 1 { print prev } { prev = $0 } END { if (NR > 1) print prev }' \
                                    "$_lftmp" > "$_lftmp.2" 2>/dev/null &&
                                    mv "$_lftmp.2" "$_lftmp" 2>/dev/null
                                [ -s "$_lftmp" ] && [ "$(tail -c 1 "$_lftmp" 2>/dev/null | tr '\000\n' 'ZN')" = "N" ] ||
                                    printf '\n' >> "$_lftmp" 2>/dev/null ;;
                        esac
                    fi
                    [ -s "$_lftmp" ] || printf '/.\n' > "$_lftmp" 2>/dev/null
                else
                    printf '/.\n' > "$_lftmp" 2>/dev/null
                fi
                if ! cmp -s "$lf" "$_lftmp" 2>/dev/null; then
                    mv "$_lftmp" "$lf" 2>/dev/null && chmod 644 "$lf" 2>/dev/null &&
                        fixed_lists=$((fixed_lists + 1))
                else
                    rm -f "$_lftmp" 2>/dev/null
                fi
            done
            : > "$PREFIX/var/lib/dpkg/.mio-lists-nul-cleaned" 2>/dev/null
            [ "$fixed_lists" -gt 0 ] && printf '  dpkg dosya listeleri onarıldı: %s\n' "$fixed_lists" \
                || printf '  dpkg dosya listeleri: tamam\n'
        fi

        # 5) apt.conf.d dosyalarını yeniden yaz
        rm -f "$PREFIX/etc/apt/apt.conf.d/zz-mio-sources.conf" "$PREFIX/etc/apt/apt.conf.d/mio-apt.conf" 2>/dev/null
        MIO_NO_APT_CONFIG=0 ensure_apt_config >/dev/null 2>&1
        printf '  apt yapılandırması yazıldı\n'

        # 6) sarmalayıcıları tazele (SİLEREK DEĞİL: silinirse gerçek araç `*.mio-real` yedeğinden gelir)
        install_apt_wrappers >/dev/null 2>&1
        for n in pkg apt apt-get; do
            if [ -x "$PREFIX/bin/$n" ]; then
                printf '  %s: hazır\n' "$n"
            elif [ -x "$PREFIX/bin/$n.mio-real" ]; then
                # sarmalayıcı yazılamadıysa gerçek aracı eski yerine bağla
                cp "$PREFIX/bin/$n.mio-real" "$PREFIX/bin/$n" 2>/dev/null &&
                    chmod 755 "$PREFIX/bin/$n" 2>/dev/null &&
                    printf '  %s: yedekten geri getirildi\n' "$n"
            else
                printf '  %s: YOK (%s.mio-real da yok)\n' "$n" "$n"
            fi
        done
        # dpkg sarmalayıcısı: deb içindeki com.termux yollarını com.mio ya çevirir (unpack hatası)
        if [ -x "$PREFIX/bin/dpkg" ] && grep -q "MIO_DPKG_WRAPPER_VERSION" "$PREFIX/bin/dpkg" 2>/dev/null; then
            printf '  dpkg: sarmalayıcı hazır (com.termux yolları com.mio ya çevrilir)\n'
        elif [ -x "$PREFIX/bin/dpkg" ]; then
            printf '  dpkg: sarmalayıcı YOK, com.termux yolu olan paketler kurulamaz\n'
        fi

        # 6b) Önceden kurulmuş ve *.so atlaması yüzünden com.termux DT_RUNPATH'li kalmış
        #     ELF/.so kütüphanelerini (libpython3.14.so vb.) onar
        _elf_fixed=$(mio_repair_elf_libs)
        [ "${_elf_fixed:-0}" -gt 0 ] && printf '  ELF/.so kütüphaneleri onarıldı: %s dosya\n' "$_elf_fixed" \
            || printf '  ELF/.so kütüphaneleri: tamam\n'

        # 7) AĞA ÇIKMADAN test: apt yöntemi + dpkg + indeks üretimi
        # önek dizinleri yazılabilir mi (paketler 0555 dizin bırakabiliyor)
        printf 'önek izinleri: '
        if [ "${_ro_before:-0}" -gt 0 ]; then
            printf '%s dizin salt-okunurdu, düzeltildi\n' "$_ro_before"
        elif [ "${MIO_PREFIX_FIXED:-0}" -gt 0 ]; then
            printf '%s dizin düzeltildi\n' "$MIO_PREFIX_FIXED"
        elif [ -w "$PREFIX/share" ] || [ ! -d "$PREFIX/share" ]; then
            printf 'tamam\n'
        else
            printf 'DÜZELTİLEMEDİ (%s/share yazılamıyor)\n' "$PREFIX"
        fi

        # dpkg veritabanı: eksik/yazılamaz çalışma dizinleri ve yarıda kalan kurulum artıkları
        printf 'dpkg veritabanı: '
        if [ -d "$PREFIX/var/lib/dpkg" ]; then
            _bad=0
            _dbdirs=""
            for _d in "$PREFIX/var/lib/dpkg/updates" "$PREFIX/var/lib/dpkg/info" "$PREFIX/var/lib/dpkg/parts"; do
                if [ ! -d "$_d" ]; then
                    _bad=$((_bad + 1)); _dbdirs="$_dbdirs ${_d##*/}(yok)"
                elif [ ! -w "$_d" ]; then
                    _bad=$((_bad + 1)); _dbdirs="$_dbdirs ${_d##*/}(salt-okunur)"
                fi
            done
            for _l in "$PREFIX/var/lib/dpkg/info"/*.list; do
                [ -f "$_l" ] || continue
                [ "$(tail -c 1 "$_l" 2>/dev/null | tr '\000\n' 'ZN')" = "N" ] || _bad=$((_bad + 1))
            done
            if [ "$_bad" -gt 0 ]; then
                printf 'onarıldı:%s\n' "$_dbdirs"
                MIO_FORCE_DB_REPAIR=1 mio_repair_dpkg_db
            else
                printf 'sağlam (yazılabilir)\n'
            fi
        else
            printf 'var/lib/dpkg yok, oluşturuluyor\n'
            MIO_FORCE_DB_REPAIR=1 mio_repair_dpkg_db
        fi

        printf '\n=== test ===\n'
        printf 'dpkg: '
        if [ ! -x "$PREFIX/bin/dpkg" ]; then
            printf 'YOK (%s/bin/dpkg)\n' "$PREFIX"
        elif "$PREFIX/bin/dpkg" --print-architecture >/dev/null 2>&1; then
            printf 'çalışıyor (%s)\n' "$("$PREFIX/bin/dpkg" --print-architecture 2>/dev/null | head -n 1)"
        else
            printf 'ÇALIŞMIYOR (çıkış=%s)\n' "$?"
        fi

        printf 'apt yöntemi (https): '
        if env -u LD_PRELOAD "$PREFIX/lib/apt/methods/https" </dev/null 2>/dev/null | head -n 1 | grep -q Capabilities; then
            printf 'çalışıyor\n'
        else
            printf 'ÇALIŞMIYOR\n'
        fi

        printf 'depo okuma: '
        print_tool=""
        for t in apt-get apt; do
            [ -x "$PREFIX/bin/$t" ] && { print_tool="$PREFIX/bin/$t"; break; }
        done
        if [ -z "$print_tool" ]; then
            printf 'BAŞARISIZ (ne apt ne apt-get var)\n'
            uris=0
        else
        uri_out=$(env -u LD_PRELOAD "$print_tool" -o Debug::NoLocking=1 --print-uris update 2>&1 </dev/null || true)
        uris=$(printf '%s\n' "$uri_out" | grep -c "InRelease" || true)
        [ -n "$uris" ] || uris=0
        fi
        if [ "${uris:-0}" -gt 0 ]; then
            printf 'ok (%s adres)\n' "$uris"
        else
            printf 'BAŞARISIZ\n'
            env -u LD_PRELOAD apt-get --print-uris update 2>&1 </dev/null | head -n 6 | sed 's/^/   /'
        fi

        # 8) en hızlı depoyu seç (indirme yavaşlığının asıl sebebi rastgele ayna seçimiydi)
        printf '\n'
        mirror_pick_fast

        # 7b) GERÇEK kurulum provası (ağa çıkmadan). depodaki paketler com.termux önekiyle derlendiği
        #     için dpkg "unable to stat './data/data/com.termux' ... Permission denied" veriyordu.
        #     Prova: com.termux yollu küçük bir deb üretilir, `mio deb-cevir` ile çevrilir, dpkg ile
        #     gerçek köke kurulur ve dosyanın com.mio önekinde olduğu kontrol edilir.
        printf 'paket kurma provası: '
        probe_dir="$PREFIX/tmp/mio-probe"
        probe_admin="$probe_dir/admin"
        # İşaret dosyası HER çalıştırmada farklı: eskisi silinemezse (salt-okunur ağaç) prova
        # yanlışlıkla "tamam" demesin.
        probe_name="mio-probe-$$"
        probe_marker="$PREFIX/share/$probe_name"
        probe_ok=0
        probe_ran=0
        probe_stage="hazırlık"
        PATH="$PREFIX/bin:$PATH" ; export PATH
        # TMPDIR bozuksa dpkg-deb/tar geçici dosya açamaz ve prova yanlışlıkla ATLANDI der.
        mkdir -p "$PREFIX/tmp" 2>/dev/null
        TMPDIR="$PREFIX/tmp" ; export TMPDIR
        # Önceki provadan kalan salt-okunur ağaç silinemeyebilir: önce izin ver, sonra sil
        chmod -R u+rwX "$probe_dir" 2>/dev/null
        rm -rf "$probe_dir" "$probe_marker" 2>/dev/null
        rm -rf "$PREFIX"/share/mio-probe* 2>/dev/null
        mkdir -p "$probe_dir/root/DEBIAN" "$probe_dir/root/data/data/com.termux/files/usr/share/$probe_name" \
                 "$probe_admin/info" "$probe_admin/updates" 2>/dev/null
        printf 'Package: mio-probe\nVersion: 1.0\nArchitecture: all\nMaintainer: mio <mio@local>\nDescription: mio install probe\n' \
            > "$probe_dir/root/DEBIAN/control" 2>/dev/null
        printf 'probe\n' > "$probe_dir/root/data/data/com.termux/files/usr/share/$probe_name/probe" 2>/dev/null
        # DİKKAT: hedef dizin 0555 YAPILMAZ ve dosya da 0444 YAPILMAZ.
        # - Hedef dizin yazılamazsa dpkg "unable to create ...probe.dpkg-new: Permission denied" verir.
        # - Dosya 0444 olursa non-root Android'de dpkg deferred fsync sırasında dosyayı O_WRONLY
        #   ile tekrar açarken "unable to open ...probe.dpkg-new: Permission denied" verir.
        # Bu yüzden hem dosya 0644 hem dizin 0755 olarak sınanır.
        chmod 644 "$probe_dir/root/data/data/com.termux/files/usr/share/$probe_name/probe" 2>/dev/null
        chmod 755 "$probe_dir/root/data/data/com.termux/files/usr/share/$probe_name" 2>/dev/null
        : > "$probe_admin/status"
        : > "$probe_admin/available"

        if mio_pack_deb "$probe_dir/root" "$probe_dir/probe.deb"; then
            probe_stage="dönüştürme"
            if mio_convert_deb "$probe_dir/probe.deb" 2>"$probe_dir/conv.log"; then
                probe_stage="kurulum"
                if [ -x "$PREFIX/bin/dpkg" ] &&
                   "$PREFIX/bin/dpkg" --admindir="$probe_admin" --instdir=/ \
                        --force-not-root --force-script-chrootless --force-depends \
                        --unpack "$probe_dir/probe.deb" >"$probe_dir/log" 2>&1; then
                    probe_stage="kontrol"
                    [ -f "$probe_marker/probe" ] && probe_ok=1
                fi
            fi
        fi

        if [ "$probe_ok" -eq 1 ]; then
            printf 'tamam (depodaki paketler com.mio yollarına çevrilerek kuruluyor)\n'
        elif [ "$probe_stage" = "hazırlık" ]; then
            printf 'ATLANDI (prova paketi oluşturulamadı: dpkg-deb -b ve ar/tar başarısız)\n'
        elif [ "$probe_stage" = "dönüştürme" ]; then
            printf 'BAŞARISIZ (paket çevrilemedi)\n'
            grep -m1 -i "mio:\|error" "$probe_dir/conv.log" 2>/dev/null | sed 's/^/  /'
        elif [ "$probe_stage" = "kurulum" ]; then
            printf 'BAŞARISIZ (dpkg kurmadı)\n'
            grep -i "error\|denied\|unable\|fatal" "$probe_dir/log" 2>/dev/null | head -n 3 | sed 's/^/  /'
        else
            printf 'BAŞARISIZ (kuruldu ama dosya com.mio önekinde değil)\n'
            grep -m1 -i "error\|denied" "$probe_dir/log" 2>/dev/null | sed 's/^/  /'
        fi
        chmod -R u+rwX "$probe_dir" 2>/dev/null
        rm -rf "$probe_dir" "$probe_marker" 2>/dev/null

        # 7c) SARMALAYICI ZİNCİRİ: `apt install` gerçekten çeviriciyi kullanıyor mu?
        #     Eskiden dpkg sarmalayıcısı eski sürümde kalabiliyor, dönüşüm hatasını yutuyor ve
        #     dpkg orijinal com.termux paketiyle "çıkış kodu 1" veriyordu. Burada zincirin üç
        #     halkası da (apt sarmalayıcısı -> mio -> dpkg sarmalayıcısı) doğrulanır.
        printf 'sarmalayıcı zinciri: '
        _chain_ok=1
        for n in apt apt-get pkg; do
            [ -x "$PREFIX/bin/$n" ] || continue
            if grep -q "MIO_WRAPPER_VERSION" "$PREFIX/bin/$n" 2>/dev/null; then :; else _chain_ok=0; fi
        done
        # dpkg sarmalayıcısı (yol) + dpkg-deb sarmalayıcısı (paket açma kancası)
        if [ -x "$PREFIX/bin/dpkg" ] && grep -q "deb-cevir" "$PREFIX/bin/dpkg" 2>/dev/null; then :; else _chain_ok=0; fi
        if [ -f "$PREFIX/bin/dpkg-deb.mio-real" ] && grep -q "MIO_DPKG_DEB_WRAPPER_VERSION" "$PREFIX/bin/dpkg-deb" 2>/dev/null; then :; else _chain_ok=0; fi
        if [ "$_chain_ok" -eq 1 ]; then
            printf 'tamam (apt -> mio -> dpkg)\n'
        else
            printf 'EKSİK — onarılıyor\n'
            install_apt_wrappers >/dev/null 2>&1
            if [ -x "$PREFIX/bin/dpkg" ] && grep -q "deb-cevir" "$PREFIX/bin/dpkg" 2>/dev/null &&
               grep -q "MIO_DPKG_DEB_WRAPPER_VERSION" "$PREFIX/bin/dpkg-deb" 2>/dev/null; then
                printf '  onarıldı: dpkg ve dpkg-deb sarmalayıcıları güncel\n'
            else
                printf '  ONARILAMADI: %s/bin/dpkg ya da dpkg-deb yazılamıyor\n' "$PREFIX"
            fi
        fi

        printf '\nSONUÇ: '
        if [ -z "$missing_path" ] && [ "${uris:-0}" -gt 0 ] && [ "$probe_ok" -eq 1 ]; then
            printf 'apt çalışıyor.\n'
            printf 'Paket listelerini indirmek için: apt update\n'
            printf 'Sonra: mio install <paket>  (veya mio apt install <paket> / mio pkg install <paket>)\n'
        elif [ -z "$missing_path" ] && [ "${uris:-0}" -gt 0 ]; then
            printf 'depo okunuyor ama paket kurma provası başarısız (yukarıdaki satırlara bak)\n'
        else
            printf 'yukarıdaki satırlara bak (eksik program ya da depo okuma hatası)\n'
        fi
        exit 0
        ;;
    sarmalayici|sarmalayıcı|wrappers)
        # Uygulama her açılışta çağırır: ağa çıkmadan yalnız apt/dpkg sarmalayıcılarını tazeler.
        # (apt-fix bunun üstüne teşhis + hız testi yapar; burada o kadarı gereksiz.)
        install_apt_wrappers >/dev/null 2>&1
        ok=1
        for n in apt apt-get pkg dpkg; do
            [ -x "$PREFIX/bin/$n" ] || continue
            grep -q "MIO_.*WRAPPER_VERSION" "$PREFIX/bin/$n" 2>/dev/null || ok=0
        done
        if [ -x "$PREFIX/bin/dpkg" ]; then
            grep -q "deb-cevir" "$PREFIX/bin/dpkg" 2>/dev/null || ok=0
        fi
        if [ -f "$PREFIX/bin/dpkg-deb.mio-real" ]; then
            grep -q "MIO_DPKG_DEB_WRAPPER_VERSION" "$PREFIX/bin/dpkg-deb" 2>/dev/null || ok=0
        fi
        [ "$ok" -eq 1 ] && printf 'mio: sarmalayıcılar hazır\n'
        exit $((1 - ok))
        ;;
    dpkg-sarmala|dpkg-sarmal|sarmala)
        # apt sarmalayıcısının çağırdığı iç komut: dpkg sarmalayıcısını tazeler
        install_dpkg_wrapper
        exit $?
        ;;
    deb-cevir|debcevir|convert-deb)
        # dpkg sarmalayıcısının çağırdığı iç komut: .deb dosyalarını com.mio yollarına çevirir.
        # `mio deb-cevir -t <deb>`: dönüştürmez, yalnız neyin eksik olduğunu söyler (cihaz teşhisi).
        if [ "${1:-}" = "-t" ] || [ "${1:-}" = "--test" ]; then
            shift
            deb_report "$@"
            exit $?
        fi
        rc=0
        for f in "$@"; do
            mio_convert_deb "$f" || rc=1
        done
        exit $rc
        ;;
    apt-test|methods|method-test)
        # https yöntemi neden başlamıyor? Ağa ÇIKMAZ, saniyeler içinde biter.
        m="$PREFIX/lib/apt/methods/https"
        printf 'Dosya: %s\n' "$m"
        ls -l "$m" 2>/dev/null | sed 's/^/  /'
        printf 'hedef: %s\n' "$(readlink -f "$m" 2>/dev/null)"

        printf '\nLD_PRELOAD: %s\n' "${LD_PRELOAD:-<yok>}"

        printf '\n1) normal ortamda çalıştırma:\n'
        out=$("$m" </dev/null 2>&1 | head -n 3)
        printf '   çıkış kodu: %s\n' "$?"
        [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/   /'

        printf '\n2) LD_PRELOAD olmadan çalıştırma:\n'
        out=$(env -u LD_PRELOAD "$m" </dev/null 2>&1 | head -n 3)
        printf '   çıkış kodu: %s\n' "$?"
        [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/   /'

        printf '\n3) apt gerçekte hangi yolu kullanıyor:\n'
        env -u LD_PRELOAD apt-config dump 2>/dev/null | grep -a -E '^Dir::Bin::methods|^Dir::State|^Dir::Etc' | sed 's/^/   /'

        printf '\n3b) dpkg ve yardımcı programları:\n'
        printf '   dpkg: %s\n' "$(command -v dpkg || echo YOK)"
        printf '   sh: %s\n' "$(command -v sh || echo YOK)"
        printf '   rm: %s\n' "$(command -v rm || echo YOK)"
        printf '   tar: %s\n' "$(command -v tar || echo YOK)"
        printf '   PATH: %s\n' "$PATH"
        dpkg --print-architecture 2>/dev/null | sed 's/^/   mimari: /'

        printf '\n4) apt-get kuru çalıştırma (indirme yok):\n'
        out=$(env -u LD_PRELOAD apt-get -o Debug::NoLocking=1 --print-uris update 2>&1 </dev/null | head -n 5)
        printf '%s\n' "$out" | sed 's/^/   /'
        printf '\nNOT: 4. adımda "did not start correctly" yoksa apt yöntemi başlatabiliyor demektir.\n'
        exit 0
        ;;
    apt)
        if [ $# -eq 0 ]; then
            sources_report
            exit 0
        fi
        case "$1" in
            durum|rapor|status|neden)
                sources_report
                exit 0
                ;;
            *)
                mio_run_apt "$@"
                exit $?
                ;;
        esac
        ;;
    sources-durum|apt-neden)
        sources_report
        exit 0
        ;;
    depo|repo|sources|duzelt|fix)
        if [ "${1:-}" = "sec" ] || [ "${1:-}" = "degistir" ] || [ "${1:-}" = "switch" ]; then
            shift
            mirror_choose "${1:-}"
            exit $?
        fi
        if [ "${1:-}" = "hizli" ] || [ "${1:-}" = "hızlı" ] || [ "${1:-}" = "fast" ]; then
            mirror_pick_fast
            exit $?
        fi
        if [ "${1:-}" = "liste" ] || [ "${1:-}" = "list" ]; then
            printf 'Depo seçenekleri:\n'
            n=0
            printf '%s' "$MIRRORS" | while IFS='|' read -r label url; do
                [ -n "$label" ] || continue
                n=$((n+1))
                printf '  %s) %-16s %s\n' "$n" "$label" "$url"
            done
            printf 'Kullanım: mio depo sec <numara ya da ad>\n'
            exit 0
        fi
        fix_sources
        if [ -L "$PREFIX/etc/apt/sources.list" ] || { [ -e "$PREFIX/etc/apt/sources.list" ] && [ ! -f "$PREFIX/etc/apt/sources.list" ]; }; then
            printf 'Depo dosyası HÂLÂ BOZUK: %s\n' "$PREFIX/etc/apt/sources.list" >&2
            exit 1
        fi
        printf 'Depo dosyası: %s\n' "$PREFIX/etc/apt/sources.list"
        sed 's/^/  /' "$PREFIX/etc/apt/sources.list" 2>/dev/null
        exit $?
        ;;
    menu|menü|terminal-menu|tmenu)
        if [ "${1:-}" = "liste" ] || [ "${1:-}" = "list" ]; then
            menu_list
            exit $?
        fi
        if [ "${1:-}" = "sifirla" ] || [ "${1:-}" = "reset" ]; then
            rm -f "$MENU_DIR/varsayilan.menu"
            menu_run
            exit $?
        fi
        menu_run
        exit $?
        ;;
    oturum|session|new)
        send "$ACTION_SESSION" --es mode new
        exit $?
        ;;
    durum|status)
        send "$ACTION_STYLE" --es mode status
        exit $?
        ;;
    *)
        printf 'mio: bilinmeyen komut "%s"\n\n' "$COMMAND" >&2
        usage
        exit 2
        ;;
esac
