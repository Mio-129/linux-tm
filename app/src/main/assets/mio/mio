# Older-Tool — ikinci aşama betiği (.b.sh), .a.sh başarılı olursa çalışır
set -u
echo "Older-Tool: ikinci aşama başladı"
echo "Older-Tool: ikinci aşama tamam"
MIO_EOF
        chmod +x "$dir/Older-Tool.b.sh"
    fi
    if [ ! -f "$dir/Older-Pack.start-up.sh" ]; then
        cat > "$dir/Older-Pack.start-up.sh" <<'MIO_EOF'
