Kullanım: mio [komut]

  mio                     Menüyü açar (arka plan, animasyon, yazı boyutu, renkler, tam ekran...)
  mio kay                 Kar animasyonunu açar/kapatır.
  mio parcacik            Parçacık animasyonunu açar/kapatır.
  mio yazi +|-            Yazı boyutunu büyütür/küçültür.
  mio yazi <sayı>         Yazı boyutunu ayarlar, örnek: mio yazi 14
  mio tema <ad>           Hazır tema uygular: varsayilan, matrix, gece, mor, sicak
  mio renk <ad> <#RRGGBB> Tek rengi değiştirir, örnek: mio renk foreground #00FF66
  mio tam ekran           Tam ekranı açar/kapatır.
  mio ses                 Ses tuşlarını medya sesi <-> terminal kısayolu yapar.
  mio ses +|-             Medya sesini arttırır/azaltır.
  mio paket               Paketleri listeler (~/.mio/pkgs/<paket>).
  mio paket kur <ad>      Paketin .a.sh, .b.sh ve .start-up.sh betiklerini çalıştırır.
  mio paket guncelle      Güncellenebilir tüm paketleri kurar.
  mio paket baslat        Kurulu paketlerin .start-up.sh betiklerini çalıştırır.
  mio paket sifirla       Örnek paketi (Older-Pack) oluşturur.
  mio paket log <ad>      Paketin son çalıştırma günlüğünü gösterir.
  mio teshis              Komutların kurulu olup olmadığını ve sürümünü gösterir.
  mio menuler             Yan menüleri gösterir/gizler.
  mio oturum              Yeni oturum açar.
  mio ses + | -           Medya sesini artırır/azaltır.
  mio yardim              Bu yardımı gösterir.

Arka plan medyası (fotoğraf/video):  swset <dosya>   swset off
Videonun sesi:                       so   so off   so stop
EOF
}


# ---------------------------------------------------------------------------------------------
# apt depoları: sources.list bir dosya olmalı. Bozuk kurulumlarda klasör olarak kalabiliyor
# ("E: Read error - read (21: Is a directory)"), bu yüzden pkg'den önce onarılır.


# ---------------------------------------------------------------------------------------------
# apt yapılandırmasını sabitle
#
# Ekran çıktısındaki iki satır birlikte geliyor:
#   N: Ignoring file 'sources.list' in directory '.../etc/apt' as it has an invalid filename extension
#   E: Read error - read (21: Is a directory)
# Yani apt, `.../etc/apt` klasörünü "sourceparts" dizini sanıp içindeki sources.list'i arıyor.
# Çözüm: yolları apt.conf.d içinde açıkça sabitlemek ve geçerli bir `*.list` dosyası bırakmak.
# ---------------------------------------------------------------------------------------------
ensure_apt_config() {
    apt_dir="$PREFIX/etc/apt"
    sources="$apt_dir/sources.list"
    parts="$apt_dir/sources.list.d"
    conf_dir="$apt_dir/apt.conf.d"
    mkdir -p "$apt_dir" "$parts" "$conf_dir" 2>/dev/null

    # 1) sources.list her zaman normal bir dosya
    if [ -L "$sources" ] || { [ -e "$sources" ] && [ ! -f "$sources" ]; } || { [ -f "$sources" ] && [ ! -s "$sources" ]; }; then
        fix_sources >/dev/null 2>&1
    fi

    # 2) sourceparts gerçekten bir klasör olmalı; apt onu "sourceparts" olarak okuyor.
    #    Symlink kendini gösteriyorsa (ör. -> ..) apt "Ignoring file 'sources.list'" der.
    if [ -L "$parts" ]; then
        rm -f "$parts" 2>/dev/null
        mkdir -p "$parts" 2>/dev/null
    elif [ -e "$parts" ] && [ ! -d "$parts" ]; then
        rm -rf "$parts" 2>/dev/null
        mkdir -p "$parts" 2>/dev/null
    fi

    # 3) apt'nin okuyacağı geçerli bir liste: sources.list.d/mio.list
    if [ ! -s "$parts/mio.list" ]; then
        url=$(sed -n 's/^deb \([^ ]*\) .*/\1/p' "$sources" 2>/dev/null | head -n 1)
        [ -n "$url" ] || url="$MIRROR_MAIN_DEFAULT"
        printf 'deb %s stable main\n' "$url" > "$parts/mio.list" 2>/dev/null
        chmod 644 "$parts/mio.list" 2>/dev/null
    fi

    # 4) yolları sabitle (bu dosya apt tarafından her zaman okunur, atomik yazılır)
    conf="$conf_dir/zz-mio-sources.conf"
    {
        printf '# mio: pin the apt source locations\n'
        printf 'Dir::Etc::sourcelist "%s";\n' "$sources"
        printf 'Dir::Etc::sourceparts "%s";\n' "$parts"
    } > "$conf.tmp" 2>/dev/null
    if [ -s "$conf.tmp" ]; then
        mv "$conf.tmp" "$conf" 2>/dev/null
        chmod 644 "$conf" 2>/dev/null
    fi
    return 0
}

# ---------------------------------------------------------------------------------------------
# Teşhis: sources.list dosyasının gerçek durumu (klasör/symlink/boş/izin)
# ---------------------------------------------------------------------------------------------
sources_report() {
    sources="$PREFIX/etc/apt/sources.list"
    printf 'Dizin: %s\n' "$PREFIX/etc/apt"
    if [ -L "$sources" ]; then
        printf 'sources.list: SYMLINK -> %s\n' "$(readlink "$sources" 2>/dev/null)"
    elif [ -d "$sources" ]; then
        printf 'sources.list: KLASÖR (bozuk)\n'
        ls -la "$sources" 2>/dev/null | sed 's/^/  /'
    elif [ -f "$sources" ]; then
        if [ -s "$sources" ]; then
            printf 'sources.list: DOSYA, %s bayt (ok)\n' "$(wc -c < "$sources" 2>/dev/null | tr -d ' ')"
            sed 's/^/  /' "$sources" 2>/dev/null
        else
            printf 'sources.list: DOSYA ama BOŞ (bozuk)\n'
        fi
    elif [ -e "$sources" ]; then
        printf 'sources.list: başka bir tür (bozuk)\n'
    else
        printf 'sources.list: YOK\n'
    fi

    printf 'pkg: '
    if [ -f "$PREFIX/bin/pkg.mio-real" ]; then printf 'sarmalayıcı kurulu\n'; else printf 'sarmalayıcı YOK\n'; fi
    printf 'apt: '
    if [ -f "$PREFIX/bin/apt.mio-real" ]; then printf 'sarmalayıcı kurulu\n'; else printf 'sarmalayıcı YOK\n'; fi
    printf 'apt-get: '
    if [ -f "$PREFIX/bin/apt-get.mio-real" ]; then printf 'sarmalayıcı kurulu\n'; else printf 'sarmalayıcı YOK\n'; fi
    printf 'termux-change-repo: '
    if grep -q "mio guvenli surum" "$PREFIX/bin/termux-change-repo" 2>/dev/null; then
        printf 'güvenli sürüm\n'
    else
        printf 'ORİJİNAL (depoyu bozabilir)\n'
    fi
    printf 'sources.list.d: '
    if [ -d "$PREFIX/etc/apt/sources.list.d" ]; then
        printf 'klasör (ok), %s dosya\n' "$(ls -1 "$PREFIX/etc/apt/sources.list.d" 2>/dev/null | wc -l | tr -d ' ')"
        ls -l "$PREFIX/etc/apt/sources.list.d" 2>/dev/null | sed 's/^/  /'
    else
        printf 'YOK (bozuk)\n'
    fi
    printf 'apt.conf.d/zz-mio-sources.conf: '
    if [ -f "$PREFIX/etc/apt/apt.conf.d/zz-mio-sources.conf" ]; then
        printf 'var\n'
        sed 's/^/  /' "$PREFIX/etc/apt/apt.conf.d/zz-mio-sources.conf" 2>/dev/null
    else
        printf 'YOK\n'
    fi
}

# ---------------------------------------------------------------------------------------------
# apt depoları onarımı
#
# `sources.list` bir DOSYA olmalı. Bozuk kurulumlarda klasör, symlink veya başka bir şey olarak
# kalabiliyor ve apt "E: Read error - read (21: Is a directory)" veriyor. `termux-change-repo`
# bazen bu bozuk girdiyi kendisi oluşturduğu için pkg'den hemen önce tekrar onarılır.
# ---------------------------------------------------------------------------------------------

# $PREFIX/bin/pkg sarmalayıcısı: her pkg çağrısından önce depoyu onarır


# `termux-change-repo` betiğini güvenli sürümümüzle değiştir: orijinali bu fork'ta sources.list'i
# bozuyor (klasör olarak kalıyor). Orijinal bir kez `.orj` olarak saklanır.
install_change_repo_replacement() {
    tool="$PREFIX/bin/termux-change-repo"
    backup="$PREFIX/bin/termux-change-repo.orj"
    [ -d "$PREFIX/bin" ] || return 0
    [ -f "$tool" ] || return 0

    if [ ! -f "$backup" ] && ! grep -q "mio guvenli surum" "$tool" 2>/dev/null; then
        cp "$tool" "$backup" 2>/dev/null
    fi

    cat > "$tool" <<'MIO_EOF'
#!/data/data/com.mio/files/usr/bin/sh
# mio guvenli surum: depo dosyasini atomik yazar, bozuk birakmaz
prefix="${PREFIX:-/data/data/com.mio/files/usr}"
[ -x "$prefix/bin/mio" ] || prefix=$(dirname "$(dirname "$0")")
exec "$prefix/bin/mio" depo sec "$@"
MIO_EOF
    chmod 755 "$tool" 2>/dev/null
}

# ---------------------------------------------------------------------------------------------
# Depo değiştirici (termux-change-repo yerine)
#
# Orijinal betik `sources.list`'i yeniden yazarken dosyayı bozuyor (klasör/symlink kalıyor) ve apt
# "E: Read error - read (21: Is a directory)" veriyor. Bu sürüm her zaman geçici bir dosyaya yazıp
# atomik olarak yerine koyar; bozuk bir girdi kalırsa tekrar dener.
# ---------------------------------------------------------------------------------------------
MIRROR_FILE="$PREFIX/etc/apt/sources.list"
MIRROR_MAIN_DEFAULT="https://packages-cf.termux.dev/apt/termux-main"
MIRRORS="
Termux (CF)|https://packages-cf.termux.dev/apt/termux-main
Termux (Asya)|https://mirror.termux.dev/termux/termux-main
SJTU (Çin)|https://mirror.sjtu.edu.cn/termux/apt/termux-main
Tsinghua (Çin)|https://mirrors.tuna.tsinghua.edu.cn/termux/apt/termux-main
USTC (Çin)|https://mirrors.ustc.edu.cn/termux/apt/termux-main
Astra (Rusya)|https://mirrors.astra.in.ua/termux/termux-main
"

write_sources() {
    url="$1"
    apt_dir="$PREFIX/etc/apt"
    mkdir -p "$apt_dir" 2>/dev/null
    tmp="$apt_dir/.sources.list.mio-new"
    printf '# %s tarafından yazıldı\ndeb %s stable main\n' "mio" "$url" > "$tmp" 2>/dev/null || return 1
    rm -rf "$MIRROR_FILE" 2>/dev/null
    mv "$tmp" "$MIRROR_FILE" 2>/dev/null || return 1
    chmod 644 "$MIRROR_FILE" 2>/dev/null
    # Gerçekten dosya olduğunu doğrula (bozuk kurulumda şart)
    [ -f "$MIRROR_FILE" ] && [ ! -L "$MIRROR_FILE" ] || {
        fix_sources
        [ -f "$MIRROR_FILE" ] || return 1
    }
    # sources.list.d/mio.list da aynı depoyu göstermeli (apt onu da okuyabilir)
    parts_dir="$apt_dir/sources.list.d"
    mkdir -p "$parts_dir" 2>/dev/null
    printf 'deb %s stable main\n' "$url" > "$parts_dir/.mio.list.tmp" 2>/dev/null &&
        mv "$parts_dir/.mio.list.tmp" "$parts_dir/mio.list" 2>/dev/null
    chmod 644 "$parts_dir/mio.list" 2>/dev/null
    # zz-mio-sources.conf yolları sabitler; yoksa oluştur
    conf_file="$apt_dir/apt.conf.d/zz-mio-sources.conf"
    if [ ! -s "$conf_file" ]; then
        mkdir -p "$apt_dir/apt.conf.d" 2>/dev/null
        {
            printf '# mio: pin the apt source locations\n'
            printf 'Dir::Etc::sourcelist "%s";\n' "$MIRROR_FILE"
            printf 'Dir::Etc::sourceparts "%s";\n' "$parts_dir"
        } > "$conf_file.tmp" 2>/dev/null
        [ -s "$conf_file.tmp" ] && mv "$conf_file.tmp" "$conf_file" 2>/dev/null
        chmod 644 "$conf_file" 2>/dev/null
    fi
    return 0
}

mirror_choose() {
    if [ -n "${1:-}" ]; then
        case "$1" in
            cf|termux|varsayilan|default) write_sources "$MIRROR_MAIN_DEFAULT" && printf 'Depo: %s\n' "$MIRROR_MAIN_DEFAULT"; return $? ;;
            asya|asia) write_sources "https://mirror.termux.dev/termux/termux-main" && printf 'Depo: mirror.termux.dev\n'; return $? ;;
            sjtu) write_sources "https://mirror.sjtu.edu.cn/termux/apt/termux-main" && printf 'Depo: SJTU\n'; return $? ;;
            tuna|tsinghua) write_sources "https://mirrors.tuna.tsinghua.edu.cn/termux/apt/termux-main" && printf 'Depo: Tsinghua\n'; return $? ;;
            ustc) write_sources "https://mirrors.ustc.edu.cn/termux/apt/termux-main" && printf 'Depo: USTC\n'; return $? ;;
            astra) write_sources "https://mirrors.astra.in.ua/termux/termux-main" && printf 'Depo: Astra\n'; return $? ;;
            *) # URL verilmişse doğrudan kullan
               case "$1" in
                   http*) write_sources "$1" && printf 'Depo: %s\n' "$1"; return $? ;;
               esac
               printf 'Bilinmeyen depo: %s\n' "$1" >&2
               return 2 ;;
        esac
    fi

    printf 'Depo seçin:\n'
    printf '%s' "$MIRRORS" | while IFS='|' read -r label url; do
        [ -n "$label" ] || continue
        idx=$((idx+1))
        printf '  %s) %s\n' "$idx" "$label"
    done
    printf 'Seçim [1]: '
    read -r choice || choice=""
    [ -z "$choice" ] && choice=1

    n=0
    url=""
    printf '%s' "$MIRRORS" | while IFS='|' read -r label u; do
        [ -n "$label" ] || continue
        n=$((n+1))
        if [ "$n" = "$choice" ]; then printf '%s' "$u"; fi
    done > "$HOME/.mio/.mirror-choice" 2>/dev/null

    url=$(cat "$HOME/.mio/.mirror-choice" 2>/dev/null)
    rm -f "$HOME/.mio/.mirror-choice" 2>/dev/null
    [ -n "$url" ] || url="$MIRROR_MAIN_DEFAULT"

    if write_sources "$url"; then
        printf 'Depo: %s\n' "$url"
        printf 'Şimdi "pkg update" çalıştırabilirsin.\n'
        return 0
    fi
    printf 'Depo yazılamadı: %s\n' "$MIRROR_FILE" >&2
    return 1
}

install_apt_wrapper() {
    name="$1"
    real="$PREFIX/bin/$name.mio-real"
    wrapper="$PREFIX/bin/$name"
    [ -d "$PREFIX/bin" ] || return 0
    [ -f "$wrapper" ] || return 0

    # Zaten güncel sarmalayıcı varsa dokunma (sürüm damgası ile)
    if grep -q "MIO_WRAPPER_VERSION=9" "$wrapper" 2>/dev/null; then
        return 0
    fi

    # Gerçek aracı bir kez sakla (sarmalayıcı kendini çağırmasın)
    if [ ! -f "$real" ]; then
        if grep -q "MIO_WRAPPER_VERSION" "$wrapper" 2>/dev/null; then
            # Daha önce sarmalanmış ama gerçek araç kaybolmuş: kurtarılamaz
            printf 'mio: %s.mio-real yok, sarmalayıcı kurulmadı\n' "$name" >&2
            return 1
        fi
        cp "$wrapper" "$real" 2>/dev/null || return 1
        chmod 755 "$real" 2>/dev/null
    fi
    [ -x "$real" ] || return 1

    # Sarmalayıcı kendi konumundan çalışır (PREFIX'e ihtiyaç duymaz), onarımı kendi yapar
    cat > "$wrapper" <<'MIO_EOF'
#!@@PREFIX@@/bin/sh
# mio apt sarmalayıcısı: apt yollarını düzeltir, sonra gerçek aracı çalıştırır
MIO_WRAPPER_VERSION=9
NAME=@@NAME@@
bin=$(dirname "$0")
prefix=$(dirname "$bin")
apt_dir="$prefix/etc/apt"
sources="$apt_dir/sources.list"
parts="$apt_dir/sources.list.d"
conf_dir="$apt_dir/apt.conf.d"

mkdir -p "$apt_dir" "$parts" "$conf_dir" 2>/dev/null

# 1) sources.list normal, boş olmayan bir dosya olmalı
broken=0
if [ -L "$sources" ]; then
    broken=1
elif [ -e "$sources" ] && [ ! -f "$sources" ]; then
    broken=1
elif [ ! -e "$sources" ]; then
    broken=1
elif [ ! -s "$sources" ]; then
    broken=1
fi
if [ "$broken" -eq 1 ]; then
    tmp="$apt_dir/sources.list.mio-tmp"
    found=""
    if [ -d "$sources" ]; then
        for candidate in "$sources"/*; do
            [ -f "$candidate" ] || continue
            found="$candidate"
            break
        done
    fi
    rm -f "$tmp" 2>/dev/null
    if [ -n "$found" ]; then cp "$found" "$tmp" 2>/dev/null; fi
    [ -s "$tmp" ] || printf 'deb https://packages-cf.termux.dev/apt/termux-main stable main\n' > "$tmp"
    rm -rf "$sources" 2>/dev/null
    mv "$tmp" "$sources" 2>/dev/null
    chmod 644 "$sources" 2>/dev/null
    printf 'mio: bozuk sources.list onarıldı\n' >&2
fi

# 2) sourceparts gerçek bir klasör olmalı (klasör değilse apt "Is a directory" verir)
if [ -L "$parts" ] || { [ -e "$parts" ] && [ ! -d "$parts" ]; }; then
    rm -rf "$parts" 2>/dev/null
    mkdir -p "$parts" 2>/dev/null
    printf 'mio: sources.list.d onarıldı\n' >&2
fi

# 3) okunacak geçerli bir *.list dosyası kalsın
if [ ! -s "$parts/mio.list" ]; then
    url=$(sed -n 's/^deb \([^ ]*\) .*/\1/p' "$sources" 2>/dev/null | head -n 1)
    [ -n "$url" ] || url="https://packages-cf.termux.dev/apt/termux-main"
    printf 'deb %s stable main\n' "$url" > "$parts/mio.list" 2>/dev/null
fi

# 4) yolları apt.conf.d içinde sabitle
conf="$conf_dir/zz-mio-sources.conf"
{
    printf '# mio: pin the apt source locations\n'
    printf 'Dir::Etc::sourcelist "%s";\n' "$sources"
    printf 'Dir::Etc::sourceparts "%s";\n' "$parts"
} > "$conf" 2>/dev/null

exec "$bin/$NAME.mio-real" "$@"
MIO_EOF
    sed -e "s|@@NAME@@|$name|g" -e "s|@@PREFIX@@|$PREFIX|g" "$wrapper" > "$wrapper.tmp" 2>/dev/null && mv "$wrapper.tmp" "$wrapper"
    chmod 755 "$wrapper" 2>/dev/null
    printf 'mio: %s sarmalayıcısı kuruldu\n' "$name"
}

install_apt_wrappers() {
    install_apt_wrapper pkg
    install_apt_wrapper apt
    install_apt_wrapper apt-get
    return 0
}

install_pkg_wrapper() {
    install_apt_wrappers
}

fix_sources() {
    apt_dir="$PREFIX/etc/apt"
    sources="$apt_dir/sources.list"
    [ -d "$apt_dir" ] || return 0

    # Ne olduğu önemli değil: dosya değilse (klasör, symlink, fifo...) ya da okunamıyorsa yeniden yaz
    broken=0
    if [ -L "$sources" ]; then
        broken=1
    elif [ -e "$sources" ] && [ ! -f "$sources" ]; then
        broken=1
    elif [ -f "$sources" ] && [ ! -r "$sources" ]; then
        broken=1
    elif [ -f "$sources" ] && [ ! -s "$sources" ]; then
        broken=1
    elif [ ! -e "$sources" ]; then
        broken=1
    fi

    if [ "$broken" -eq 1 ]; then
        printf 'mio: bozuk sources.list onarılıyor...\n'
        found=""
        if [ -d "$sources" ]; then
            for candidate in "$sources"/*; do
                [ -f "$candidate" ] || continue
                case "$candidate" in
                    *sources.list*) found="$candidate"; break ;;
                esac
            done
        fi
        tmp="$apt_dir/sources.list.mio-tmp"
        rm -f "$tmp" 2>/dev/null
        if [ -n "$found" ]; then
            cp "$found" "$tmp" 2>/dev/null
        fi
        if [ ! -s "$tmp" ]; then
            printf 'deb https://packages-cf.termux.dev/apt/termux-main stable main\n' > "$tmp"
        fi
        rm -rf "$sources" 2>/dev/null
        mv "$tmp" "$sources" 2>/dev/null
        chmod 644 "$sources" 2>/dev/null
        printf 'mio: sources.list dosyası yeniden oluşturuldu:\n'
        sed 's/^/  /' "$sources" 2>/dev/null
    fi

    # sources.list.d içinde dosya olmayan girdiler apt'yi bozar
    if [ -d "$apt_dir/sources.list.d" ]; then
        for entry in "$apt_dir/sources.list.d"/*; do
            [ -e "$entry" ] || continue
            if [ -L "$entry" ] || { [ -d "$entry" ]; }; then
                printf 'mio: bozuk depo girdisi siliniyor: %s\n' "$entry"
                rm -rf "$entry" 2>/dev/null
            fi
        done
    fi

    install_apt_wrappers
    install_change_repo_replacement
    if [ "${MIO_NO_APT_CONFIG:-0}" != "1" ]; then
        MIO_NO_APT_CONFIG=1 ensure_apt_config
    fi
    return 0
}

run_am() {
    if [ -x "$PREFIX/bin/termux-am" ]; then
        "$PREFIX/bin/termux-am" "$@" 2>/dev/null && return 0
    fi
    if command -v termux-am >/dev/null 2>&1; then
        termux-am "$@" 2>/dev/null && return 0
    fi
    if [ -x /system/bin/am ]; then
        /system/bin/am "$@" >/dev/null 2>&1 && return 0
    fi
    return 1
}

send_command() {
    # `am` prints "Broadcast completed" when the broadcast really reached the app
    out=$(run_am broadcast "$@" 2>&1)
    case "$out" in
        *"Broadcast completed"*) return 0 ;;
    esac
    if [ -n "$out" ] && ! printf '%s' "$out" | grep -qi "security\|denied\|exception"; then
        return 0
    fi
    if run_am startservice -n com.mio/com.termux.app.TermuxService "$@" >/dev/null 2>&1; then
        return 0
    fi
    # Son çare: niyeti doğrudan etkinliğe gönder (bazı Android sürümleri am broadcast/startservice'i
    # kısıtlar, ama etkinlik başlatma izinli olduğu için komut yine de iletilir)
    run_am start -n com.mio/com.termux.app.TermuxActivity "$@" >/dev/null 2>&1
}

write_request() {
    mkdir -p "$REQUEST_DIR" 2>/dev/null
    {
        printf 'created=%s\n' "$(date +%s 2>/dev/null || echo 0)"
        printf '%s\n' "$@"
    } > "$REQUEST_FILE" 2>/dev/null
}

# Komutu çalıştır: $1 eylem, kalanı --es anahtar değer çiftleri
# Önce yayın denenir; olmazsa istek dosyası yazılır ve uygulama servisi dosyayı görüp komutu
# kendisi çalıştırır (am bazı cihazlarda kabuk kullanıcısına kapalı olabiliyor).
send() {
    action="$1"
    shift

    # --es mode up --es size 20 ... -> "mode up size 20" (uygulama istek dosyasından okur)
    args=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --es|--ei|--ez|--el)
                if [ $# -ge 3 ]; then
                    args="$args${args:+ }$2 $3"
                    shift 3
                else
                    shift
                fi
                ;;
            *) shift ;;
        esac
    done

    if [ -n "$args" ]; then
        write_request "command=mio" "action=$action" "args=$args"
    else
        write_request "command=mio" "action=$action"
    fi

    if send_command -a "$action" "$@"; then
        return 0
    fi

    # Yayın/başlatma engellendi: istek dosyası kaldı, uygulama onu görüp çalıştıracak
    if [ -f "$REQUEST_FILE" ]; then
        printf 'mio: komut istek dosyasına yazıldı, uygulama görecek (%s)\n' "$REQUEST_FILE"
        return 0
    fi
    printf 'mio: komut uygulamaya iletilemedi.\n' >&2
    return 1
}

