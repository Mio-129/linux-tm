#!/data/data/com.mio/files/usr/bin/sh
#
# mio - Termux'un bu çatalının (fork) menüsünü ve ayarlarını terminalden yönetir.
#
# Kullanım:
#   mio                     Menüyü aç
#   mio kay                 Kar animasyonunu aç/kapat
#   mio parcacik            Parçacık animasyonunu aç/kapat
#   mio yazi +              Yazı boyutunu büyüt
#   mio yazi -              Yazı boyutunu küçült
#   mio tema matrix         Hazır bir tema uygula
#   mio renk red #FF0000    Tek bir rengi değiştir
#   mio tam ekran           Tam ekranı aç/kapat
#   mio ses tuslari         Ses tuşlarını medya sesi / terminal kısayolu arasında değiştir
#   mio paket               Paketleri listeler (~/.mio/pkgs)
#   mio paket kur <ad>      Paketin .a.sh / .b.sh betiklerini sırayla çalıştırır
#   mio paket guncelle      Güncellenebilir tüm paketleri kurar
#   mio paket baslat        Kurulu paketlerin .start-up.sh betiklerini çalıştırır
#   mio paket sifirla       Örnek paketi (Older-Pack) oluşturur
#   mio teshis              Kurulu komutları ve sürümü kontrol eder (menü açılmıyorsa)
#   mio menuler             Yan menüleri aç/kapat
#   mio oturum              Yeni oturum aç
#   mio yardim              Bu yardımı gösterir
#
# Notlar:
#   * Komutlar uygulamanın kendi yayın alıcısına (broadcast) mesaj yollar, termux-api gerekmez.
#   * Ekran görüntüsü/medya komutları için: swset <dosya>, swset off, so, so off.

if [ -z "${PREFIX:-}" ]; then
    # Betiğin yeri: $PREFIX/bin/mio -> PREFIX iki üst dizin
    mio_dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)
    case "$mio_dir" in
        */bin) PREFIX=$(dirname "$mio_dir") ;;
        *)     PREFIX=/data/data/com.mio/files/usr ;;
    esac
fi

