write_sources() {
    url="$1"
    # Geçersiz adres sources.list'e yazılırsa apt "Malformed entry ... (URI parse)" der ve
    # hiçbir komut çalışmaz; bu yüzden burada reddedilir.
    case "$url" in
        http://*|https://*) : ;;
        *) printf 'mio: geçersiz depo adresi reddedildi: %s\n' "$url" >&2; return 1 ;;
    esac
    apt_dir="$PREFIX/etc/apt"
    mkdir -p "$apt_dir" 2>/dev/null
    tmp="$apt_dir/.sources.list.mio-new"
    printf '# %s tarafından yazıldı\ndeb %s stable main\n' "mio" "$url" > "$tmp" 2>/dev/null || return 1
    rm -rf "$MIRROR_FILE" 2>/dev/null
    mv "$tmp" "$MIRROR_FILE" 2>/dev/null || return 1
    chmod 644 "$MIRROR_FILE" 2>/dev/null
    # Gerçekten dosya olduğunu doğrula (bozuk kurulumda şart)
    [ -f "$MIRROR_FILE" ] && [ ! -L "$MIRROR_FILE" ] || {
        fix_sources
        [ -f "$MIRROR_FILE" ] || return 1
    }
    # seçimi kalıcı olarak sakla, böylece her açılışta aynı depo kullanılır
    printf '%s\n' "$url" > "$apt_dir/.mio-mirror" 2>/dev/null

    # aynı depoyu ikinci kez yazan dosyaları kaldır (çift kayıt uyarısı çıkmasın)
    parts_dir="$apt_dir/sources.list.d"
    mkdir -p "$parts_dir" 2>/dev/null
    rm -f "$parts_dir/mio.list" "$parts_dir/main.list" 2>/dev/null
    # zz-mio-sources.conf yolları sabitler; yoksa oluştur
    conf_file="$apt_dir/apt.conf.d/zz-mio-sources.conf"
    if [ ! -s "$conf_file" ]; then
        mkdir -p "$apt_dir/apt.conf.d" 2>/dev/null
        {
            printf '# mio: pin the apt source locations\n'
            printf 'Dir::Etc::sourcelist "%s";\n' "$MIRROR_FILE"
            printf 'Dir::Etc::sourceparts "%s";\n' "$parts_dir"
        } > "$conf_file.tmp" 2>/dev/null
        [ -s "$conf_file.tmp" ] && mv "$conf_file.tmp" "$conf_file" 2>/dev/null
        chmod 644 "$conf_file" 2>/dev/null
    fi
    return 0
}

# Depoları kısa süreyle dener, en hızlı olanı yazar. Ağa çıkar ama her depo için
# en fazla 2 saniye bekler, bu yüzden saniyeler içinde biter.
MIRRORS_FAST="
Termux CF|https://packages-cf.termux.dev/apt/termux-main
Astra|https://termux.astra.in.ua/apt/termux-main
Grimler|https://grimler.se/termux/termux-main
FAU|https://ftp.fau.de/termux/termux-main
ICM|https://ftp.icm.edu.pl/pub/Linux/dist/termux/termux-main
Autkin|https://mirror.autkin.net/termux/termux-main
"

mirror_pick_fast() {
    if [ ! -x "$PREFIX/bin/curl" ]; then
        printf 'curl yok, hız testi atlandı\n'
        return 1
    fi
    printf 'Depolar deneniyor (en fazla 2 sn/depo):\n'
    best_url="" ; best_time=""
    # NOT: `for entry in $VAR` etiketlerdeki boşluk yüzünden kelimelere bölünüyordu ve
    # "Termux" gibi geçersiz bir adres sources.list'e yazılıyordu. Heredoc + while
    # kullanıldığında döngü alt kabukta çalışmaz, değişkenler korunur.
    while IFS='|' read -r label url; do
        [ -n "$label" ] || continue
        case "$url" in http*) : ;; *) continue ;; esac
        t=$("$PREFIX/bin/curl" -fsS -o /dev/null --max-time 2 -w '%{time_total}' \
                "$url/dists/stable/InRelease" 2>/dev/null)
        case "$t" in
            ''|*[!0-9.]*) printf '  %-12s erişilemedi\n' "$label" ; continue ;;
            *) printf '  %-12s %s sn\n' "$label" "$t" ;;
        esac
        if [ -z "$best_time" ] || [ "$(awk -v a="$t" -v b="$best_time" 'BEGIN{print (a<b)?1:0}')" = "1" ]; then
            best_time="$t" ; best_url="$url"
        fi
    done <<MIO_MIRRORS
$MIRRORS_FAST
MIO_MIRRORS
    if [ -n "$best_url" ] && write_sources "$best_url"; then
        printf 'En hızlı depo: %s (%s sn)\n' "$best_url" "$best_time"
        return 0
    fi
    printf 'Hız testi sonuçsuz, depo değiştirilmedi\n'
    return 1
}

mirror_choose() {
    if [ -n "${1:-}" ]; then
        case "$1" in
            cf|termux|varsayilan|default) write_sources "$MIRROR_MAIN_DEFAULT" && printf 'Depo: %s\n' "$MIRROR_MAIN_DEFAULT"; return $? ;;
            asya|asia) write_sources "https://mirror.termux.dev/termux/termux-main" && printf 'Depo: mirror.termux.dev\n'; return $? ;;
            ana|main|resmi) write_sources "https://packages.termux.dev/apt/termux-main" && printf 'Depo: packages.termux.dev\n'; return $? ;;
            grimler|fi|finlandiya) write_sources "https://grimler.se/termux/termux-main" && printf 'Depo: grimler.se\n'; return $? ;;
            fau|almanya) write_sources "https://ftp.fau.de/termux/termux-main" && printf 'Depo: ftp.fau.de\n'; return $? ;;
            icm|polonya) write_sources "https://ftp.icm.edu.pl/pub/Linux/dist/termux/termux-main" && printf 'Depo: ftp.icm.edu.pl\n'; return $? ;;
            autkin|avrupa) write_sources "https://mirror.autkin.net/termux/termux-main" && printf 'Depo: mirror.autkin.net\n'; return $? ;;
            bouwhuis|hollanda) write_sources "https://mirror.bouwhuis.network/termux/termux-main" && printf 'Depo: mirror.bouwhuis.network\n'; return $? ;;
            sjtu) write_sources "https://mirror.sjtu.edu.cn/termux/apt/termux-main" && printf 'Depo: SJTU\n'; return $? ;;
            tuna|tsinghua) write_sources "https://mirrors.tuna.tsinghua.edu.cn/termux/apt/termux-main" && printf 'Depo: Tsinghua\n'; return $? ;;
            ustc) write_sources "https://mirrors.ustc.edu.cn/termux/apt/termux-main" && printf 'Depo: USTC\n'; return $? ;;
            astra|ukrayna) write_sources "https://termux.astra.in.ua/apt/termux-main" && printf 'Depo: termux.astra.in.ua\n'; return $? ;;
            *) # URL verilmişse doğrudan kullan
               case "$1" in
                   http*) write_sources "$1" && printf 'Depo: %s\n' "$1"; return $? ;;
               esac
               printf 'Bilinmeyen depo: %s\n' "$1" >&2
               return 2 ;;
        esac
    fi

    printf 'Depo seçin:\n'
    printf '%s' "$MIRRORS" | while IFS='|' read -r label url; do
        [ -n "$label" ] || continue
        idx=$((idx+1))
        printf '  %s) %s\n' "$idx" "$label"
    done
    printf 'Seçim [1]: '
    read -r choice || choice=""
    [ -z "$choice" ] && choice=1

    n=0
    url=""
    printf '%s' "$MIRRORS" | while IFS='|' read -r label u; do
        [ -n "$label" ] || continue
        n=$((n+1))
        if [ "$n" = "$choice" ]; then printf '%s' "$u"; fi
    done > "$HOME/.mio/.mirror-choice" 2>/dev/null

    url=$(cat "$HOME/.mio/.mirror-choice" 2>/dev/null)
    rm -f "$HOME/.mio/.mirror-choice" 2>/dev/null
    [ -n "$url" ] || url="$MIRROR_MAIN_DEFAULT"

    if write_sources "$url"; then
        printf 'Depo: %s\n' "$url"
        printf 'Şimdi "pkg update" çalıştırabilirsin.\n'
        return 0
    fi
    printf 'Depo yazılamadı: %s\n' "$MIRROR_FILE" >&2
    return 1
}

install_apt_wrapper() {
    name="$1"
    real="$PREFIX/bin/$name.mio-real"
    wrapper="$PREFIX/bin/$name"
    [ -d "$PREFIX/bin" ] || return 0

    # Gerçek araç hiç yoksa (bozuk kurulum) yapacak bir şey yok -> gerçek araç YOK demektir.
    # Eskiden sarmalayıcı dosyası da yoksa `return 0` deniyordu; o zaman `pkg` hiç
    # sarmalanmıyor ve `pkg install` doğrudan gerçek dpkg'yi çağırıp "unable to stat
    # './data/data/com.termux'" veriyordu (cihazdaki pkg hatası buydu).
    if [ ! -f "$wrapper" ] && [ ! -f "$real" ]; then
        return 0
    fi
    if [ ! -f "$wrapper" ] && [ -f "$real" ]; then
        case "$name" in
            pkg|apt|apt-get) : ;;   # devam: aşağıda yeniden yazılır
            *) return 0 ;;
        esac
    fi

    # Zaten güncel sarmalayıcı varsa dokunma (sürüm damgası ile)
    if grep -q "MIO_WRAPPER_VERSION=29" "$wrapper" 2>/dev/null; then
        return 0
    fi

    # Gerçek aracı sakla (paket yükseltmesi $wrapper'ı ezmişse .mio-real'i de güncelle)
    if [ -f "$wrapper" ] && ! grep -q "MIO_WRAPPER_VERSION" "$wrapper" 2>/dev/null; then
        cp "$wrapper" "$real" 2>/dev/null || return 1
        chmod 755 "$real" 2>/dev/null
    elif [ ! -f "$real" ]; then
        printf 'mio: %s.mio-real yok, sarmalayıcı kurulmadı\n' "$name" >&2
        return 1
    fi
    [ -x "$real" ] || return 1

    # Sarmalayıcı kendi konumundan çalışır (PREFIX'e ihtiyaç duymaz), onarımı kendi yapar
    cat > "$wrapper" <<'MIO_EOF'
#!@@PREFIX@@/bin/sh
# mio apt sarmalayıcısı: apt yollarını düzeltir, sonra gerçek aracı çalıştırır
MIO_WRAPPER_VERSION=29
NAME=@@NAME@@
bin=$(dirname "$0")
prefix=$(dirname "$bin")
apt_dir="$prefix/etc/apt"
sources="$apt_dir/sources.list"
parts="$apt_dir/sources.list.d"
conf_dir="$apt_dir/apt.conf.d"

mkdir -p "$apt_dir" "$parts" "$conf_dir" 2>/dev/null

# 1) sources.list normal, boş olmayan bir dosya olmalı
broken=0
if [ -L "$sources" ]; then
    broken=1
elif [ -e "$sources" ] && [ ! -f "$sources" ]; then
    broken=1
elif [ ! -e "$sources" ]; then
    broken=1
elif [ ! -s "$sources" ]; then
    broken=1
fi
if [ "$broken" -eq 1 ]; then
    tmp="$apt_dir/sources.list.mio-tmp"
    found=""
    if [ -d "$sources" ]; then
        for candidate in "$sources"/*; do
            [ -f "$candidate" ] || continue
            found="$candidate"
            break
        done
    fi
    rm -f "$tmp" 2>/dev/null
    if [ -n "$found" ]; then cp "$found" "$tmp" 2>/dev/null; fi
    [ -s "$tmp" ] || printf 'deb https://packages-cf.termux.dev/apt/termux-main stable main\n' > "$tmp"
    rm -rf "$sources" 2>/dev/null
    mv "$tmp" "$sources" 2>/dev/null
    chmod 644 "$sources" 2>/dev/null
    printf 'mio: bozuk sources.list onarıldı\n' >&2
fi

# 2) sourceparts gerçek bir klasör olmalı (klasör değilse apt "Is a directory" verir)
if [ -L "$parts" ] || { [ -e "$parts" ] && [ ! -d "$parts" ]; }; then
    rm -rf "$parts" 2>/dev/null
    mkdir -p "$parts" 2>/dev/null
    printf 'mio: sources.list.d onarıldı\n' >&2
fi

# 3) aynı depoyu tekrar eden dosyaları kaldır ("configured multiple times" uyarısı biter)
rm -f "$parts/mio.list" "$parts/main.list" 2>/dev/null

# 3b) geçersiz depo satırı (ör. "deb Termux stable main") apt'yi kilitler:
#     "Malformed entry ... (URI parse)" -> "The list of sources could not be read."
#     Böyle bir satır varsa depo dosyasını mio'nun onarıcısına devret.
if grep -q '^deb ' "$sources" 2>/dev/null; then
    if grep '^deb ' "$sources" 2>/dev/null | awk '{print $2}' | grep -qv '^https\?://'; then
        # doğrudan burada temizle (harici bir araca bağımlı kalmadan)
        tmp="$sources.mio-tmp"
        grep '^deb ' "$sources" 2>/dev/null | awk '$2 ~ /^https?:\/\// { print }' > "$tmp" 2>/dev/null
        if [ -s "$tmp" ]; then
            mv "$tmp" "$sources" 2>/dev/null
            chmod 644 "$sources" 2>/dev/null
        else
            rm -f "$tmp" 2>/dev/null
            printf '# mio tarafından yazıldı\ndeb https://packages-cf.termux.dev/apt/termux-main stable main\n' > "$sources" 2>/dev/null
            chmod 644 "$sources" 2>/dev/null
        fi
        printf 'mio: geçersiz depo satırı temizlendi\n' >&2
    fi
fi

# 4) yolları apt.conf.d içinde de sabitle (bazı apt çağrıları dosyayı okumadan geçebiliyor)
conf="$conf_dir/zz-mio-sources.conf"
{
    printf '# mio: pin the apt source locations\n'
    printf 'Dir::Etc::sourcelist "%s";\n' "$sources"
    printf 'Dir::Etc::sourceparts "%s";\n' "$parts"
} > "$conf" 2>/dev/null

# 5) apt'nin indirme yöntemleri (lib/apt/methods/http, https) çalıştırılabilir olmalı; aksi halde
#    apt "Failed to exec method ..." verir ve hiçbir depo okunamaz.
methods="$prefix/lib/apt/methods"
if [ -d "$methods" ]; then
    for m in "$methods"/*; do
        [ -e "$m" ] || continue
        if [ ! -x "$m" ]; then chmod 755 "$m" 2>/dev/null; fi
    done
    # kırık symlink (ör. https -> http hedefi yok) yerine gerçek kopya
    for m in "$methods"/*; do
        [ -L "$m" ] || continue
        [ -e "$m" ] && continue
        base=$(basename "$m")
        target=""
        case "$base" in
            https|tor+https) target="$methods/http" ;;
            tor+http) target="$methods/http" ;;
        esac
        if [ -n "$target" ] && [ -f "$target" ]; then
            rm -f "$m" 2>/dev/null
            cp "$target" "$m" 2>/dev/null
            chmod 755 "$m" 2>/dev/null
            printf 'mio: apt yöntemi onarıldı: %s\n' "$m" >&2
        fi
    done
fi

# 6) apt'nin çalışma klasörleri eksikse apt hiçbir şey okuyamaz:
#    "E: List directory .../usr/var/lib/apt is missing" (bu, "sources.list" hatasından sonraki adım)
for d in "$prefix/var/lib/apt/lists/partial" "$prefix/var/cache/apt/archives/partial" \
         "$prefix/var/lib/dpkg" "$prefix/var/log/apt" "$prefix/etc/apt/trusted.gpg.d" "$prefix/tmp"; do
    [ -d "$d" ] || mkdir -p "$d" 2>/dev/null
done
touch "$prefix/var/lib/dpkg/status" 2>/dev/null

# en son) `apt install` sırasında dpkg sarmalayıcısı eski kalmasın: korumalı
#     `$prefix/libexec/mio/dpkg` ve `$prefix/bin/dpkg` yoksa tazele.
if [ -x "$prefix/bin/mio" ]; then
    if [ ! -x "$prefix/libexec/mio/dpkg" ] || ! grep -q "MIO_DPKG_WRAPPER_VERSION=" "$prefix/bin/dpkg" 2>/dev/null; then
        "$prefix/bin/mio" dpkg-sarmala >/dev/null 2>&1 || :
    fi
fi

_dpkg_bin="$prefix/bin/dpkg"
[ -x "$prefix/libexec/mio/dpkg" ] && _dpkg_bin="$prefix/libexec/mio/dpkg"

# 7) Yolları APT_CONFIG ile dayat: bu dosya apt'nin kendisi tarafından okunur ve `pkg` gibi
#    sarmalayıcılar `-o` geçirmese de geçerli olur.
export APT_CONFIG="$conf_dir/mio-apt.conf"
{
    printf '# mio: apt yolları (APT_CONFIG)\n'
    printf 'Dir::Etc "%s/etc/apt";\n' "$prefix"
    printf 'Dir::Etc::sourcelist "%s";\n' "$sources"
    printf 'Dir::Etc::sourceparts "%s";\n' "$parts"
    printf 'Dir::Etc::trusted "%s/etc/apt/trusted.gpg";\n' "$prefix"
    printf 'Dir::Etc::trustedparts "%s/etc/apt/trusted.gpg.d";\n' "$prefix"
    printf 'Dir::State "%s/var/lib/apt";\n' "$prefix"
    printf 'Dir::State::lists "%s/var/lib/apt/lists";\n' "$prefix"
    printf 'Dir::State::status "%s/var/lib/dpkg/status";\n' "$prefix"
    printf 'Dir::Cache "%s/var/cache/apt";\n' "$prefix"
    printf 'Dir::Cache::archives "%s/var/cache/apt/archives";\n' "$prefix"
    printf 'Dir::Log "%s/var/log/apt";\n' "$prefix"
    printf 'Dir::Bin::methods "%s/lib/apt/methods";\n' "$prefix"
    printf 'Dir::Bin::dpkg "%s";\n' "$_dpkg_bin"
    printf 'Dir::State::extended_states "%s/var/lib/apt/extended_states";\n' "$prefix"
    printf 'DPkg::Path "%s/libexec/mio:%s/bin:/system/bin:/system/xbin";\n' "$prefix" "$prefix"
    printf 'Dpkg::Options { "--force-confdef"; "--force-confold"; };\n'
    printf 'DPkg::Post-Invoke { "%s/bin/mio sarmalayici >/dev/null 2>&1 || true"; };\n' "$prefix"
    printf 'Acquire::ForceIPv4 "true";\n'
    printf 'Acquire::Languages "none";\n'
} > "$APT_CONFIG" 2>/dev/null

# 8) Tüm apt kök yollarını dayat.
apt_opts="-o Dir::Etc=$prefix/etc/apt"
apt_opts="$apt_opts -o Dir::Etc::sourcelist=$sources -o Dir::Etc::sourceparts=$parts"
apt_opts="$apt_opts -o Dir::Etc::trusted=$prefix/etc/apt/trusted.gpg"
apt_opts="$apt_opts -o Dir::Etc::trustedparts=$prefix/etc/apt/trusted.gpg.d"
apt_opts="$apt_opts -o Dir::State=$prefix/var/lib/apt -o Dir::State::lists=$prefix/var/lib/apt/lists"
apt_opts="$apt_opts -o Dir::State::status=$prefix/var/lib/dpkg/status"
apt_opts="$apt_opts -o Dir::Cache=$prefix/var/cache/apt"
apt_opts="$apt_opts -o Dir::Cache::archives=$prefix/var/cache/apt/archives"
apt_opts="$apt_opts -o Dir::Log=$prefix/var/log/apt"
apt_opts="$apt_opts -o Dir::Bin::methods=$prefix/lib/apt/methods"
apt_opts="$apt_opts -o Dir::State::extended_states=$prefix/var/lib/apt/extended_states"
apt_opts="$apt_opts -o Dir::Bin::dpkg=$_dpkg_bin"
apt_opts="$apt_opts -o DPkg::Path=$prefix/libexec/mio:$prefix/bin:/system/bin:/system/xbin"
apt_opts="$apt_opts -o Acquire::ForceIPv4=true -o Acquire::Languages=none"
apt_opts="$apt_opts -o Acquire::Retries=3 -o Acquire::http::Pipeline-Depth=0"
arch=$(dpkg --print-architecture 2>/dev/null)
[ -n "$arch" ] && apt_opts="$apt_opts -o APT::Architecture=$arch"

if [ "$NAME" = "pkg" ]; then
    # `pkg` kendi argüman ayrıştırıcısını kullanır, `-o` kabul etmez; ama `apt`/`apt-get`'i PATH'ten
    # çağırdığı için onlar bu sarmalayıcıdan geçer ve yollar orada dayatılır.
    export APT_CONFIG="$conf_dir/mio-apt.conf"
    # `pkg` her çağrıda rastgele ayna seçip sources.list'i eziyordu; seçili depo korunsun
    export TERMUX_PKG_NO_MIRROR_SELECT=1
    exec "$bin/$NAME.mio-real" "$@"
fi
# 9) termux-exec ön yükleyicisi apt'nin başlattığı indirme yöntemi süreçlerini bozabiliyor:
#    "E: Sub-process https returned an error code (100)" / "Method ... did not start correctly".
#    apt ve alt süreçleri kendi yollarını bildiği için ön yükleyici olmadan çalıştırılır.
if [ -n "${LD_PRELOAD:-}" ]; then
    MIO_LD_PRELOAD="$LD_PRELOAD"
    unset LD_PRELOAD
fi
# dpkg, paket betiklerini ve yardımcı programları PATH'te arar; korumalı sarmalayıcı + önek başta olsun
case ":$PATH:" in
    *":$prefix/bin:"*) ;;
    *) PATH="$prefix/bin:$PATH" ;;
esac
case ":$PATH:" in
    *":$prefix/libexec/mio:"*) ;;
    *) PATH="$prefix/libexec/mio:$PATH" ;;
esac
export PATH

# 10) Sürüm 28: Termux bootstrap'ı eski kaldığı için yalnız `curl` gibi tek bir paketi kurmak
#     `libngtcp2` / `libnghttp3` / `openssl` / `libandroid-support` gibi bağımlı kütüphaneleri
#     yükseltmiyor ve `cannot locate symbol` hatasına yol açıyor. `install` sırasında
#     ilgili tüm eski bağımlılıklar da aynı işleme eklenir.
extra_deps=""
if [ "${MIO_NO_DEP_UPGRADE:-0}" != "1" ] && [ -x "$prefix/bin/mio" ]; then
    _is_inst=0
    _skip_dep=0
    _pkgs=""
    _local_debs=""
    for _a in "$@"; do
        case "$_a" in
            install) _is_inst=1 ;;
            -s|--simulate|--just-print|--dry-run|-d|--download-only|--print-uris) _skip_dep=1 ;;
            *.deb) _local_debs="$_local_debs $_a" ;;
            -*|/*) ;;
            *) [ "$_is_inst" -eq 1 ] && _pkgs="$_pkgs ${_a%%[=/:]*}" ;;
        esac
    done
    if [ "$_is_inst" -eq 1 ] && [ "$_skip_dep" -eq 0 ]; then
        for _ldeb in $_local_debs; do
            [ -f "$_ldeb" ] && "$prefix/bin/mio" deb-cevir "$_ldeb" || :
        done
        if [ -n "$_pkgs" ]; then
            extra_deps=$(MIO_NO_DEP_UPGRADE=1 "$prefix/bin/mio" resolve-deps $_pkgs 2>/dev/null || true)
        fi
    fi
fi

# shellcheck disable=SC2086
exec "$bin/$NAME.mio-real" $apt_opts "$@" $extra_deps
MIO_EOF
    sed -e "s|@@NAME@@|$name|g" -e "s|@@PREFIX@@|$PREFIX|g" "$wrapper" > "$wrapper.tmp" 2>/dev/null && mv "$wrapper.tmp" "$wrapper"
    chmod 755 "$wrapper" 2>/dev/null
    printf 'mio: %s sarmalayıcısı kuruldu\n' "$name"
}

# ---------------------------------------------------------------------------------------------
# .deb dönüştürücü: depodaki paketler `com.termux` öneki için derlenmiş
# (`./data/data/com.termux/files/usr/...` yolları ve maint script shebang'leri). Bu önek bu
# uygulamada yok; dpkg "unable to stat './data/data/com.termux' ... Permission denied" veriyor.
# ---------------------------------------------------------------------------------------------

# Bir kök dizini .deb olarak paketler. Önce `dpkg-deb -b`, olmazsa `ar` + `tar`
# (cihazda `dpkg-deb -b` sessizce başarısız olabiliyor, bu yüzden iki yol var).
#   mio_pack_deb <kök-dizin> <çıktı.deb>
mio_pack_deb() {
    _pk_root="$1"
    _pk_out="$2"
    rm -f "$_pk_out" 2>/dev/null

    _ddpkg=""
    for c in "$PREFIX/bin/dpkg-deb.mio-real" "$PREFIX/bin/dpkg-deb" dpkg-deb; do
        if command -v "$c" >/dev/null 2>&1; then _ddpkg="$c"; break; fi
    done
    if [ -n "$_ddpkg" ]; then
        # Hız: varsayılan xz sıkıştırması Android'de paket başına 10-30 sn sürüyor.
        # Geçici yerel .deb için `-Znone` (sıkıştırmasız) veya `-Zgzip -z1` 20 kat daha hızlıdır.
        if "$_ddpkg" -Znone -b "$_pk_root" "$_pk_out" >/dev/null 2>&1 && [ -s "$_pk_out" ]; then
            return 0
        fi
        if "$_ddpkg" -Zgzip -z1 -b "$_pk_root" "$_pk_out" >/dev/null 2>&1 && [ -s "$_pk_out" ]; then
            return 0
        fi
        if "$_ddpkg" -b "$_pk_root" "$_pk_out" >/dev/null 2>&1 && [ -s "$_pk_out" ]; then
            return 0
        fi
    fi

    _ar=""
    for c in "$PREFIX/bin/ar" ar; do
        if command -v "$c" >/dev/null 2>&1; then _ar="$c"; break; fi
    done
    _tar=""
    for c in "$PREFIX/bin/tar" tar; do
        if command -v "$c" >/dev/null 2>&1; then _tar="$c"; break; fi
    done
    # Bootstrap'ta `ar` genelde yoktur (binutils kurulu değilse). O zaman `.deb` kabını
    # (debian-binary + control.tar.gz + data.tar.gz) doğrudan kendimiz yazarız:
    #   global başlık "!<arch>\n" + her üye için 60 baytlık başlık + içerik (tek sayıya hizalı)
    [ -n "$_tar" ] || return 1

    _pk_dir="$_pk_root.mio-pack"
    rm -rf "$_pk_dir" 2>/dev/null
    mkdir -p "$_pk_dir/ctl" "$_pk_dir/data" 2>/dev/null || return 1
    # Kontrol dosyaları: Android'de `cp -a` (korumalı mod bitleri) sessizce başarısız olabiliyor,
    # bu yüzden önce kopyalanır, olmazsa `cat` ile tek tek yazılır.
    if [ -d "$_pk_root/DEBIAN" ]; then
        cp -a "$_pk_root/DEBIAN/." "$_pk_dir/ctl/" 2>/dev/null
        for _pk_f in "$_pk_root/DEBIAN"/* "$_pk_root/DEBIAN"/.[!.]*; do
            [ -f "$_pk_f" ] || continue
            [ -f "$_pk_dir/ctl/${_pk_f##*/}" ] && [ -s "$_pk_dir/ctl/${_pk_f##*/}" ] && continue
            cat "$_pk_f" > "$_pk_dir/ctl/${_pk_f##*/}" 2>/dev/null
            chmod 755 "$_pk_dir/ctl/${_pk_f##*/}" 2>/dev/null
        done
        # maint script'ler çalıştırılabilir olmalı (dpkg aksi halde "not executable" diyebilir)
        for _pk_f in postinst preinst postrm prerm config; do
            [ -f "$_pk_dir/ctl/$_pk_f" ] && chmod 755 "$_pk_dir/ctl/$_pk_f" 2>/dev/null
        done
    fi
    # data.tar: kök içindeki her şey, DEBIAN dizini HARİÇ (dpkg kontrol dizinini data.tar'dan
    # okumaz; içinde kalırsa "error creating directory './DEBIAN': Permission denied" verir).
    # GNU tar'da `--exclude=./DEBIAN` çalışır; toybox/busybox tar'da seçenek olmayabilir, bu
    # yüzden önce "hariç tut" denenir, olmazsa dosyalar tek tek listelenir.
    rm -f "$_pk_dir/data.tar.gz" 2>/dev/null
    ( cd "$_pk_root" && "$_tar" -czf "$_pk_dir/data.tar.gz" --exclude=DEBIAN . ) >/dev/null 2>&1
    # tar `--exclude` bilmiyorsa hiç dosya üretmez; o zaman da kenara alma yoluna geçilir.
    if [ ! -s "$_pk_dir/data.tar.gz" ] ||
       "$_tar" -tzf "$_pk_dir/data.tar.gz" 2>/dev/null | grep -q '^\./DEBIAN'; then
        # dışlama desteklenmedi: DEBIAN'ı geçici olarak kenara al, sonra geri koy
        rm -rf "$_pk_dir/ctl-save" 2>/dev/null
        mv "$_pk_root/DEBIAN" "$_pk_dir/ctl-save" 2>/dev/null
        rm -f "$_pk_dir/data.tar.gz" 2>/dev/null
        ( cd "$_pk_root" && "$_tar" -czf "$_pk_dir/data.tar.gz" . ) >/dev/null 2>&1
        mv "$_pk_dir/ctl-save" "$_pk_root/DEBIAN" 2>/dev/null
    fi
    ( cd "$_pk_dir/ctl" && "$_tar" -czf "$_pk_dir/control.tar.gz" . ) >/dev/null 2>&1
    printf '2.0\n' > "$_pk_dir/debian-binary"
    if [ ! -s "$_pk_dir/data.tar.gz" ] || [ ! -s "$_pk_dir/control.tar.gz" ]; then
        rm -rf "$_pk_dir" 2>/dev/null
        return 1
    fi

    if [ -n "$_ar" ]; then
        ( cd "$_pk_dir" && "$_ar" rc "$_pk_out" debian-binary control.tar.gz data.tar.gz ) >/dev/null 2>&1
    else
        mio_ar_write "$_pk_out" "$_pk_dir/debian-binary" "$_pk_dir/control.tar.gz" "$_pk_dir/data.tar.gz"
    fi
    rm -rf "$_pk_dir" 2>/dev/null
    [ -s "$_pk_out" ] || return 1
    return 0
}

# `ar` olmadan .deb kabı yaz: her üye için 60 baytlık başlık (ad, tarih, uid, gid, mod, boyut,
# "`\n"), içerik tek sayıya hizalı. Sadece gerekli alanlar doldurulur.
#   mio_ar_write <çıktı> <üye> [üye...]
mio_ar_write() {
    _aw_out="$1"
    shift
    _aw_off=0
    : > "$_aw_out" 2>/dev/null || return 1
    printf '!<arch>\n' >> "$_aw_out"
    for _aw_m in "$@"; do
        [ -f "$_aw_m" ] || return 1
        _aw_size=$(wc -c < "$_aw_m" 2>/dev/null | tr -d ' ')
        [ -n "$_aw_size" ] || return 1
        _aw_name=$(basename "$_aw_m")
        # ad alanı 16 bayt, "/" ile bitirilir
        printf '%-16s%-12s%-6s%-6s%-8s%-10s`\n' "$_aw_name/" "0" "0" "0" "100644" "$_aw_size" >> "$_aw_out"
        cat "$_aw_m" >> "$_aw_out" 2>/dev/null || return 1
        if [ $((_aw_size % 2)) -ne 0 ]; then
            printf '\n' >> "$_aw_out"
        fi
    done
    return 0
}

# Metin olarak güvenle değiştirilemeyecek dosya türleri: sıkıştırılmış arşivler ve ikili
# biçimler. Bunların İÇİNDEKİ yol metni değiştirilmez; doğrulama da bu dosyaları atlar
# (aksi halde çevrilemeyen bir .gz yüzünden paket "çevrilemedi" sayılırdı).
# NOT: *.so burada ATLANMAZ — ELF paylaşımlı kütüphaneler (`libpython3.14.so` vb.)
# içlerindeki DT_RUNPATH `/data/data/com.termux/files/usr/lib` yüzünden Android
# dinamik yükleyicisinde "library ... not found" hatası verir; bu yüzden `mio_patch_elf`
# ile çevrilmeleri şarttır.
#   mio_binary_like <dosya> -> 0 ise atlanmalı
mio_binary_like() {
    case "$1" in
        *.gz|*.tgz|*.xz|*.lzma|*.bz2|*.zip|*.jar|*.apk|*.png|*.jpg|*.jpeg|*.gif|*.webp|\
        *.ttf|*.otf|*.woff|*.woff2|*.db|*.sqlite|*.pyc|*.a|*.o|*.mo|*.ico|*.pdf|\
        *.gz.*|*.7z|*.rar|*.zst|*.lz4)
            return 0 ;;
    esac
    return 1
}

# ELF içindeki önek yolunu AYNI UZUNLUKTA değiştirir: /data/data/com.termux   (21 bayt)
#                                                      -> /data/data/com.mio/// (21 bayt)
# Sondaki fazladan "/" yollar Linux'ta zararsızdır (aynı dosyaya çözülür) ve dosya boyu
# değişmediği için ELF offset'leri bozulmaz.
# `sed` yerine bayt düzeyinde çalışır ve sonunda boyutu doğrular: boyut değişirse dosya
# bozulmuş demektir (offset'ler kayar, dinamik yükleyici "missing DT_HASH" der).
#   mio_patch_elf <dosya>
mio_patch_elf() {
    _pe_f="$1"
    [ -f "$_pe_f" ] || return 1
    # ilk 4 bayt: 0x7f 'E' 'L' 'F'
    case "$(head -c 4 "$_pe_f" 2>/dev/null | tail -c 3)" in
        ELF) : ;;
        *) return 1 ;;
    esac
    grep -qa 'com\.termux' "$_pe_f" 2>/dev/null || return 0

    # aynı uzunlukta yeni yol (21 bayt)
    _pe_new="/data/data/com.mio///"
    [ "$(printf '%s' "$_pe_new" | wc -c | tr -d ' ')" = "21" ] || return 1

    [ -w "$_pe_f" ] || chmod u+w "$_pe_f" 2>/dev/null
    _pe_before=$(wc -c < "$_pe_f" 2>/dev/null | tr -d ' ')
    _pe_tmp="$_pe_f.mio-elf"
    rm -f "$_pe_tmp" 2>/dev/null
    LC_ALL=C sed -e 's|/data/data/com\.termux|/data/data/com.mio///|g' "$_pe_f" > "$_pe_tmp" 2>/dev/null
    _pe_after=$(wc -c < "$_pe_tmp" 2>/dev/null | tr -d ' ')
    if [ -z "$_pe_after" ] || [ "$_pe_before" != "$_pe_after" ]; then
        rm -f "$_pe_tmp" 2>/dev/null
        printf 'mio: uyarı: ikili dosya güvenle çevrilemedi (boyut %s -> %s): %s\n' \
            "$_pe_before" "$_pe_after" "$(basename "$_pe_f")" >&2
        return 1
    fi
    # ELF başlığı hâlâ yerinde mi?
    if [ "$(head -c 4 "$_pe_tmp" 2>/dev/null | tail -c 3)" != "ELF" ]; then
        rm -f "$_pe_tmp" 2>/dev/null
        printf 'mio: uyarı: ikili dosya bozuldu, atlandı: %s\n' "$(basename "$_pe_f")" >&2
        return 1
    fi
    cat "$_pe_tmp" > "$_pe_f" 2>/dev/null
    rm -f "$_pe_tmp" 2>/dev/null
    chmod 755 "$_pe_f" 2>/dev/null
    return 0
}

# Kurulu önekteki ($PREFIX/lib, $PREFIX/bin, $PREFIX/libexec) yamalanmamış ELF ikilileri
# ve .so kütüphanelerini (`libpython3.14.so` vb.) `/data/data/com.mio///` yoluna çevirir.
mio_repair_elf_libs() {
    _rel_fixed=0
    for _rel_dir in "$PREFIX/lib" "$PREFIX/bin" "$PREFIX/libexec"; do
        [ -d "$_rel_dir" ] || continue
        _rel_hits=$(mktemp 2>/dev/null || printf '%s/tmp/mio-elf-hits.$$' "$PREFIX")
        grep -rlF '/data/data/com.termux' "$_rel_dir" > "$_rel_hits" 2>/dev/null
        if [ "$?" -eq 2 ]; then
            grep -rl '/data/data/com\.termux' "$_rel_dir" > "$_rel_hits" 2>/dev/null || :
        fi
        while IFS= read -r _rel_f; do
            [ -f "$_rel_f" ] || continue
            [ -L "$_rel_f" ] && continue
            if [ "$(head -c 4 "$_rel_f" 2>/dev/null | tail -c 3)" = "ELF" ]; then
                mio_patch_elf "$_rel_f" && _rel_fixed=$((_rel_fixed + 1))
            fi
        done < "$_rel_hits"
        rm -f "$_rel_hits" 2>/dev/null
    done
    printf '%s\n' "$_rel_fixed"
}

# Teşhis: bir .deb neden çevrilemiyor? Hiçbir şeyi değiştirmez.
#   deb_report <dosya.deb>
deb_report() {
    [ -n "${1:-}" ] || { printf 'kullanım: mio deb-cevir -t <paket.deb>\n' >&2; return 2; }
    _dr_deb="$1"
    printf 'paket: %s\n' "$_dr_deb"
    [ -f "$_dr_deb" ] || { printf '  YOK: dosya bulunamadı\n' >&2; return 1; }
    printf '  boyut: %s bayt\n' "$(wc -c < "$_dr_deb" 2>/dev/null | tr -d ' ')"
    printf '  yazılabilir: '
    if [ -w "$_dr_deb" ]; then printf 'evet\n'; else printf 'HAYIR (dönüştürülen paket yazılamaz)\n'; fi
    printf '  önek: %s\n' "$PREFIX"
    for t in dpkg-deb dpkg tar; do
        _p=""
        for c in "$PREFIX/bin/$t" "$t"; do
            command -v "$c" >/dev/null 2>&1 && { _p="$c"; break; }
        done
        printf '  %-8s %s\n' "$t" "${_p:-YOK}"
    done
    _dr_dd=""
    for c in "$PREFIX/bin/dpkg-deb" dpkg-deb; do
        command -v "$c" >/dev/null 2>&1 && { _dr_dd="$c"; break; }
    done
    _dr_tar=""
    for c in "$PREFIX/bin/tar" tar; do
        command -v "$c" >/dev/null 2>&1 && { _dr_tar="$c"; break; }
    done
    if [ -n "$_dr_dd" ]; then
        printf '  listede com.termux: %s yol\n' "$("$_dr_dd" -c "$_dr_deb" 2>/dev/null | grep -c 'com\.termux')"
        printf '  kontrolde com.termux: '
        if "$_dr_dd" --ctrl-tarfile "$_dr_deb" 2>/dev/null | "$_dr_tar" -xzO 2>/dev/null | grep -qa 'com\.termux'; then
            printf 'VAR\n'
        else
            printf 'yok\n'
        fi
        printf '  tar dönüşümü (--transform): '
        if [ -n "$_dr_tar" ]; then
            # aynı dosya sisteminde küçük bir dizin açıp gerçek bir arşivle denenir
            _dr_chk="$PREFIX/tmp/mio-tar-check"
            rm -rf "$_dr_chk" 2>/dev/null
            mkdir -p "$_dr_chk/aa" 2>/dev/null
            : > "$_dr_chk/aa/f" 2>/dev/null
            ( cd "$_dr_chk" && "$_dr_tar" --transform 's|aa|bb|' -cf "$_dr_chk/out.tar" aa ) >/dev/null 2>&1
            _dr_t=""
            [ -s "$_dr_chk/out.tar" ] && _dr_t=$( "$_dr_tar" -tf "$_dr_chk/out.tar" 2>/dev/null | head -n 3 )
            rm -rf "$_dr_chk" 2>/dev/null
            if printf '%s' "$_dr_t" | grep -q 'bb'; then
                printf 'destekliyor\n'
            else
                printf 'YOK (üye üye yedek yol kullanılacak)\n'
            fi
        else
            printf 'tar YOK\n'
        fi
        # gerçek dönüşümü geçici kopya üzerinde dene
        _dr_tmp="$PREFIX/tmp/mio-deb-test-$$.deb"
        if cp "$_dr_deb" "$_dr_tmp" 2>/dev/null; then
            printf '  deneme (geçici kopya): '
            if mio_convert_deb "$_dr_tmp" 2>&1 | sed 's/^/    /'; then :; fi
            rm -f "$_dr_tmp" 2>/dev/null
        else
            printf '  deneme: geçici kopya yazılamadı (%s)\n' "$_dr_tmp"
        fi
    fi
    return 0
}

# Bir .deb dosyasını `com.mio` yollarıyla YERİNDE yeniden yazar.
#   1) com.termux ağacını com.mio ağacına taşır (kontrol dosyaları dahil)
#   2) maint script/conffiles/betik içeriklerini çevirir; ELF içindeki yolu sabit uzunlukta yazar
#   3) paketi yeniden üretir ve YAZDIKTAN SONRA doğrular
#   mio_convert_deb <dosya.deb>
mio_convert_deb() {
    _deb="$1"
    [ -f "$_deb" ] || return 1

    # GERÇEK dpkg-deb: sarmalayıcıyı kullanmak dönüşüm sırasında özyineleme yaratır
    _ddpkg=""
    for c in "$PREFIX/bin/dpkg-deb.mio-real" "$PREFIX/bin/dpkg-deb" dpkg-deb; do
        if command -v "$c" >/dev/null 2>&1; then _ddpkg="$c"; break; fi
    done
    [ -n "$_ddpkg" ] || { printf 'mio: dpkg-deb yok, paket çevrilemedi\n' >&2; return 1; }

    # tar seçimi: GNU tar (`--transform` destekli) hızlıca `--version` üzerinden seçilir;
    # yalnızca belirsizse geçici dizin sınaması yapılır.
    _tar=""
    _tar_tf=0
    for c in "$PREFIX/bin/tar" tar "$PREFIX/bin/gtar" gtar; do
        command -v "$c" >/dev/null 2>&1 || continue
        [ -z "$_tar" ] && _tar="$c"
        if "$c" --version 2>/dev/null | grep -q 'GNU tar'; then
            _tar="$c"
            _tar_tf=1
            break
        fi
    done
    if [ "$_tar_tf" -eq 0 ] && [ -n "$_tar" ]; then
        _chk="$PREFIX/tmp/mio-tar-sel.$$"
        rm -rf "$_chk" 2>/dev/null
        mkdir -p "$_chk/aa" 2>/dev/null
        : > "$_chk/aa/f" 2>/dev/null
        ( cd "$_chk" && "$_tar" --transform 's|aa|bb|' -cf "$_chk/out.tar" aa ) >/dev/null 2>&1
        _out=""
        [ -s "$_chk/out.tar" ] && _out=$( "$_tar" -tf "$_chk/out.tar" 2>/dev/null | head -n 3 )
        rm -rf "$_chk" 2>/dev/null
        case "$_out" in
            *bb*) _tar_tf=1 ;;
        esac
    fi

    # Hızlı yol: paket GERÇEKTEN com.mio yolluysa ve mimarisi uyuyorsa dokunma.
    _sys_arch=$("$PREFIX/bin/dpkg.mio-real" --print-architecture 2>/dev/null || dpkg --print-architecture 2>/dev/null || uname -m 2>/dev/null)
    _pkg_arch=$("$_ddpkg" -f "$_deb" Architecture 2>/dev/null | tr -d ' \t\r\n')
    _arch_fix=0
    case "$_pkg_arch:$_sys_arch" in
        arm64:aarch64|armhf:arm|amd64:x86_64|i386:i686) _arch_fix=1 ;;
    esac

    _need=0
    _fhs=0
    _list=$("$_ddpkg" -c "$_deb" 2>/dev/null | head -n 500)
    if printf '%s\n' "$_list" | grep -q 'com\.termux'; then
        _need=1
    elif "$_ddpkg" --ctrl-tarfile "$_deb" 2>/dev/null | "$_tar" -xzO 2>/dev/null | grep -qa 'com\.termux'; then
        _need=1
    elif ! printf '%s\n' "$_list" | grep -q 'data/data/com\.mio'; then
        if printf '%s\n' "$_list" | grep -qE '(^|[[:space:]])\.?/(usr|etc|bin|sbin|lib|lib64|opt|var|share)/|(^|[[:space:]])(usr|etc|bin|sbin|lib|lib64|opt|var|share)/'; then
            _fhs=1
        fi
    fi
    if [ "$_need" -eq 0 ] && [ "$_fhs" -eq 0 ]; then
        if "$_ddpkg" -c "$_deb" 2>/dev/null | grep -q 'com\.termux'; then
            _need=1
        fi
    fi
    [ "$_need" -eq 1 ] || [ "$_fhs" -eq 1 ] || [ "$_arch_fix" -eq 1 ] || return 0

    _base="${TMPDIR:-}"
    case "$_base" in
        ""|none|/nonexistent|/) _base="$PREFIX/tmp" ;;
    esac
    _work="$_base/mio-deb-$$"
    chmod -R u+rwX "$_work" 2>/dev/null
    rm -rf "$_work" 2>/dev/null
    mkdir -p "$_base" "$_work/root" "$_work/ctl" 2>/dev/null || return 1
    _root="$_work/root"
    _ctl="$_work/ctl"

    # ÖNEMLİ: ağaç ARTIK TAŞINMIYOR. `dpkg-deb -R` ile çıkarılan ağacı `mv`/`rm` ile yeniden
    # adlandırmak Android'de güvenilir değil (cihazda "12 yolda com.termux kaldı" hatası buydu:
    # komutlar hata vermeden hiçbir şey yapmıyordu). Bunun yerine yollar ÇIKARMA SIRASINDA
    # değiştirilir: GNU tar `--transform`, desteklemiyorsa her üye `tar -O` ile tek tek yazılır.
    _conv_ok=0
    if [ -n "$_tar" ] && [ "$_tar_tf" -eq 1 ]; then
        # 1) veri: data.tar akışı doğrudan dönüştürülerek açılır
        if "$_ddpkg" --fsys-tarfile "$_deb" 2>/dev/null |
           ( cd "$_root" && "$_tar" -xf - --transform 's|com\.termux|com.mio|g' ) >/dev/null 2>&1; then
            _conv_ok=1
        fi
        # 2) kontrol dosyaları (aynı dönüşümle)
        if [ "$_conv_ok" -eq 1 ]; then
            "$_ddpkg" --ctrl-tarfile "$_deb" 2>/dev/null |
                ( cd "$_ctl" && "$_tar" -xf - --transform 's|com\.termux|com.mio|g' ) >/dev/null 2>&1 ||
                "$_ddpkg" --ctrl-tarfile "$_deb" 2>/dev/null | ( cd "$_ctl" && "$_tar" -xf - ) >/dev/null 2>&1
        fi
    fi

    if [ "$_conv_ok" -eq 0 ] && [ -n "$_tar" ]; then
        # Yedek yol (tar --transform yok): dpkg-deb -R ile aç, sonra taşımadan, üye üye yaz.
        rm -rf "$_work/raw" 2>/dev/null
        mkdir -p "$_work/raw" 2>/dev/null
        if ! "$_ddpkg" -R "$_deb" "$_work/raw" >/dev/null 2>&1; then
            printf 'mio: paket açılamadı: %s\n' "$(basename "$_deb")" >&2
            rm -rf "$_work" 2>/dev/null
            return 1
        fi
        if [ -d "$_work/raw/DEBIAN" ]; then
            cp -a "$_work/raw/DEBIAN/." "$_ctl/" 2>/dev/null
            for _f in "$_work/raw/DEBIAN"/*; do
                [ -f "$_f" ] || continue
                cat "$_f" > "$_ctl/${_f##*/}" 2>/dev/null
            done
        fi
        ( cd "$_work/raw" && "$_tar" -cf "$_work/raw.tar" . ) >/dev/null 2>&1
        if [ ! -s "$_work/raw.tar" ]; then
            printf 'mio: paket açılamadı (tar): %s\n' "$(basename "$_deb")" >&2
            rm -rf "$_work" 2>/dev/null
            return 1
        fi
        # Üye üye kopyalama: symlink, dizin ve normal dosya AYRI ele alınır. Aksi halde
        # symlink'ler sıfır baytlık normal dosyaya dönüşüyor ve paket çalışmıyordu.
        "$_tar" -tvf "$_work/raw.tar" 2>/dev/null | while IFS= read -r _line; do
            _mode=$(printf '%s' "$_line" | cut -c1)
            _p=$(printf '%s' "$_line" | sed -e 's|^[^ ]* *[^ ]* *[^ ]* *[^ ]* *[^ ]* *||' -e 's| link to .*||' -e 's| -> .*||')
            case "$_p" in
                ""|./DEBIAN|./DEBIAN/*|DEBIAN|DEBIAN/*) continue ;;
            esac
            _np=$(printf '%s' "$_p" | sed 's|com\.termux|com.mio|g')
            _d=$(dirname "$_np")
            [ "$_d" = "." ] || mkdir -p "$_root/$_d" 2>/dev/null
            case "$_mode" in
                d) mkdir -p "$_root/$_np" 2>/dev/null ;;
                l)
                    _lt=$(printf '%s' "$_line" | sed -e 's|.* -> ||' -e 's|.* link to ||')
                    case "$_lt" in
                        ""|"$_p") continue ;;
                    esac
                    _lt=$(printf '%s' "$_lt" | sed 's|com\.termux|com.mio|g')
                    ln -sfn "$_lt" "$_root/$_np" 2>/dev/null
                    ;;
                *)
                    "$_tar" -xOf "$_work/raw.tar" "$_p" > "$_root/$_np" 2>/dev/null
                    case "$_p" in
                        */bin/*|*/sbin/*|*/libexec/*|*.sh) chmod 755 "$_root/$_np" 2>/dev/null ;;
                    esac
                    ;;
            esac
        done
        rm -rf "$_work/raw" "$_work/raw.tar" 2>/dev/null
    fi

    if [ -z "$_tar" ]; then
        printf 'mio: tar bulunamadı, paket çevrilemedi: %s\n' "$(basename "$_deb")" >&2
        rm -rf "$_work" 2>/dev/null
        return 1
    fi

    # 2b) Standart Linux/Debian FHS paketi (örn. code-server.deb: /usr/bin, /usr/lib) -> com.mio önekine taşı
    if [ "$_fhs" -eq 1 ] && [ ! -d "$_root/data/data/com.mio" ]; then
        mkdir -p "$_root/data/data/com.mio/files" 2>/dev/null
        if [ -d "$_root/usr" ] && [ ! -e "$_root/data/data/com.mio/files/usr" ]; then
            mv "$_root/usr" "$_root/data/data/com.mio/files/usr" 2>/dev/null
        fi
        mkdir -p "$_root/data/data/com.mio/files/usr" 2>/dev/null
        for _sub in usr bin sbin lib lib64 etc var opt share; do
            [ -d "$_root/$_sub" ] || continue
            case "$_sub" in
                usr)
                    cp -a "$_root/usr/." "$_root/data/data/com.mio/files/usr/" 2>/dev/null
                    rm -rf "$_root/usr" 2>/dev/null
                    ;;
                sbin)
                    mkdir -p "$_root/data/data/com.mio/files/usr/bin" 2>/dev/null
                    cp -a "$_root/sbin/." "$_root/data/data/com.mio/files/usr/bin/" 2>/dev/null
                    rm -rf "$_root/sbin" 2>/dev/null
                    ;;
                lib64)
                    mkdir -p "$_root/data/data/com.mio/files/usr/lib" 2>/dev/null
                    cp -a "$_root/lib64/." "$_root/data/data/com.mio/files/usr/lib/" 2>/dev/null
                    rm -rf "$_root/lib64" 2>/dev/null
                    ;;
                *)
                    mkdir -p "$_root/data/data/com.mio/files/usr/$_sub" 2>/dev/null
                    cp -a "$_root/$_sub/." "$_root/data/data/com.mio/files/usr/$_sub/" 2>/dev/null
                    rm -rf "$_root/$_sub" 2>/dev/null
                    ;;
            esac
        done

        # FHS betik yollarını (/usr/bin, /usr/lib, #!/bin/sh) com.mio önekine çevir
        for _dir in "$_root/data/data/com.mio/files/usr/bin" \
                    "$_root/data/data/com.mio/files/usr/libexec" \
                    "$_root/data/data/com.mio/files/usr/lib"/*/bin; do
            [ -d "$_dir" ] || continue
            for _f in "$_dir"/*; do
                [ -f "$_f" ] || continue
                [ "$(head -c 4 "$_f" 2>/dev/null | tail -c 3)" = "ELF" ] && continue
                mio_binary_like "$_f" && continue
                if grep -qE '/(usr|etc)/(bin|lib|share|etc)|#!/bin/sh|#!/usr/bin/env' "$_f" 2>/dev/null; then
                    [ -w "$_f" ] || chmod u+w "$_f" 2>/dev/null
                    sed -i \
                        -e 's|/data/data/com\.mio/files/usr|@@MIO_USR@@|g' \
                        -e 's|#!/bin/sh|#!@@MIO_USR@@/bin/sh|g' \
                        -e 's|#!/usr/bin/env|#!@@MIO_USR@@/bin/env|g' \
                        -e 's|/usr/lib/|@@MIO_USR@@/lib/|g' \
                        -e 's|/usr/bin/|@@MIO_USR@@/bin/|g' \
                        -e 's|/usr/share/|@@MIO_USR@@/share/|g' \
                        -e 's|/etc/|@@MIO_USR@@/etc/|g' \
                        -e 's|@@MIO_USR@@|/data/data/com.mio/files/usr|g' \
                        "$_f" 2>/dev/null
                fi
            done
        done
    fi

    if [ ! -d "$_root/data/data/com.mio" ] && [ ! -d "$_root/data/data/com.termux" ]; then
        printf 'mio: paket içeriği çıkarılamadı: %s\n' "$(basename "$_deb")" >&2
        rm -rf "$_work" 2>/dev/null
        return 1
    fi

    # 3) metin dosyaları ve ELF ikilileri (.so dahil):
    #    Tek bir `grep -rlF` ile yalnız içinde `com.termux` geçen dosyalar seçilir
    #    (python gibi binlerce dosyalık paketlerde 3000 ayrı fork yerine 1 çağrı).
    #    ÖNCE ELF imzasına bakılır, sonra `mio_binary_like`: böylece *.so / *.so.*
    #    kütüphaneleri her zaman `mio_patch_elf` ile DT_RUNPATH yaması alır.
    if [ "$_need" -eq 1 ]; then
        grep -rlF 'com.termux' "$_root" > "$_work/hits.lst" 2>/dev/null
        if [ "$?" -eq 2 ]; then
            grep -rl 'com\.termux' "$_root" > "$_work/hits.lst" 2>/dev/null || :
        fi
        while IFS= read -r _f; do
            [ -f "$_f" ] || continue
            # Salt-okunur gelebilir (tar izinleri korur): yazma izni olmadan düzenleme düşer
            [ -w "$_f" ] || chmod u+w "$_f" 2>/dev/null
            # ELF imzası: 0x7f 'E' 'L' 'F' -> head -c 4 çıktısı $'\177ELF'tir, bu yüzden son 3 bayta bakılır
            if [ "$(head -c 4 "$_f" 2>/dev/null | tail -c 3)" = "ELF" ]; then
                # ELF: değiştirme AYNI UZUNLUKTA olmalı, yoksa dosya boyu değişir ve tüm offset'ler
                # kayar -> "empty/missing DT_HASH/DT_GNU_HASH" / "unused DT entry" hataları.
                mio_patch_elf "$_f"
            else
                mio_binary_like "$_f" && continue
                sed -i 's|/data/data/com\.termux|/data/data/com.mio|g' "$_f" 2>/dev/null
                sed -i 's|com\.termux|com.mio|g' "$_f" 2>/dev/null
            fi
        done < "$_work/hits.lst"
        for _f in "$_ctl"/*; do
            [ -f "$_f" ] || continue
            grep -qa 'com\.termux' "$_f" 2>/dev/null || continue
            sed -i 's|/data/data/com\.termux|/data/data/com.mio|g' "$_f" 2>/dev/null
            sed -i 's|com\.termux|com.mio|g' "$_f" 2>/dev/null
        done
    fi
    if [ "$_arch_fix" -eq 1 ] && [ -f "$_ctl/control" ]; then
        [ -w "$_ctl/control" ] || chmod u+w "$_ctl/control" 2>/dev/null
        sed -i "s/^Architecture:[[:space:]]*$_pkg_arch\$/Architecture: $_sys_arch/" "$_ctl/control" 2>/dev/null
    fi
    for _f in postinst preinst postrm prerm config; do
        [ -f "$_ctl/$_f" ] && chmod 755 "$_ctl/$_f" 2>/dev/null
    done

    # 3c) DİZİN VE DOSYA İZİNLERİ: dpkg, dosyayı hedef dizine `*.dpkg-new` olarak yazar; dizin
    #     yazılabilir değilse "unable to create ... Permission denied" verir. Ayrıca non-root
    #     Android'de dpkg bazı 0444 dosyaları fsync için O_WRONLY ile açmaya çalışırken
    #     "unable to open ...dpkg-new: Permission denied" verebiliyor; bu yüzden salt-okunur
    #     normal dosyalara da sahip yazma izni (u+w) eklenir.
    find "$_root" -type d ! -perm -755 -exec chmod 755 {} + 2>/dev/null
    find "$_root" -type f ! -perm -u+w -exec chmod u+w {} + 2>/dev/null

    # 4) yeniden paketle: DEBIAN dizini kontrol dosyalarından, veri ağacı çıkarılan kökten
    cp -a "$_ctl/." "$_root/DEBIAN/" 2>/dev/null
    if [ ! -f "$_root/DEBIAN/control" ]; then
        mkdir -p "$_root/DEBIAN" 2>/dev/null
        cp -a "$_ctl/." "$_root/DEBIAN/" 2>/dev/null
        for _f in "$_ctl"/*; do
            [ -f "$_f" ] || continue
            cat "$_f" > "$_root/DEBIAN/${_f##*/}" 2>/dev/null
        done
    fi
    if ! mio_pack_deb "$_root" "$_work/new.deb"; then
        printf 'mio: paket yeniden paketlenemedi: %s\n' "$(basename "$_deb")" >&2
        rm -rf "$_work" 2>/dev/null
        return 1
    fi

    # 5) DOĞRULA: yeni pakette com.termux kaldı mı?
    if [ "$_need" -eq 1 ]; then
        _left=$("$_ddpkg" -c "$_work/new.deb" 2>/dev/null | grep -c 'com\.termux')
        [ -n "$_left" ] || _left=0
        if [ "$_left" -eq 0 ]; then
            _inner=0
            grep -rlF 'com.termux' "$_root" "$_ctl" > "$_work/left.lst" 2>/dev/null
            if [ "$?" -eq 2 ]; then
                grep -rl 'com\.termux' "$_root" "$_ctl" > "$_work/left.lst" 2>/dev/null || :
            fi
            while IFS= read -r _f; do
                [ -f "$_f" ] || continue
                if [ "$(head -c 4 "$_f" 2>/dev/null | tail -c 3)" = "ELF" ]; then
                    grep -qaF '/data/data/com.termux' "$_f" 2>/dev/null || continue
                else
                    mio_binary_like "$_f" && continue
                fi
                _inner=$((_inner + 1))
                [ "$_inner" -le 3 ] && printf 'mio: çevrilmeyen dosya: %s\n' "$_f" >&2
            done < "$_work/left.lst"
            if [ "$_inner" -gt 0 ]; then
                printf 'mio: paket içinde com.termux kaldı (%s dosya)\n' "$_inner" >&2
                rm -rf "$_work" 2>/dev/null
                return 1
            fi
        fi
        if [ "$_left" -gt 0 ]; then
            printf 'mio: paket çevrilemedi (%s yolda com.termux kaldı): %s\n' "$_left" "$(basename "$_deb")" >&2
            rm -rf "$_work" 2>/dev/null
            return 1
        fi
    fi

    # 6) yerine koy (`new.deb` az önce doğrulandı; aynı dosya sisteminde `mv -f` anlıktır)
    if mv -f "$_work/new.deb" "$_deb" 2>/dev/null || cat "$_work/new.deb" > "$_deb" 2>/dev/null; then
        chmod 644 "$_deb" 2>/dev/null || :
        printf 'mio: paket com.mio yollarına çevrildi: %s\n' "$(basename "$_deb")" >&2
        rm -rf "$_work" 2>/dev/null
        return 0
    fi
    printf 'mio: paket yazılamadı: %s\n' "$(basename "$_deb")" >&2
    rm -rf "$_work" 2>/dev/null
    return 1
}

# dpkg veritabanını (var/lib/dpkg) onarır.
#
# `apt install` sırasında sık görülen iki bozulma:
#   "dpkg: unrecoverable fatal error, aborting:
#    files list file for package 'sed' is missing final newline"
#   "dpkg: error: failed to open package info file ... for reading: No such file or directory"
# Bunlar genelde yarıda kalan bir kurulumdan (ya da paket listesinin eksik yazılmasından) kalır.
# - `info/*.list`: sonu \n ile bitmeli; eksikse yeni satır eklenir
# - `status` içinde "install ok installed" görünen ama `info/*.list` dosyası olmayan paketler
#   "half-installed" durumuna alınır (dpkg bunları sonra --configure ile toparlayabilir)
# - updates/ kilit dosyası gibi artıklar temizlenir
#   mio_repair_dpkg_db
# Önek içindeki DİZİNLERİ yazılabilir yapar.
#
# dpkg bir dosyayı kurarken hedef dizine `<ad>.dpkg-new` yazar. Dizin yazılabilir değilse:
#   dpkg: error processing archive ...:
#    unable to create '.../share/x/probe.dpkg-new' ...: Permission denied
#     error creating directory './data/data/com.mio/files/usr/share/x': Permission denied
# Bu, paketlerin kendi dizinlerini 0555 gibi modlarla taşımasından ya da öneğin bir ara
# adımda izinlerinin bozulmasından kaynaklanır. Dizinler kullanıcının kendi özel alanı
# olduğu için yalnız SAHİBİNE yazma/çalıştırma izni eklenir (755 gibi sıkılaştırma yapılmaz).
#   mio_fix_prefix_perms
mio_fix_prefix_perms() {
    _pp="${PREFIX:-/data/data/com.mio/files/usr}"
    [ -d "$_pp" ] || return 0
    _ppn=0

    # 1) sık kullanılan üst dizinler (hızlı yol; tam tarama pahalı olabilir)
    for _d in "$_pp" "$_pp/bin" "$_pp/lib" "$_pp/libexec" "$_pp/share" "$_pp/etc" "$_pp/var" \
              "$_pp/tmp" "$_pp/opt" "$_pp/include" "$_pp/src" "$_pp/var/lib/dpkg" \
              "$_pp/var/lib/dpkg/info" "$_pp/var/lib/dpkg/updates" "$_pp/var/cache/apt" \
              "$_pp/var/cache/apt/archives" "$_pp/var/log" "$_pp/var/log/apt"; do
        [ -d "$_d" ] || continue
        [ -w "$_d" ] && continue
        chmod u+rwx "$_d" 2>/dev/null && _ppn=$((_ppn + 1))
    done

    # 2) share/bin/lib altında yazılamaz kalan dizinler (kurulan paketler 0555 bırakabiliyor)
    #    Alt kabuk (find | while) kullanılmıyor: sayaç orada kayboluyordu. Geçici dosya da
    #    kullanılmıyor: Android'de /tmp YOK, dosya açılamayınca onarım sessizce hiç çalışmıyordu.
    #    Bu yüzden iki geçiş: önce say, sonra -exec ile düzelt (POSIX, ara dosyasız).
    for _base in "$_pp/share" "$_pp/bin" "$_pp/lib" "$_pp/libexec" "$_pp/etc"; do
        [ -d "$_base" ] || continue
        _n=$(find "$_base" -type d ! -perm -u+w 2>/dev/null | wc -l)
        [ "${_n:-0}" -gt 0 ] 2>/dev/null || continue
        find "$_base" -type d ! -perm -u+w -exec chmod u+rwx {} \; 2>/dev/null
        _ppn=$((_ppn + _n))
    done

    MIO_PREFIX_FIXED=$(( ${MIO_PREFIX_FIXED:-0} + _ppn ))
    [ "$_ppn" -gt 0 ] && printf 'mio: önek dizin izinleri düzeltildi (%s dizin)\n' "$_ppn" >&2
    return 0
}

mio_repair_dpkg_db() {
    _db="${PREFIX:-/data/data/com.mio/files/usr}/var/lib/dpkg"
    [ -d "$_db" ] || return 0
    _fixed=0

    # 0a) dpkg şu an çalışıyorsa veritabanına ASLA dokunma!
    #     dpkg çalışma süresince updates/tmp.i dosyasını açık tutar ve bitirirken
    #     rename("updates/tmp.i", "updates/0000") yapar; o dosya silinirse dpkg
    #     "unable to install updated status of '<paket>': No such file or directory" ile çöker.
    if [ -n "${MIO_DPKG_RUNNING:-}" ]; then
        return 0
    fi
    for _pc in /proc/[0-9]*/cmdline; do
        [ -r "$_pc" ] || continue
        if tr '\000' ' ' < "$_pc" 2>/dev/null | grep -q 'dpkg\.mio-real'; then
            return 0
        fi
    done

    # 0b) İki mio_repair_dpkg_db çağrısı (ör. açılış arka planı + terminal komutu) aynı anda
    #     çakışıp *.mio-tmp artığı bırakmasın diye basit mkdir kilidi al.
    _lock="$_db/.mio-repair.lock"
    _got_lock=0
    if mkdir "$_lock" 2>/dev/null; then
        printf '%s\n' "$$" > "$_lock/pid" 2>/dev/null
        _got_lock=1
    elif [ -f "$_lock/pid" ]; then
        _lpid=$(cat "$_lock/pid" 2>/dev/null || true)
        if [ -n "$_lpid" ] && ! kill -0 "$_lpid" 2>/dev/null; then
            rm -rf "$_lock" 2>/dev/null
            if mkdir "$_lock" 2>/dev/null; then
                printf '%s\n' "$$" > "$_lock/pid" 2>/dev/null
                _got_lock=1
            fi
        fi
    fi
    [ "$_got_lock" -eq 1 ] || return 0

    # 0c) dpkg'nin ÇALIŞMA DİZİNLERİ. Eksik ya da yazılamaz olduğunda dpkg şu hatayı verir:
    #      dpkg: unrecoverable fatal error, aborting:
    #       unable to install updated status of '<paket>': No such file or directory
    #    (status güncellemesi geçici olarak updates/ altına yazılır). Bu yüzden her çalıştırmada
    #    dizinler oluşturulur ve yazma izni verilir.
    for _d in "$_db" "$_db/info" "$_db/updates" "$_db/parts" "$_db/triggers" \
              "${PREFIX:-/data/data/com.mio/files/usr}/var/log" \
              "${PREFIX:-/data/data/com.mio/files/usr}/var/log/apt"; do
        if [ ! -d "$_d" ]; then
            mkdir -p "$_d" 2>/dev/null && _fixed=$((_fixed + 1))
        fi
    done
    # updates/ eskiden dosya olarak kalmışsa (bozuk kurulum) dizine çevir
    if [ -e "$_db/updates" ] && [ ! -d "$_db/updates" ]; then
        rm -f "$_db/updates" 2>/dev/null
        mkdir -p "$_db/updates" 2>/dev/null && _fixed=$((_fixed + 1))
    fi
    # root olmayan kurulumda dpkg bu dizinlere yazabilmeli
    for _d in "$_db" "$_db/info" "$_db/updates" "$_db/parts" "$_db/triggers"; do
        [ -d "$_d" ] || continue
        [ -w "$_d" ] || chmod u+rwx "$_d" 2>/dev/null
    done
    if [ -d "${PREFIX:-/data/data/com.mio/files/usr}/var/log/dpkg.log" ]; then
        rm -rf "${PREFIX:-/data/data/com.mio/files/usr}/var/log/dpkg.log" 2>/dev/null
        _fixed=$((_fixed + 1))
    fi
    # updates/ içinde yarıda kalmış durum dosyaları dpkg'yi kilitler (dpkg çalışmıyorken temizle)
    rm -f "$_db"/updates/[0-9]* "$_db"/updates/tmp.* 2>/dev/null
    [ -f "$_db/status" ] || : > "$_db/status" 2>/dev/null
    if [ ! -d "$_db/info" ]; then
        rm -rf "$_lock" 2>/dev/null
        return 0
    fi

    # Önceki kesintilerden (Ctrl+C vb.) kalan *.mio-tmp* artıklarını temizle
    for _lt in "$_db/info"/*.mio-tmp*; do
        [ -e "$_lt" ] || continue
        rm -f "$_lt" 2>/dev/null && _fixed=$((_fixed + 1))
    done

    # 1) sonu newline ile bitmeyen, 0 baytlı veya \0 dolgulu .list / kontrol dosyaları.
    #    NOT: `[ -n "$(tail -c 1)" ]` \0 baytını kabukta yuttuğu için `\0` biten dosyaları
    #    kaçırıyordu; `tr '\000\n' 'ZN'` ile son baytın tam olarak `\n` (`N`) olduğu sınanır.
    #    MioBootstrap Java tarafında zaten temizleyip `.mio-lists-nul-cleaned` yazar; yalnızca
    #    işaret yoksa, info/ dizini işaretten yeniyse ya da zorlanırsa (apt-fix) tara.
    _nul_pass=0
    [ -f "$_db/.mio-lists-nul-cleaned" ] || _nul_pass=1
    _scan_lists=0
    if [ "$_nul_pass" -eq 1 ] || [ "${MIO_FORCE_DB_REPAIR:-0}" = "1" ] || \
       [ "$_db/info" -nt "$_db/.mio-lists-nul-cleaned" ]; then
        _scan_lists=1
    fi
    if [ "$_scan_lists" -eq 1 ]; then
        for _l in "$_db/info"/*.list "$_db/info"/*.md5sums "$_db/info"/*.conffiles "$_db/info"/*.triggers; do
            [ -f "$_l" ] || continue
            _is_list=0
            case "$_l" in *.list) _is_list=1 ;; esac
            if [ "$_is_list" -eq 0 ] && [ ! -s "$_l" ]; then
                continue
            fi
            _last=$(tail -c 1 "$_l" 2>/dev/null | tr '\000\n' 'ZN')
            if [ "$_last" != "N" ] || [ "$_nul_pass" -eq 1 ]; then
                _ltmp="$_l.mio-tmp.$$"
                tr -d '\000' < "$_l" > "$_ltmp" 2>/dev/null || { rm -f "$_ltmp" 2>/dev/null; continue; }
                if [ ! -s "$_ltmp" ]; then
                    if [ "$_is_list" -eq 1 ]; then
                        printf '/.\n' > "$_ltmp" 2>/dev/null
                    else
                        rm -f "$_ltmp" 2>/dev/null
                        continue
                    fi
                else
                    _last2=$(tail -c 1 "$_ltmp" 2>/dev/null | tr '\000\n' 'ZN')
                    [ "$_last2" = "N" ] || printf '\n' >> "$_ltmp" 2>/dev/null
                fi
                if ! cmp -s "$_l" "$_ltmp" 2>/dev/null; then
                    mv "$_ltmp" "$_l" 2>/dev/null && chmod 644 "$_l" 2>/dev/null && _fixed=$((_fixed + 1))
                else
                    rm -f "$_ltmp" 2>/dev/null
                fi
            fi
        done
        : > "$_db/.mio-lists-nul-cleaned" 2>/dev/null
    fi

    # 2) status içinde "install ok installed" görünen ama `info/<paket>.list` dosyası olmayan
    #    paketleri "half-installed" yap. Dosyanın TAMAMINI yeniden yazmak riskli (alan sırası
    #    bozulur), bu yüzden yalnız ilgili `Status:` satırı değiştirilir.
    if [ -f "$_db/status" ]; then
        _missing=""
        _cur=""
        while IFS= read -r _line; do
            case "$_line" in
                "Package: "*)
                    _cur=${_line#Package: }
                    ;;
                "Status: install ok installed")
                    if [ -n "$_cur" ] && [ ! -f "$_db/info/$_cur.list" ]; then
                        _missing="$_missing $_cur"
                    fi
                    ;;
            esac
        done < "$_db/status"
        for _p in $_missing; do
            _tmp="$_db/status.mio-tmp"
            awk -v pkg="$_p" '
                /^Package: / { cur = substr($0, 10) }
                /^Status: install ok installed$/ && cur == pkg {
                    print "Status: install ok half-installed"
                    next
                }
                { print }
            ' "$_db/status" > "$_tmp" 2>/dev/null
            if [ -s "$_tmp" ]; then
                mv "$_tmp" "$_db/status" 2>/dev/null && _fixed=$((_fixed + 1))
            else
                rm -f "$_tmp" 2>/dev/null
            fi
        done
    fi

    # 3) yarıda kalmış kurulum artıkları
    rm -f "$_db/updates/"* 2>/dev/null
    for _l in "$_db/info"/*.dpkg-new "$_db/info"/*.dpkg-tmp; do
        [ -e "$_l" ] || continue
        rm -f "$_l" 2>/dev/null && _fixed=$((_fixed + 1))
    done

    rm -rf "$_lock" 2>/dev/null
    [ "$_fixed" -gt 0 ] && printf 'mio: dpkg veritabanı onarıldı (%s düzeltme)\n' "$_fixed" >&2
    return 0
}

# dpkg sarmalayıcısı: dpkg'ye verilen her .deb dosyasını `mio_convert_deb` ile çevirir ve
# ``yolları düzelterek gerçek dpkg'yi çağırır.
install_dpkg_wrapper() {
    [ -d "$PREFIX/bin" ] || return 0
    real="$PREFIX/bin/dpkg.mio-real"
    wrapper="$PREFIX/bin/dpkg"
    prot_dir="$PREFIX/libexec/mio"
    prot="$prot_dir/dpkg"
    [ -f "$wrapper" ] || [ -f "$real" ] || return 0

    # Sarmalayıcı hem $PREFIX/bin/dpkg hem korumalı $PREFIX/libexec/mio/dpkg olarak güncelse dokunma
    if grep -q "MIO_DPKG_WRAPPER_VERSION=17" "$wrapper" 2>/dev/null && \
       grep -q "MIO_DPKG_WRAPPER_VERSION=17" "$prot" 2>/dev/null; then
        return 0
    fi

    if [ -f "$wrapper" ] && ! grep -q "MIO_DPKG_WRAPPER_VERSION" "$wrapper" 2>/dev/null; then
        cp "$wrapper" "$real" 2>/dev/null || return 1
        chmod 755 "$real" 2>/dev/null
    elif [ ! -f "$real" ]; then
        printf 'mio: %s yok, sarmalayıcı kurulmadı\n' "$real" >&2
        return 1
    fi
    [ -x "$real" ] || return 1

    cat > "$wrapper" <<'MIO_EOF'
#!@@PREFIX@@/bin/sh
# mio dpkg sarmalayıcısı: com.termux yollu .deb dosyalarını com.mio için yeniden paketler.
# Dönüştürme mantığı bu dosyada kopya tutulmaz; `mio` betiğine devredilir (tek kaynak).
MIO_DPKG_WRAPPER_VERSION=17
prefix=@@PREFIX@@
bin="$prefix/bin"
real="$bin/dpkg.mio-real"
mio="$bin/mio"
failed=0

# dpkg yardımcı programlarını (ldconfig, start-stop-daemon, sh, tar, dpkg-deb) korumalı dizin +
# önekte arar; eksikse "N expected programs not found in PATH" deyip unpack etmeden durur.
case ":$PATH:" in
    *":$bin:"*) : ;;
    *) PATH="$bin:$PATH" ; export PATH ;;
esac
case ":$PATH:" in
    *":$prefix/libexec/mio:"*) : ;;
    *) PATH="$prefix/libexec/mio:$PATH" ; export PATH ;;
esac

if [ ! -x "$real" ]; then
    # Yedek yoksa (çok eski kurulum) bu dosyanın kendisi gerçek dpkg'dir: dönüştür, sonra dpkg'ye
    # bırak. Sonsuz döngüye girmemek için exec yerine burada bitirilir.
    printf 'mio: gerçek dpkg bulunamadı: %s\n' "$real" >&2
    exit 1
fi

_did_conv=0
_has_rec=0
for a in "$@"; do
    case "$a" in
        -R|--recursive) _has_rec=1 ;;
        *.deb)
            [ -f "$a" ] || continue
            _did_conv=1
            if [ ! -r "$a" ]; then
                printf 'mio: paket okunamıyor: %s\n' "$a" >&2
                failed=1
                continue
            fi
            if [ -x "$mio" ]; then
                if ! "$mio" deb-cevir "$a"; then
                    printf 'mio: paket com.mio yollarına çevrilemedi, dpkg durduruldu: %s\n' "$a" >&2
                    printf 'mio: ayrıntı için: mio deb-cevir "%s"\n' "$a" >&2
                    failed=1
                fi
            else
                printf 'mio: %s yok, paket çevrilemedi: %s\n' "$mio" "$a" >&2
                failed=1
            fi
            ;;
    esac
done

if [ "$failed" -ne 0 ]; then
    exit 1
fi

# Sürüm 15: Yalnız paket değiştiren çağrılarda (--unpack, -i, --configure, -r, -P)
# sarmalayıcı/izin/db onarımı yap; --print-architecture / --assert-* sorgularında bekleme.
_need_prep=0
for a in "$@"; do
    case "$a" in
        *.deb|-i|--install|--unpack|--configure|-r|--remove|-P|--purge|--triggers-only)
            _need_prep=1
            break
            ;;
    esac
done

if [ "$_need_prep" -eq 1 ]; then
    if [ -x "$mio" ]; then
        MIO_WRAPPER_QUIET=1 "$mio" sarmalayici >/dev/null 2>&1 || :
    fi
    for _base in "$prefix/share" "$prefix/bin" "$prefix/lib" "$prefix/etc"; do
        [ -d "$_base" ] || continue
        find "$_base" -type d ! -perm -u+w -exec chmod u+rwx {} + 2>/dev/null || :
    done
fi

export MIO_DPKG_RUNNING=1
if [ "$_did_conv" -eq 1 ] && [ "$_has_rec" -eq 0 ]; then
    export MIO_DEB_PRECONVERTED=1
fi
exec "$real" "$@"
MIO_EOF
    sed -e "s|@@PREFIX@@|$PREFIX|g" "$wrapper" > "$wrapper.tmp" 2>/dev/null && mv "$wrapper.tmp" "$wrapper"
    chmod 755 "$wrapper" 2>/dev/null
    mkdir -p "$prot_dir" 2>/dev/null
    cp "$wrapper" "$prot" 2>/dev/null && chmod 755 "$prot" 2>/dev/null
    printf 'mio: dpkg sarmalayıcısı kuruldu\n'
}

# dpkg-deb sarmalayıcısı: dpkg her paketi açarken `dpkg-deb --control`/`--fsys-tarfile`
# çağırır. Bu sarmalayıcı, verilen .deb hâlâ com.termux yolluysa ÖNCE `mio deb-cevir` ile
# çevirir. Böylece `pkg install`, `apt install` ya da doğrudan `dpkg -i` fark etmeksizin
# dönüşüm devreye girer (cihazda `pkg` sarmalayıcısı atlanıp dpkg orijinal paketi alıyordu).
#
#   - `-b/--build` çağrıları dokunulmadan geçer (mio_pack_deb kendi paketini üretir)
#   - `-R/-x` (açma) çağrılarında da çevirir; çıktı yolları com.mio olur
install_dpkg_deb_wrapper() {
    [ -d "$PREFIX/bin" ] || return 0
    real="$PREFIX/bin/dpkg-deb.mio-real"
    wrapper="$PREFIX/bin/dpkg-deb"
    prot_dir="$PREFIX/libexec/mio"
    prot="$prot_dir/dpkg-deb"
    [ -f "$wrapper" ] || [ -f "$real" ] || return 0

    if grep -q "MIO_DPKG_DEB_WRAPPER_VERSION=4" "$wrapper" 2>/dev/null && \
       grep -q "MIO_DPKG_DEB_WRAPPER_VERSION=4" "$prot" 2>/dev/null; then
        return 0
    fi

    if [ -f "$wrapper" ] && ! grep -q "MIO_DPKG_DEB_WRAPPER_VERSION" "$wrapper" 2>/dev/null; then
        cp "$wrapper" "$real" 2>/dev/null || return 1
        chmod 755 "$real" 2>/dev/null
    elif [ ! -f "$real" ]; then
        return 1
    fi
    [ -x "$real" ] || return 1

    cat > "$wrapper" <<'MIO_EOF'
#!@@PREFIX@@/bin/sh
# mio dpkg-deb sarmalayıcısı: .deb içindeki com.termux yollarını com.mio yapar.
MIO_DPKG_DEB_WRAPPER_VERSION=4
prefix=@@PREFIX@@
bin="$prefix/bin"
real="$bin/dpkg-deb.mio-real"
mio="$bin/mio"

# Dönüşüm sırasında mio kendisi dpkg-deb çağırır; veya dpkg sarmalayıcısı tüm .deb dosyalarını
# zaten çevirmişse tekrar kontrol edip zaman kaybetme.
if [ -n "${MIO_DEB_CONVERTING:-}" ] || [ "${MIO_DEB_PRECONVERTED:-0}" = "1" ]; then
    exec "$real" "$@"
fi

# Paket ÜRETME çağrıları dokunulmadan geçer
build=0
for a in "$@"; do
    case "$a" in
        -b|--build|--build=*|-S|--show|-I|--info|-f|--field|-W|--showformat*|-c|--contents|-s|--showformat)
            case "$a" in
                -b|--build|--build=*) build=1 ;;
            esac
            ;;
    esac
done

if [ "$build" -eq 1 ] || [ ! -x "$real" ]; then
    exec "$real" "$@"
fi

# .deb argümanlarını (ve açma hedeflerini) çevir
case ":$PATH:" in
    *":$bin:"*) : ;;
    *) PATH="$bin:$PATH" ; export PATH ;;
esac

for a in "$@"; do
    case "$a" in
        *.deb)
            [ -f "$a" ] || continue
            if [ -x "$mio" ]; then
                MIO_DEB_CONVERTING=1 "$mio" deb-cevir "$a" >/dev/null 2>&1 || :
            fi
            ;;
    esac
done

exec "$real" "$@"
MIO_EOF
    sed -e "s|@@PREFIX@@|$PREFIX|g" "$wrapper" > "$wrapper.tmp" 2>/dev/null && mv "$wrapper.tmp" "$wrapper"
    chmod 755 "$wrapper" 2>/dev/null
    mkdir -p "$prot_dir" 2>/dev/null
    cp "$wrapper" "$prot" 2>/dev/null && chmod 755 "$prot" 2>/dev/null
    return 0
}

install_apt_wrappers() {
    mio_repair_dpkg_db
    mio_fix_prefix_perms
    install_apt_wrapper pkg
    install_apt_wrapper apt
    install_apt_wrapper apt-get
    install_dpkg_wrapper
    install_dpkg_deb_wrapper
    return 0
}

install_pkg_wrapper() {
    install_apt_wrappers
}

fix_sources() {
    apt_dir="$PREFIX/etc/apt"
    sources="$apt_dir/sources.list"
    [ -d "$apt_dir" ] || return 0

    # Ne olduğu önemli değil: dosya değilse (klasör, symlink, fifo...) ya da okunamıyorsa yeniden yaz
    broken=0
    if [ -L "$sources" ]; then
        broken=1
    elif [ -e "$sources" ] && [ ! -f "$sources" ]; then
        broken=1
    elif [ -f "$sources" ] && [ ! -r "$sources" ]; then
        broken=1
    elif [ -f "$sources" ] && [ ! -s "$sources" ]; then
        broken=1
    elif [ ! -e "$sources" ]; then
        broken=1
    fi

    # Geçersiz satır (ör. "deb Termux stable main") apt'yi tamamen kilitler:
    # "Malformed entry ... (URI parse)" -> "The list of sources could not be read."
    # Adresi http(s) ile başlamayan tüm deb satırları atılır.
    if [ "$broken" -eq 0 ] && [ -f "$sources" ]; then
        bad=0
        while IFS= read -r line; do
            case "$line" in
                deb[[:space:]]*)
                    # "deb https://... stable main" -> adres 2. alan
                    addr=$(printf '%s\n' "$line" | awk '{print $2}')
                    case "$addr" in
                        http://*|https://*) : ;;
                        *) bad=$((bad + 1)) ;;
                    esac
                    ;;
            esac
        done < "$sources"
        if [ "$bad" -gt 0 ]; then
            printf 'mio: sources.list içinde %s geçersiz satır bulundu\n' "$bad"
            broken=1
        fi
    fi

    if [ "$broken" -eq 1 ]; then
        printf 'mio: bozuk sources.list onarılıyor...\n'
        found=""
        if [ -d "$sources" ]; then
            for candidate in "$sources"/*; do
                [ -f "$candidate" ] || continue
                case "$candidate" in
                    *sources.list*) found="$candidate"; break ;;
                esac
            done
        fi
        tmp="$apt_dir/sources.list.mio-tmp"
        rm -f "$tmp" 2>/dev/null
        if [ -n "$found" ]; then
            cp "$found" "$tmp" 2>/dev/null
        fi
        if [ ! -s "$tmp" ]; then
            printf 'deb https://packages-cf.termux.dev/apt/termux-main stable main\n' > "$tmp"
        fi
        rm -rf "$sources" 2>/dev/null
        mv "$tmp" "$sources" 2>/dev/null
        chmod 644 "$sources" 2>/dev/null
        printf 'mio: sources.list dosyası yeniden oluşturuldu:\n'
        sed 's/^/  /' "$sources" 2>/dev/null
    fi

    # sources.list.d içinde dosya olmayan girdiler apt'yi bozar
    if [ -d "$apt_dir/sources.list.d" ]; then
        for entry in "$apt_dir/sources.list.d"/*; do
            [ -e "$entry" ] || continue
            if [ -L "$entry" ] || { [ -d "$entry" ]; }; then
                printf 'mio: bozuk depo girdisi siliniyor: %s\n' "$entry"
                rm -rf "$entry" 2>/dev/null
            fi
        done
    fi

    install_apt_wrappers
    install_change_repo_replacement
    if [ "${MIO_NO_APT_CONFIG:-0}" != "1" ]; then
        MIO_NO_APT_CONFIG=1 ensure_apt_config
    fi
    return 0
}

# ---------------------------------------------------------------------------------------------
# mio apt / mio pkg / mio install
#
#   mio apt <komut...>     -> sarmalayıcılar üzerinden apt çalıştırır (argümansız: durum raporu)
#   mio pkg <komut...>     -> sarmalayıcılar üzerinden Termux pkg çalıştırır
#   mio install <paket...> -> hem apt hem pkg depolarında arar; ikisinde de varsa sorar:
#                             1) apt   2) pkg
# ---------------------------------------------------------------------------------------------
mio_apt_has_lists() {
    for _lf in "$PREFIX"/var/lib/apt/lists/*Packages*; do
        [ -s "$_lf" ] && return 0
    done
    return 1
}

mio_ensure_apt_lists() {
    mio_apt_has_lists && return 0
    printf 'mio: paket listeleri boş, depolar güncelleniyor...\n'
    if [ -x "$PREFIX/bin/apt" ]; then
        "$PREFIX/bin/apt" update </dev/null
        return $?
    elif [ -x "$PREFIX/bin/apt-get" ]; then
        "$PREFIX/bin/apt-get" update </dev/null
        return $?
    elif [ -x "$PREFIX/bin/pkg" ]; then
        "$PREFIX/bin/pkg" update </dev/null
        return $?
    fi
    return 1
}

mio_run_apt() {
    fix_sources >/dev/null 2>&1
    _apt_bin=""
    if [ -x "$PREFIX/bin/apt" ]; then
        _apt_bin="$PREFIX/bin/apt"
    elif [ -x "$PREFIX/bin/apt-get" ]; then
        _apt_bin="$PREFIX/bin/apt-get"
    else
        printf 'mio: apt bulunamadı (%s/bin/apt)\n' "$PREFIX" >&2
        return 1
    fi
    case "${1:-}" in
        install|show|search|policy|upgrade|full-upgrade|dist-upgrade)
            mio_ensure_apt_lists || :
            ;;
    esac
    "$_apt_bin" "$@"
}

mio_run_pkg() {
    fix_sources >/dev/null 2>&1
    if [ ! -x "$PREFIX/bin/pkg" ]; then
        printf 'mio: pkg bulunamadı (%s/bin/pkg)\n' "$PREFIX" >&2
        return 1
    fi
    "$PREFIX/bin/pkg" "$@"
}

mio_apt_has_pkg() {
    _p="$1"
    [ -n "$_p" ] || return 1
    if [ -x "$PREFIX/bin/apt-cache" ]; then
        if env -u LD_PRELOAD APT_CONFIG="$PREFIX/etc/apt/apt.conf.d/mio-apt.conf" \
            "$PREFIX/bin/apt-cache" show "$_p" </dev/null 2>/dev/null | grep -q '^Package: '; then
            return 0
        fi
    fi
    if [ -x "$PREFIX/bin/apt" ]; then
        if "$PREFIX/bin/apt" show "$_p" </dev/null 2>/dev/null | grep -q '^Package: '; then
            return 0
        fi
    fi
    return 1
}

mio_pkg_has_pkg() {
    _p="$1"
    [ -n "$_p" ] || return 1
    if [ -x "$PREFIX/bin/pkg" ]; then
        if TERMUX_PKG_NO_MIRROR_SELECT=1 APT_CONFIG="$PREFIX/etc/apt/apt.conf.d/mio-apt.conf" \
            "$PREFIX/bin/pkg" show "$_p" </dev/null 2>/dev/null | grep -q '^Package: '; then
            return 0
        fi
    fi
    return 1
}

# Kurulacak paket(ler)in özyineli bağımlılıklarından (örn. curl -> libcurl -> libngtcp2,
# libnghttp3, openssl) bootstrap'ta eski sürümde kalmış olanları bulur; böylece
# `pkg install curl` sonrası "cannot locate symbol" hatası yaşanmaz.
mio_resolve_install_deps() {
    [ $# -gt 0 ] || return 0
    _ag=""
    if [ -x "$PREFIX/bin/apt-get.mio-real" ]; then
        _ag="$PREFIX/bin/apt-get.mio-real"
    elif [ -x "$PREFIX/bin/apt-get" ]; then
        _ag="$PREFIX/bin/apt-get"
    else
        return 0
    fi
    _ac=""
    [ -x "$PREFIX/bin/apt-cache" ] && _ac="$PREFIX/bin/apt-cache"
    [ -n "$_ac" ] || return 0

    _conf="$PREFIX/etc/apt/apt.conf.d/mio-apt.conf"
    [ -f "$_conf" ] || return 0

    _upg=$(env -u LD_PRELOAD APT_CONFIG="$_conf" "$_ag" -s -o Debug::NoLocking=1 upgrade </dev/null 2>/dev/null | awk '/^Inst / { print $2 }' | tr '\n' ' ')
    [ -n "$_upg" ] || return 0

    _deps=$(env -u LD_PRELOAD APT_CONFIG="$_conf" "$_ac" depends --recurse \
        --no-recommends --no-suggests --no-conflicts --no-breaks --no-replaces --no-enhances \
        "$@" </dev/null 2>/dev/null | awk '
        /^[[:space:]]+/ {
            line = $0
            sub(/^[[:space:]]*\|?(Pre)?Depends:[[:space:]]*/, "", line)
            gsub(/[<>]/, "", line)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
            if (line != "" && line !~ /[[:space:]]/) print line
        }
    ' | sort -u)
    [ -n "$_deps" ] || return 0

    _req=" $* "
    _out=""
    for _d in $_deps; do
        case "$_req" in *" $_d "*) continue ;; esac
        case " $_upg " in
            *" $_d "*) _out="$_out${_out:+ }$_d" ;;
        esac
    done
    printf '%s\n' "$_out"
}

mio_deps_upgrade() {
    fix_sources >/dev/null 2>&1
    mio_ensure_apt_lists || return 1
    if [ -x "$PREFIX/bin/apt-get" ]; then
        MIO_NO_DEP_UPGRADE=1 "$PREFIX/bin/apt-get" upgrade -y
        return $?
    elif [ -x "$PREFIX/bin/apt" ]; then
        MIO_NO_DEP_UPGRADE=1 "$PREFIX/bin/apt" upgrade -y
        return $?
    elif [ -x "$PREFIX/bin/pkg" ]; then
        "$PREFIX/bin/pkg" upgrade -y
        return $?
    fi
    return 1
}

mio_install_cmd() {
    if [ $# -eq 0 ]; then
        printf 'Kullanım: mio install <paket> [-y] [--apt|--pkg]\n' >&2
        return 2
    fi

    _force_mgr=""
    _pass_flags=""
    _pkg_names=""
    _pkg_count=0
    for _arg in "$@"; do
        case "$_arg" in
            --apt) _force_mgr="apt" ;;
            --pkg) _force_mgr="pkg" ;;
            -h|--help)
                printf 'Kullanım: mio install <paket> [-y] [--apt|--pkg]\n'
                printf "Paketi hem apt hem pkg depolarında arar; ikisinde de varsa hangisinden indirileceğini sorar.\n"
                return 0
                ;;
            -*)
                _pass_flags="$_pass_flags${_pass_flags:+ }$_arg"
                ;;
            *)
                _pkg_names="$_pkg_names${_pkg_names:+ }$_arg"
                _pkg_count=$((_pkg_count + 1))
                ;;
        esac
    done

    if [ "$_pkg_count" -eq 0 ]; then
        printf 'mio: paket adı belirtilmedi. Kullanım: mio install <paket>\n' >&2
        return 2
    fi

    fix_sources >/dev/null 2>&1

    _did_update=0
    if ! mio_apt_has_lists; then
        mio_ensure_apt_lists && _did_update=1
    fi

    _in_apt=1
    _in_pkg=1
    [ -x "$PREFIX/bin/apt" ] || [ -x "$PREFIX/bin/apt-get" ] || _in_apt=0
    [ -x "$PREFIX/bin/pkg" ] || _in_pkg=0

    for _p in $_pkg_names; do
        [ "$_in_apt" -eq 1 ] && ! mio_apt_has_pkg "$_p" && _in_apt=0
        [ "$_in_pkg" -eq 1 ] && ! mio_pkg_has_pkg "$_p" && _in_pkg=0
    done

    if [ "$_in_apt" -eq 0 ] && [ "$_in_pkg" -eq 0 ] && [ "$_did_update" -eq 0 ]; then
        printf 'mio: paket listesi güncellenip tekrar aranıyor...\n'
        if [ -x "$PREFIX/bin/apt" ]; then
            "$PREFIX/bin/apt" update </dev/null >/dev/null 2>&1 || :
        elif [ -x "$PREFIX/bin/pkg" ]; then
            "$PREFIX/bin/pkg" update </dev/null >/dev/null 2>&1 || :
        fi
        _in_apt=1
        _in_pkg=1
        [ -x "$PREFIX/bin/apt" ] || [ -x "$PREFIX/bin/apt-get" ] || _in_apt=0
        [ -x "$PREFIX/bin/pkg" ] || _in_pkg=0
        for _p in $_pkg_names; do
            [ "$_in_apt" -eq 1 ] && ! mio_apt_has_pkg "$_p" && _in_apt=0
            [ "$_in_pkg" -eq 1 ] && ! mio_pkg_has_pkg "$_p" && _in_pkg=0
        done
    fi

    # Ne apt ne pkg depolarında yoksa yerel mio paketlerini (~/.mio/pkgs) kontrol et
    if [ "$_in_apt" -eq 0 ] && [ "$_in_pkg" -eq 0 ]; then
        if [ "$_pkg_count" -eq 1 ] && pkg_find "$_pkg_names" >/dev/null 2>&1; then
            printf "mio: '%s' yerel mio paketlerinde bulundu, kuruluyor...\n" "$_pkg_names"
            pkg_install "$_pkg_names"
            return $?
        fi
        printf "mio: '%s' paketi ne apt'de ne pkg'de bulundu.\n" "$_pkg_names" >&2
        return 1
    fi

    _chosen=""
    if [ "$_force_mgr" = "apt" ] && [ "$_in_apt" -eq 1 ]; then
        _chosen="apt"
    elif [ "$_force_mgr" = "pkg" ] && [ "$_in_pkg" -eq 1 ]; then
        _chosen="pkg"
    elif [ "$_in_apt" -eq 1 ] && [ "$_in_pkg" -eq 1 ]; then
        printf "'%s' hem apt hem pkg'de bulundu.\n" "$_pkg_names"
        printf 'Hangisinden indirilsin?\n'
        printf '  1) apt\n'
        printf '  2) pkg\n'
        printf 'Seçim [1]: '
        read -r _choice || _choice=""
        case "$_choice" in
            ""|1|apt|APT) _chosen="apt" ;;
            2|pkg|PKG)    _chosen="pkg" ;;
            *)
                printf 'mio: geçersiz seçim: %s (1: apt, 2: pkg)\n' "$_choice" >&2
                return 2
                ;;
        esac
    elif [ "$_in_apt" -eq 1 ]; then
        printf "mio: '%s' apt deposunda bulundu, apt ile kuruluyor...\n" "$_pkg_names"
        _chosen="apt"
    else
        printf "mio: '%s' pkg deposunda bulundu, pkg ile kuruluyor...\n" "$_pkg_names"
        _chosen="pkg"
    fi

    if [ "$_chosen" = "apt" ]; then
        # shellcheck disable=SC2086
        mio_run_apt install $_pass_flags $_pkg_names
        return $?
    else
        # shellcheck disable=SC2086
        mio_run_pkg install $_pass_flags $_pkg_names
        return $?
    fi
}

run_am() {
    # Önce sistem `am`: termux-am ikilisi `com.termux` paket kimliğiyle derlendiği için yayınları
    # `com.termux` adına yapar ve bu uygulamaya (com.mio) ulaştıramaz.
    if [ -x /system/bin/am ]; then
        /system/bin/am "$@" >/dev/null 2>&1 && return 0
    fi
    if [ -x "$PREFIX/bin/termux-am" ]; then
        "$PREFIX/bin/termux-am" "$@" 2>/dev/null && return 0
    fi
    if command -v termux-am >/dev/null 2>&1; then
        termux-am "$@" 2>/dev/null && return 0
    fi
    return 1
}

send_command() {
    # `am` prints "Broadcast completed" when the broadcast really reached the app
    out=$(run_am broadcast "$@" 2>&1)
    case "$out" in
        *"Broadcast completed"*) return 0 ;;
    esac
    if [ -n "$out" ] && ! printf '%s' "$out" | grep -qi "security\|denied\|exception"; then
        return 0
    fi
    if run_am startservice -n com.mio/com.termux.app.TermuxService "$@" >/dev/null 2>&1; then
        return 0
    fi
    # Son çare: niyeti doğrudan etkinliğe gönder (bazı Android sürümleri am broadcast/startservice'i
    # kısıtlar, ama etkinlik başlatma izinli olduğu için komut yine de iletilir)
    run_am start -n com.mio/com.termux.app.TermuxActivity "$@" >/dev/null 2>&1
}

write_request() {
    mkdir -p "$REQUEST_DIR" 2>/dev/null
    {
        printf 'created=%s\n' "$(date +%s 2>/dev/null || echo 0)"
        printf '%s\n' "$@"
    } > "$REQUEST_FILE" 2>/dev/null
}

# Komutu çalıştır: $1 eylem, kalanı --es anahtar değer çiftleri
# Önce yayın denenir; olmazsa istek dosyası yazılır ve uygulama servisi dosyayı görüp komutu
# kendisi çalıştırır (am bazı cihazlarda kabuk kullanıcısına kapalı olabiliyor).
send() {
    action="$1"
    shift

    # --es mode up --es size 20 ... -> "mode up size 20" (uygulama istek dosyasından okur)
    args=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --es|--ei|--ez|--el)
                if [ $# -ge 3 ]; then
                    args="$args${args:+ }$2 $3"
                    shift 3
                else
                    shift
                fi
                ;;
            *) shift ;;
        esac
    done

    if [ -n "$args" ]; then
        write_request "command=mio" "action=$action" "args=$args"
    else
        write_request "command=mio" "action=$action"
    fi

    if send_command -a "$action" "$@"; then
        return 0
    fi

    # `am` çıktısı güvenilir değil: başarılı olsa bile bazen "Broadcast completed" yazmıyor.
    # Uygulama isteği aldığında dosyayı siliyor, o yüzden dosyanın YOK olması komutun ulaştığı anlamına
    # gelir (eskiden bu durum yanlışlıkla "iletilemedi" diye raporlanıyordu).
    if [ ! -f "$REQUEST_FILE" ]; then
        return 0
    fi

    # Dosya hâlâ duruyor: yayın engellenmiş olabilir, ama uygulama açıkken 600 ms'de bir yokluyor.
    sleep 1 2>/dev/null || sleep 1
    if [ ! -f "$REQUEST_FILE" ]; then
        return 0
    fi
    printf 'mio: komut uygulamaya iletilemedi (yayın engellendi), istek dosyasına yazıldı: %s\n' "$REQUEST_FILE"
    printf 'mio: uygulama açıkken bu dosya 600 ms içinde okunur; menü açılmazsa uygulamayı bir kez aç.\n'
    return 0
}

