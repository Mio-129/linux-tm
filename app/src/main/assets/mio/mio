write_sources() {
    url="$1"
    # Geçersiz adres sources.list'e yazılırsa apt "Malformed entry ... (URI parse)" der ve
    # hiçbir komut çalışmaz; bu yüzden burada reddedilir.
    case "$url" in
        http://*|https://*) : ;;
        *) printf 'mio: geçersiz depo adresi reddedildi: %s\n' "$url" >&2; return 1 ;;
    esac
    apt_dir="$PREFIX/etc/apt"
    mkdir -p "$apt_dir" 2>/dev/null
    tmp="$apt_dir/.sources.list.mio-new"
    printf '# %s tarafından yazıldı\ndeb %s stable main\n' "mio" "$url" > "$tmp" 2>/dev/null || return 1
    rm -rf "$MIRROR_FILE" 2>/dev/null
    mv "$tmp" "$MIRROR_FILE" 2>/dev/null || return 1
    chmod 644 "$MIRROR_FILE" 2>/dev/null
    # Gerçekten dosya olduğunu doğrula (bozuk kurulumda şart)
    [ -f "$MIRROR_FILE" ] && [ ! -L "$MIRROR_FILE" ] || {
        fix_sources
        [ -f "$MIRROR_FILE" ] || return 1
    }
    # seçimi kalıcı olarak sakla, böylece her açılışta aynı depo kullanılır
    printf '%s\n' "$url" > "$apt_dir/.mio-mirror" 2>/dev/null

    # aynı depoyu ikinci kez yazan dosyaları kaldır (çift kayıt uyarısı çıkmasın)
    parts_dir="$apt_dir/sources.list.d"
    mkdir -p "$parts_dir" 2>/dev/null
    rm -f "$parts_dir/mio.list" "$parts_dir/main.list" 2>/dev/null
    # zz-mio-sources.conf yolları sabitler; yoksa oluştur
    conf_file="$apt_dir/apt.conf.d/zz-mio-sources.conf"
    if [ ! -s "$conf_file" ]; then
        mkdir -p "$apt_dir/apt.conf.d" 2>/dev/null
        {
            printf '# mio: pin the apt source locations\n'
            printf 'Dir::Etc::sourcelist "%s";\n' "$MIRROR_FILE"
            printf 'Dir::Etc::sourceparts "%s";\n' "$parts_dir"
        } > "$conf_file.tmp" 2>/dev/null
        [ -s "$conf_file.tmp" ] && mv "$conf_file.tmp" "$conf_file" 2>/dev/null
        chmod 644 "$conf_file" 2>/dev/null
    fi
    return 0
}

# Depoları kısa süreyle dener, en hızlı olanı yazar. Ağa çıkar ama her depo için
# en fazla 2 saniye bekler, bu yüzden saniyeler içinde biter.
MIRRORS_FAST="
Termux CF|https://packages-cf.termux.dev/apt/termux-main
Astra|https://termux.astra.in.ua/apt/termux-main
Grimler|https://grimler.se/termux/termux-main
FAU|https://ftp.fau.de/termux/termux-main
ICM|https://ftp.icm.edu.pl/pub/Linux/dist/termux/termux-main
Autkin|https://mirror.autkin.net/termux/termux-main
"

mirror_pick_fast() {
    if [ ! -x "$PREFIX/bin/curl" ]; then
        printf 'curl yok, hız testi atlandı\n'
        return 1
    fi
    printf 'Depolar deneniyor (en fazla 2 sn/depo):\n'
    best_url="" ; best_time=""
    # NOT: `for entry in $VAR` etiketlerdeki boşluk yüzünden kelimelere bölünüyordu ve
    # "Termux" gibi geçersiz bir adres sources.list'e yazılıyordu. Heredoc + while
    # kullanıldığında döngü alt kabukta çalışmaz, değişkenler korunur.
    while IFS='|' read -r label url; do
        [ -n "$label" ] || continue
        case "$url" in http*) : ;; *) continue ;; esac
        t=$("$PREFIX/bin/curl" -fsS -o /dev/null --max-time 2 -w '%{time_total}' \
                "$url/dists/stable/InRelease" 2>/dev/null)
        case "$t" in
            ''|*[!0-9.]*) printf '  %-12s erişilemedi\n' "$label" ; continue ;;
            *) printf '  %-12s %s sn\n' "$label" "$t" ;;
        esac
        if [ -z "$best_time" ] || [ "$(awk -v a="$t" -v b="$best_time" 'BEGIN{print (a<b)?1:0}')" = "1" ]; then
            best_time="$t" ; best_url="$url"
        fi
    done <<MIO_MIRRORS
$MIRRORS_FAST
MIO_MIRRORS
    if [ -n "$best_url" ] && write_sources "$best_url"; then
        printf 'En hızlı depo: %s (%s sn)\n' "$best_url" "$best_time"
        return 0
    fi
    printf 'Hız testi sonuçsuz, depo değiştirilmedi\n'
    return 1
}

mirror_choose() {
    if [ -n "${1:-}" ]; then
        case "$1" in
            cf|termux|varsayilan|default) write_sources "$MIRROR_MAIN_DEFAULT" && printf 'Depo: %s\n' "$MIRROR_MAIN_DEFAULT"; return $? ;;
            asya|asia) write_sources "https://mirror.termux.dev/termux/termux-main" && printf 'Depo: mirror.termux.dev\n'; return $? ;;
            ana|main|resmi) write_sources "https://packages.termux.dev/apt/termux-main" && printf 'Depo: packages.termux.dev\n'; return $? ;;
            grimler|fi|finlandiya) write_sources "https://grimler.se/termux/termux-main" && printf 'Depo: grimler.se\n'; return $? ;;
            fau|almanya) write_sources "https://ftp.fau.de/termux/termux-main" && printf 'Depo: ftp.fau.de\n'; return $? ;;
            icm|polonya) write_sources "https://ftp.icm.edu.pl/pub/Linux/dist/termux/termux-main" && printf 'Depo: ftp.icm.edu.pl\n'; return $? ;;
            autkin|avrupa) write_sources "https://mirror.autkin.net/termux/termux-main" && printf 'Depo: mirror.autkin.net\n'; return $? ;;
            bouwhuis|hollanda) write_sources "https://mirror.bouwhuis.network/termux/termux-main" && printf 'Depo: mirror.bouwhuis.network\n'; return $? ;;
            sjtu) write_sources "https://mirror.sjtu.edu.cn/termux/apt/termux-main" && printf 'Depo: SJTU\n'; return $? ;;
            tuna|tsinghua) write_sources "https://mirrors.tuna.tsinghua.edu.cn/termux/apt/termux-main" && printf 'Depo: Tsinghua\n'; return $? ;;
            ustc) write_sources "https://mirrors.ustc.edu.cn/termux/apt/termux-main" && printf 'Depo: USTC\n'; return $? ;;
            astra|ukrayna) write_sources "https://termux.astra.in.ua/apt/termux-main" && printf 'Depo: termux.astra.in.ua\n'; return $? ;;
            *) # URL verilmişse doğrudan kullan
               case "$1" in
                   http*) write_sources "$1" && printf 'Depo: %s\n' "$1"; return $? ;;
               esac
               printf 'Bilinmeyen depo: %s\n' "$1" >&2
               return 2 ;;
        esac
    fi

    printf 'Depo seçin:\n'
    printf '%s' "$MIRRORS" | while IFS='|' read -r label url; do
        [ -n "$label" ] || continue
        idx=$((idx+1))
        printf '  %s) %s\n' "$idx" "$label"
    done
    printf 'Seçim [1]: '
    read -r choice || choice=""
    [ -z "$choice" ] && choice=1

    n=0
    url=""
    printf '%s' "$MIRRORS" | while IFS='|' read -r label u; do
        [ -n "$label" ] || continue
        n=$((n+1))
        if [ "$n" = "$choice" ]; then printf '%s' "$u"; fi
    done > "$HOME/.mio/.mirror-choice" 2>/dev/null

    url=$(cat "$HOME/.mio/.mirror-choice" 2>/dev/null)
    rm -f "$HOME/.mio/.mirror-choice" 2>/dev/null
    [ -n "$url" ] || url="$MIRROR_MAIN_DEFAULT"

    if write_sources "$url"; then
        printf 'Depo: %s\n' "$url"
        printf 'Şimdi "pkg update" çalıştırabilirsin.\n'
        return 0
    fi
    printf 'Depo yazılamadı: %s\n' "$MIRROR_FILE" >&2
    return 1
}

install_apt_wrapper() {
    name="$1"
    real="$PREFIX/bin/$name.mio-real"
    wrapper="$PREFIX/bin/$name"
    [ -d "$PREFIX/bin" ] || return 0

    # Sarmalayıcı silinmiş ama gerçek araç duruyorsa sıfırdan kurulur (apt-fix sonrası kurtarma)
    if [ ! -f "$wrapper" ] && [ ! -f "$real" ]; then
        return 0
    fi
    if [ ! -f "$wrapper" ] && [ -f "$real" ]; then
        case "$name" in
            pkg|apt|apt-get) : ;;   # devam: aşağıda yeniden yazılır
            *) return 0 ;;
        esac
    fi

    # Zaten güncel sarmalayıcı varsa dokunma (sürüm damgası ile)
    if grep -q "MIO_WRAPPER_VERSION=23" "$wrapper" 2>/dev/null; then
        return 0
    fi

    # Gerçek aracı bir kez sakla (sarmalayıcı kendini çağırmasın)
    if [ ! -f "$real" ]; then
        if grep -q "MIO_WRAPPER_VERSION" "$wrapper" 2>/dev/null; then
            # Daha önce sarmalanmış ama gerçek araç kaybolmuş: kurtarılamaz
            printf 'mio: %s.mio-real yok, sarmalayıcı kurulmadı\n' "$name" >&2
            return 1
        fi
        cp "$wrapper" "$real" 2>/dev/null || return 1
        chmod 755 "$real" 2>/dev/null
    fi
    [ -x "$real" ] || return 1

    # Sarmalayıcı kendi konumundan çalışır (PREFIX'e ihtiyaç duymaz), onarımı kendi yapar
    cat > "$wrapper" <<'MIO_EOF'
#!@@PREFIX@@/bin/sh
# mio apt sarmalayıcısı: apt yollarını düzeltir, sonra gerçek aracı çalıştırır
MIO_WRAPPER_VERSION=23
NAME=@@NAME@@
bin=$(dirname "$0")
prefix=$(dirname "$bin")
apt_dir="$prefix/etc/apt"
sources="$apt_dir/sources.list"
parts="$apt_dir/sources.list.d"
conf_dir="$apt_dir/apt.conf.d"

mkdir -p "$apt_dir" "$parts" "$conf_dir" 2>/dev/null

# 1) sources.list normal, boş olmayan bir dosya olmalı
broken=0
if [ -L "$sources" ]; then
    broken=1
elif [ -e "$sources" ] && [ ! -f "$sources" ]; then
    broken=1
elif [ ! -e "$sources" ]; then
    broken=1
elif [ ! -s "$sources" ]; then
    broken=1
fi
if [ "$broken" -eq 1 ]; then
    tmp="$apt_dir/sources.list.mio-tmp"
    found=""
    if [ -d "$sources" ]; then
        for candidate in "$sources"/*; do
            [ -f "$candidate" ] || continue
            found="$candidate"
            break
        done
    fi
    rm -f "$tmp" 2>/dev/null
    if [ -n "$found" ]; then cp "$found" "$tmp" 2>/dev/null; fi
    [ -s "$tmp" ] || printf 'deb https://packages-cf.termux.dev/apt/termux-main stable main\n' > "$tmp"
    rm -rf "$sources" 2>/dev/null
    mv "$tmp" "$sources" 2>/dev/null
    chmod 644 "$sources" 2>/dev/null
    printf 'mio: bozuk sources.list onarıldı\n' >&2
fi

# 2) sourceparts gerçek bir klasör olmalı (klasör değilse apt "Is a directory" verir)
if [ -L "$parts" ] || { [ -e "$parts" ] && [ ! -d "$parts" ]; }; then
    rm -rf "$parts" 2>/dev/null
    mkdir -p "$parts" 2>/dev/null
    printf 'mio: sources.list.d onarıldı\n' >&2
fi

# 3) aynı depoyu tekrar eden dosyaları kaldır ("configured multiple times" uyarısı biter)
rm -f "$parts/mio.list" "$parts/main.list" 2>/dev/null

# 3b) geçersiz depo satırı (ör. "deb Termux stable main") apt'yi kilitler:
#     "Malformed entry ... (URI parse)" -> "The list of sources could not be read."
#     Böyle bir satır varsa depo dosyasını mio'nun onarıcısına devret.
if grep -q '^deb ' "$sources" 2>/dev/null; then
    if grep '^deb ' "$sources" 2>/dev/null | awk '{print $2}' | grep -qv '^https\?://'; then
        # doğrudan burada temizle (harici bir araca bağımlı kalmadan)
        tmp="$sources.mio-tmp"
        grep '^deb ' "$sources" 2>/dev/null | awk '$2 ~ /^https?:\/\// { print }' > "$tmp" 2>/dev/null
        if [ -s "$tmp" ]; then
            mv "$tmp" "$sources" 2>/dev/null
            chmod 644 "$sources" 2>/dev/null
        else
            rm -f "$tmp" 2>/dev/null
            printf '# mio tarafından yazıldı\ndeb https://packages-cf.termux.dev/apt/termux-main stable main\n' > "$sources" 2>/dev/null
            chmod 644 "$sources" 2>/dev/null
        fi
        printf 'mio: geçersiz depo satırı temizlendi\n' >&2
    fi
fi

# 4) yolları apt.conf.d içinde de sabitle (bazı apt çağrıları dosyayı okumadan geçebiliyor)
conf="$conf_dir/zz-mio-sources.conf"
{
    printf '# mio: pin the apt source locations\n'
    printf 'Dir::Etc::sourcelist "%s";\n' "$sources"
    printf 'Dir::Etc::sourceparts "%s";\n' "$parts"
} > "$conf" 2>/dev/null

# 5) apt'nin indirme yöntemleri (lib/apt/methods/http, https) çalıştırılabilir olmalı; aksi halde
#    apt "Failed to exec method ..." verir ve hiçbir depo okunamaz.
methods="$prefix/lib/apt/methods"
if [ -d "$methods" ]; then
    for m in "$methods"/*; do
        [ -e "$m" ] || continue
        if [ ! -x "$m" ]; then chmod 755 "$m" 2>/dev/null; fi
    done
    # kırık symlink (ör. https -> http hedefi yok) yerine gerçek kopya
    for m in "$methods"/*; do
        [ -L "$m" ] || continue
        [ -e "$m" ] && continue
        base=$(basename "$m")
        target=""
        case "$base" in
            https|tor+https) target="$methods/http" ;;
            tor+http) target="$methods/http" ;;
        esac
        if [ -n "$target" ] && [ -f "$target" ]; then
            rm -f "$m" 2>/dev/null
            cp "$target" "$m" 2>/dev/null
            chmod 755 "$m" 2>/dev/null
            printf 'mio: apt yöntemi onarıldı: %s\n' "$m" >&2
        fi
    done
fi

# 6) apt'nin çalışma klasörleri eksikse apt hiçbir şey okuyamaz:
#    "E: List directory .../usr/var/lib/apt is missing" (bu, "sources.list" hatasından sonraki adım)
for d in "$prefix/var/lib/apt/lists/partial" "$prefix/var/cache/apt/archives/partial" \
         "$prefix/var/lib/dpkg" "$prefix/var/log/apt" "$prefix/etc/apt/trusted.gpg.d" "$prefix/tmp"; do
    [ -d "$d" ] || mkdir -p "$d" 2>/dev/null
done
touch "$prefix/var/lib/dpkg/status" 2>/dev/null

# 7) Yolları APT_CONFIG ile dayat: bu dosya apt'nin kendisi tarafından okunur ve `pkg` gibi
#    sarmalayıcılar `-o` geçirmese de geçerli olur.
export APT_CONFIG="$conf_dir/mio-apt.conf"
{
    printf '# mio: apt yolları (APT_CONFIG)\n'
    printf 'Dir::Etc "%s/etc/apt";\n' "$prefix"
    printf 'Dir::Etc::sourcelist "%s";\n' "$sources"
    printf 'Dir::Etc::sourceparts "%s";\n' "$parts"
    printf 'Dir::Etc::trusted "%s/etc/apt/trusted.gpg";\n' "$prefix"
    printf 'Dir::Etc::trustedparts "%s/etc/apt/trusted.gpg.d";\n' "$prefix"
    printf 'Dir::State "%s/var/lib/apt";\n' "$prefix"
    printf 'Dir::State::lists "%s/var/lib/apt/lists";\n' "$prefix"
    printf 'Dir::State::status "%s/var/lib/dpkg/status";\n' "$prefix"
    printf 'Dir::Cache "%s/var/cache/apt";\n' "$prefix"
    printf 'Dir::Cache::archives "%s/var/cache/apt/archives";\n' "$prefix"
    printf 'Dir::Log "%s/var/log/apt";\n' "$prefix"
    printf 'Dir::Bin::methods "%s/lib/apt/methods";\n' "$prefix"
    printf 'Dir::State::extended_states "%s/var/lib/apt/extended_states";\n' "$prefix"
    printf 'DPkg::Path "%s/bin:/system/bin:/system/xbin";\n' "$prefix"
    printf 'Acquire::ForceIPv4 "true";\n'
    printf 'Acquire::Languages "none";\n'
} > "$APT_CONFIG" 2>/dev/null

# 8) Tüm apt kök yollarını dayat. Bu apt yapısında `Dir` öneğe ayarlı olmadığı için göreli
#    varsayılanlar kök dosya sistemine çözülüyor ("E: List directory .../var/lib/apt is missing"),
#    sourcelist/sourceparts da okunmadığı için "The list of sources could not be read" çıkıyor.
#    Önek yolu boşluk içermez, bu yüzden seçenekler tek bir değişkende toplanabilir.
#    NOT: `Dir` kökü bilerek ayarlanmaz; bu apt sürümünde `Dir` verilince mutlak bir
#    `Dir::Bin::methods` bile göreli hale geliyor ve yöntemler başlatılamıyor.
apt_opts="-o Dir::Etc=$prefix/etc/apt"
apt_opts="$apt_opts -o Dir::Etc::sourcelist=$sources -o Dir::Etc::sourceparts=$parts"
apt_opts="$apt_opts -o Dir::Etc::trusted=$prefix/etc/apt/trusted.gpg"
apt_opts="$apt_opts -o Dir::Etc::trustedparts=$prefix/etc/apt/trusted.gpg.d"
apt_opts="$apt_opts -o Dir::State=$prefix/var/lib/apt -o Dir::State::lists=$prefix/var/lib/apt/lists"
apt_opts="$apt_opts -o Dir::State::status=$prefix/var/lib/dpkg/status"
apt_opts="$apt_opts -o Dir::Cache=$prefix/var/cache/apt"
apt_opts="$apt_opts -o Dir::Cache::archives=$prefix/var/cache/apt/archives"
apt_opts="$apt_opts -o Dir::Log=$prefix/var/log/apt"
# apt, indirme yöntemlerini `Dir::Bin::methods` altında arar; bu değer mutlak değilse
# `Dir` köküyle birleşip var olmayan bir yola dönüşür ("Method ... did not start correctly")
apt_opts="$apt_opts -o Dir::Bin::methods=$prefix/lib/apt/methods"
apt_opts="$apt_opts -o Dir::State::extended_states=$prefix/var/lib/apt/extended_states"
apt_opts="$apt_opts -o Dir::Bin::dpkg=$prefix/bin/dpkg"
# dpkg, yardımcı programlarını (sh, rm, tar, diff, dpkg-deb) `DPkg::Path` içinde arar; apt bu değeri
# boş bulursa çocuk sürece kendi PATH'ini veriyor ve "N expected programs not found in PATH" çıkıyor.
apt_opts="$apt_opts -o DPkg::Path=$prefix/bin:/system/bin:/system/xbin"
# Hız: IPv4 zorla (IPv6 Türkiye'de sık sık takılıyor), çeviri dosyalarını indirme, 3 kez dene
apt_opts="$apt_opts -o Acquire::ForceIPv4=true -o Acquire::Languages=none"
apt_opts="$apt_opts -o Acquire::Retries=3 -o Acquire::http::Pipeline-Depth=0"
arch=$(dpkg --print-architecture 2>/dev/null)
[ -n "$arch" ] && apt_opts="$apt_opts -o APT::Architecture=$arch"

if [ "$NAME" = "pkg" ]; then
    # `pkg` kendi argüman ayrıştırıcısını kullanır, `-o` kabul etmez; ama `apt`/`apt-get`'i PATH'ten
    # çağırdığı için onlar bu sarmalayıcıdan geçer ve yollar orada dayatılır.
    export APT_CONFIG="$conf_dir/mio-apt.conf"
    # `pkg` her çağrıda rastgele ayna seçip sources.list'i eziyordu; seçili depo korunsun
    export TERMUX_PKG_NO_MIRROR_SELECT=1
    exec "$bin/$NAME.mio-real" "$@"
fi
# 9) termux-exec ön yükleyicisi apt'nin başlattığı indirme yöntemi süreçlerini bozabiliyor:
#    "E: Sub-process https returned an error code (100)" / "Method ... did not start correctly".
#    apt ve alt süreçleri kendi yollarını bildiği için ön yükleyici olmadan çalıştırılır.
if [ -n "${LD_PRELOAD:-}" ]; then
    MIO_LD_PRELOAD="$LD_PRELOAD"
    unset LD_PRELOAD
fi
# dpkg, paket betiklerini ve yardımcı programları PATH'te arar; önek her zaman başta olsun
case ":$PATH:" in
    *":$prefix/bin:"*) ;;
    *) PATH="$prefix/bin:$PATH" ;;
esac
export PATH
# shellcheck disable=SC2086
exec "$bin/$NAME.mio-real" $apt_opts "$@"
MIO_EOF
    sed -e "s|@@NAME@@|$name|g" -e "s|@@PREFIX@@|$PREFIX|g" "$wrapper" > "$wrapper.tmp" 2>/dev/null && mv "$wrapper.tmp" "$wrapper"
    chmod 755 "$wrapper" 2>/dev/null
    printf 'mio: %s sarmalayıcısı kuruldu\n' "$name"
}

# dpkg sarmalayıcısı: depodaki paketler `com.termux` öneki için derlenmiş
# (`./data/data/com.termux/files/usr/...` yolları ve maint script shebang'leri). Bu önek bu
# uygulamada yok, dpkg `error creating directory './.data/data/com.termux': Permission denied`
# veriyor. Sarmalayıcı, dpkg'ye verilen her .deb dosyasını `com.mio` yollarıyla yeniden paketler;
# böylece dpkg chroot/instdir hilesine ihtiyaç duymadan doğrudan gerçek yollara kurar.
install_dpkg_wrapper() {
    [ -d "$PREFIX/bin" ] || return 0
    real="$PREFIX/bin/dpkg.mio-real"
    wrapper="$PREFIX/bin/dpkg"
    [ -f "$wrapper" ] || [ -f "$real" ] || return 0

    # Sarmalayıcı zaten güncelse dokunma
    if grep -q "MIO_DPKG_WRAPPER_VERSION=2" "$wrapper" 2>/dev/null; then
        return 0
    fi

    if [ ! -f "$real" ]; then
        # Elimizde sarmalayıcı olmayan gerçek dpkg var mı?
        if grep -q "MIO_DPKG_WRAPPER_VERSION" "$wrapper" 2>/dev/null; then
            return 0
        fi
        cp "$wrapper" "$real" 2>/dev/null || return 1
        chmod 755 "$real" 2>/dev/null
    fi
    [ -x "$real" ] || return 1

    cat > "$wrapper" <<'MIO_EOF'
#!@@PREFIX@@/bin/sh
# mio dpkg sarmalayıcısı: com.termux yollu .deb dosyalarını com.mio için yeniden paketler
MIO_DPKG_WRAPPER_VERSION=2
bin=$(dirname "$0")
prefix=$(dirname "$bin")
real="$bin/dpkg.mio-real"
ddpkg="$bin/dpkg-deb"
[ -x "$ddpkg" ] || ddpkg=dpkg-deb

# Paketi yerinde com.mio yollarına çevir. Hata olursa sessizce devam edilir (gerçek dpkg yine çalışır).
convert_deb() {
    deb="$1"
    [ -f "$deb" ] || return 0
    case "$deb" in
        *.deb) : ;;
        *) return 0 ;;
    esac
    # Zaten com.mio yollarıyla paketlenmişse hiç dokunma (hızlı yol)
    if ! "$ddpkg" -c "$deb" 2>/dev/null | grep -q 'com\.termux'; then
        return 0
    fi

    work="$prefix/tmp/mio-deb-$$"
    rm -rf "$work" 2>/dev/null
    mkdir -p "$prefix/tmp" "$work/root" 2>/dev/null || return 0
    if ! "$ddpkg" -R "$deb" "$work/root" >/dev/null 2>&1; then
        rm -rf "$work" 2>/dev/null
        return 0
    fi
    root="$work/root"

    # 1) com.termux ağacını com.mio ağacına taşı
    legacy="$root/data/data/com.termux"
    target="$root/data/data/com.mio"
    if [ -d "$legacy" ]; then
        mkdir -p "$target" 2>/dev/null
        cp -a "$legacy/." "$target/" 2>/dev/null
        rm -rf "$legacy" 2>/dev/null
    fi

    # 2) symlink hedeflerini çevir
    find "$root" -type l 2>/dev/null | while IFS= read -r link; do
        lt=$(readlink "$link" 2>/dev/null) || continue
        case "$lt" in
            *com.termux*)
                ln -sfn "$(printf '%s' "$lt" | sed 's|/data/data/com\.termux|/data/data/com.mio|g')" "$link" 2>/dev/null
                ;;
        esac
    done

    # 3) dosya içeriklerini çevir (maint script shebang'leri, conffiles, betikler)
    #    ELF dosyalarında yol, sabit uzunlukta olduğu için `/data/data/com.mio///` ile doldurulur;
    #    aksi halde ikili dosyanın boyutu/offsetleri kayar ve çalışmaz.
    find "$root" -type f 2>/dev/null | while IFS= read -r f; do
        grep -qa 'com\.termux' "$f" 2>/dev/null || continue
        if [ "$(head -c 4 "$f" 2>/dev/null)" = "ELF" ]; then
            sed -i 's|/data/data/com\.termux|/data/data/com.mio///|g' "$f" 2>/dev/null
        else
            sed -i 's|/data/data/com\.termux|/data/data/com.mio|g' "$f" 2>/dev/null
        fi
        chmod 755 "$f" 2>/dev/null
    done

    # 4) yeniden paketle ve yerine koy
    if "$ddpkg" -b "$root" "$work/new.deb" >/dev/null 2>&1 && [ -s "$work/new.deb" ]; then
        cat "$work/new.deb" > "$deb" 2>/dev/null || cp "$work/new.deb" "$deb" 2>/dev/null
        printf 'mio: paket com.mio yollarına çevrildi: %s\n' "$(basename "$deb")" >&2
    else
        printf 'mio: paket çevrilemedi (yollar com.termux kalabilir): %s\n' "$(basename "$deb")" >&2
    fi
    rm -rf "$work" 2>/dev/null
    return 0
}

for a in "$@"; do
    case "$a" in
        *.deb) convert_deb "$a" ;;
    esac
done

# dpkg yardımcı programlarını (ldconfig, start-stop-daemon, sh, tar, ...) önekte arar; eksikse
# "N expected programs not found in PATH" deyip unpack etmeden durur.
case ":$PATH:" in
    *":$prefix/bin:"*) : ;;
    *) PATH="$prefix/bin:$PATH" ; export PATH ;;
esac

exec "$real" "$@"
MIO_EOF
    sed -e "s|@@PREFIX@@|$PREFIX|g" "$wrapper" > "$wrapper.tmp" 2>/dev/null && mv "$wrapper.tmp" "$wrapper"
    chmod 755 "$wrapper" 2>/dev/null
    printf 'mio: dpkg sarmalayıcısı kuruldu\n'
}

install_apt_wrappers() {
    install_apt_wrapper pkg
    install_apt_wrapper apt
    install_apt_wrapper apt-get
    install_dpkg_wrapper
    return 0
}

install_pkg_wrapper() {
    install_apt_wrappers
}

fix_sources() {
    apt_dir="$PREFIX/etc/apt"
    sources="$apt_dir/sources.list"
    [ -d "$apt_dir" ] || return 0

    # Ne olduğu önemli değil: dosya değilse (klasör, symlink, fifo...) ya da okunamıyorsa yeniden yaz
    broken=0
    if [ -L "$sources" ]; then
        broken=1
    elif [ -e "$sources" ] && [ ! -f "$sources" ]; then
        broken=1
    elif [ -f "$sources" ] && [ ! -r "$sources" ]; then
        broken=1
    elif [ -f "$sources" ] && [ ! -s "$sources" ]; then
        broken=1
    elif [ ! -e "$sources" ]; then
        broken=1
    fi

    # Geçersiz satır (ör. "deb Termux stable main") apt'yi tamamen kilitler:
    # "Malformed entry ... (URI parse)" -> "The list of sources could not be read."
    # Adresi http(s) ile başlamayan tüm deb satırları atılır.
    if [ "$broken" -eq 0 ] && [ -f "$sources" ]; then
        bad=0
        while IFS= read -r line; do
            case "$line" in
                deb[[:space:]]*)
                    # "deb https://... stable main" -> adres 2. alan
                    addr=$(printf '%s\n' "$line" | awk '{print $2}')
                    case "$addr" in
                        http://*|https://*) : ;;
                        *) bad=$((bad + 1)) ;;
                    esac
                    ;;
            esac
        done < "$sources"
        if [ "$bad" -gt 0 ]; then
            printf 'mio: sources.list içinde %s geçersiz satır bulundu\n' "$bad"
            broken=1
        fi
    fi

    if [ "$broken" -eq 1 ]; then
        printf 'mio: bozuk sources.list onarılıyor...\n'
        found=""
        if [ -d "$sources" ]; then
            for candidate in "$sources"/*; do
                [ -f "$candidate" ] || continue
                case "$candidate" in
                    *sources.list*) found="$candidate"; break ;;
                esac
            done
        fi
        tmp="$apt_dir/sources.list.mio-tmp"
        rm -f "$tmp" 2>/dev/null
        if [ -n "$found" ]; then
            cp "$found" "$tmp" 2>/dev/null
        fi
        if [ ! -s "$tmp" ]; then
            printf 'deb https://packages-cf.termux.dev/apt/termux-main stable main\n' > "$tmp"
        fi
        rm -rf "$sources" 2>/dev/null
        mv "$tmp" "$sources" 2>/dev/null
        chmod 644 "$sources" 2>/dev/null
        printf 'mio: sources.list dosyası yeniden oluşturuldu:\n'
        sed 's/^/  /' "$sources" 2>/dev/null
    fi

    # sources.list.d içinde dosya olmayan girdiler apt'yi bozar
    if [ -d "$apt_dir/sources.list.d" ]; then
        for entry in "$apt_dir/sources.list.d"/*; do
            [ -e "$entry" ] || continue
            if [ -L "$entry" ] || { [ -d "$entry" ]; }; then
                printf 'mio: bozuk depo girdisi siliniyor: %s\n' "$entry"
                rm -rf "$entry" 2>/dev/null
            fi
        done
    fi

    install_apt_wrappers
    install_change_repo_replacement
    if [ "${MIO_NO_APT_CONFIG:-0}" != "1" ]; then
        MIO_NO_APT_CONFIG=1 ensure_apt_config
    fi
    return 0
}

run_am() {
    # Önce sistem `am`: termux-am ikilisi `com.termux` paket kimliğiyle derlendiği için yayınları
    # `com.termux` adına yapar ve bu uygulamaya (com.mio) ulaştıramaz.
    if [ -x /system/bin/am ]; then
        /system/bin/am "$@" >/dev/null 2>&1 && return 0
    fi
    if [ -x "$PREFIX/bin/termux-am" ]; then
        "$PREFIX/bin/termux-am" "$@" 2>/dev/null && return 0
    fi
    if command -v termux-am >/dev/null 2>&1; then
        termux-am "$@" 2>/dev/null && return 0
    fi
    return 1
}

send_command() {
    # `am` prints "Broadcast completed" when the broadcast really reached the app
    out=$(run_am broadcast "$@" 2>&1)
    case "$out" in
        *"Broadcast completed"*) return 0 ;;
    esac
    if [ -n "$out" ] && ! printf '%s' "$out" | grep -qi "security\|denied\|exception"; then
        return 0
    fi
    if run_am startservice -n com.mio/com.termux.app.TermuxService "$@" >/dev/null 2>&1; then
        return 0
    fi
    # Son çare: niyeti doğrudan etkinliğe gönder (bazı Android sürümleri am broadcast/startservice'i
    # kısıtlar, ama etkinlik başlatma izinli olduğu için komut yine de iletilir)
    run_am start -n com.mio/com.termux.app.TermuxActivity "$@" >/dev/null 2>&1
}

write_request() {
    mkdir -p "$REQUEST_DIR" 2>/dev/null
    {
        printf 'created=%s\n' "$(date +%s 2>/dev/null || echo 0)"
        printf '%s\n' "$@"
    } > "$REQUEST_FILE" 2>/dev/null
}

# Komutu çalıştır: $1 eylem, kalanı --es anahtar değer çiftleri
# Önce yayın denenir; olmazsa istek dosyası yazılır ve uygulama servisi dosyayı görüp komutu
# kendisi çalıştırır (am bazı cihazlarda kabuk kullanıcısına kapalı olabiliyor).
send() {
    action="$1"
    shift

    # --es mode up --es size 20 ... -> "mode up size 20" (uygulama istek dosyasından okur)
    args=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --es|--ei|--ez|--el)
                if [ $# -ge 3 ]; then
                    args="$args${args:+ }$2 $3"
                    shift 3
                else
                    shift
                fi
                ;;
            *) shift ;;
        esac
    done

    if [ -n "$args" ]; then
        write_request "command=mio" "action=$action" "args=$args"
    else
        write_request "command=mio" "action=$action"
    fi

    if send_command -a "$action" "$@"; then
        return 0
    fi

    # `am` çıktısı güvenilir değil: başarılı olsa bile bazen "Broadcast completed" yazmıyor.
    # Uygulama isteği aldığında dosyayı siliyor, o yüzden dosyanın YOK olması komutun ulaştığı anlamına
    # gelir (eskiden bu durum yanlışlıkla "iletilemedi" diye raporlanıyordu).
    if [ ! -f "$REQUEST_FILE" ]; then
        return 0
    fi

    # Dosya hâlâ duruyor: yayın engellenmiş olabilir, ama uygulama açıkken 600 ms'de bir yokluyor.
    sleep 1 2>/dev/null || sleep 1
    if [ ! -f "$REQUEST_FILE" ]; then
        return 0
    fi
    printf 'mio: komut uygulamaya iletilemedi (yayın engellendi), istek dosyasına yazıldı: %s\n' "$REQUEST_FILE"
    printf 'mio: uygulama açıkken bu dosya 600 ms içinde okunur; menü açılmazsa uygulamayı bir kez aç.\n'
    return 0
}

