#!/data/data/com.mio/files/usr/bin/sh
#
# mio - Termux'un bu çatalının (fork) menüsünü ve ayarlarını terminalden yönetir.
#
# Kullanım:
#   mio                     Menüyü aç
#   mio kay                 Kar animasyonunu aç/kapat
#   mio parcacik            Parçacık animasyonunu aç/kapat
#   mio yazi +              Yazı boyutunu büyüt
#   mio yazi -              Yazı boyutunu küçült
#   mio tema matrix         Hazır bir tema uygula
#   mio renk red #FF0000    Tek bir rengi değiştir
#   mio tam ekran           Tam ekranı aç/kapat
#   mio ses tuslari         Ses tuşlarını medya sesi / terminal kısayolu arasında değiştir
#   mio paket               Paketleri listeler (~/.mio/pkgs)
#   mio paket kur <ad>      Paketin .a.sh / .b.sh betiklerini sırayla çalıştırır
#   mio paket guncelle      Güncellenebilir tüm paketleri kurar
#   mio paket baslat        Kurulu paketlerin .start-up.sh betiklerini çalıştırır
#   mio paket sifirla       Örnek paketi (Older-Pack) oluşturur
#   mio teshis              Kurulu komutları ve sürümü kontrol eder (menü açılmıyorsa)
#   mio menuler             Yan menüleri aç/kapat
#   mio oturum              Yeni oturum aç
#   mio yardim              Bu yardımı gösterir
#
# Notlar:
#   * Komutlar uygulamanın kendi yayın alıcısına (broadcast) mesaj yollar, termux-api gerekmez.
#   * Ekran görüntüsü/medya komutları için: swset <dosya>, swset off, so, so off.

if [ -z "${PREFIX:-}" ]; then
    # Betiğin yeri: $PREFIX/bin/mio -> PREFIX iki üst dizin
    mio_dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)
    case "$mio_dir" in
        */bin) PREFIX=$(dirname "$mio_dir") ;;
        *)     PREFIX=/data/data/com.mio/files/usr ;;
    esac
fi

ACTION_MENU="com.termux.mio.action.MENU"
ACTION_ANIMATION="com.termux.mio.action.ANIMATION"
ACTION_FONT_SIZE="com.termux.mio.action.FONT_SIZE"
ACTION_COLORS="com.termux.mio.action.COLORS"
ACTION_FULLSCREEN="com.termux.mio.action.FULLSCREEN"
ACTION_SESSION="com.termux.mio.action.SESSION"
ACTION_STYLE="com.termux.mio.action.STYLE"
ACTION_VOLUME_KEYS="com.termux.mio.action.VOLUME_KEYS"

REQUEST_DIR="$HOME/.termux/mio"
REQUEST_FILE="$REQUEST_DIR/request"

usage() {
    cat <<EOF
Kullanım: mio [komut]

  mio                     Menüyü açar (arka plan, animasyon, yazı boyutu, renkler, tam ekran...)
  mio kay                 Kar animasyonunu açar/kapatır.
  mio parcacik            Parçacık animasyonunu açar/kapatır.
  mio yazi +|-            Yazı boyutunu büyütür/küçültür.
  mio yazi <sayı>         Yazı boyutunu ayarlar, örnek: mio yazi 14
  mio tema <ad>           Hazır tema uygular: varsayilan, matrix, gece, mor, sicak
  mio renk <ad> <#RRGGBB> Tek rengi değiştirir, örnek: mio renk foreground #00FF66
  mio tam ekran           Tam ekranı açar/kapatır.
  mio ses                 Ses tuşlarını medya sesi <-> terminal kısayolu yapar.
  mio ses +|-             Medya sesini arttırır/azaltır.
  mio paket               Paketleri listeler (~/.mio/pkgs/<paket>).
  mio paket kur <ad>      Paketin .a.sh, .b.sh ve .start-up.sh betiklerini çalıştırır.
  mio paket guncelle      Güncellenebilir tüm paketleri kurar.
  mio paket baslat        Kurulu paketlerin .start-up.sh betiklerini çalıştırır.
  mio paket sifirla       Örnek paketi (Older-Pack) oluşturur.
  mio paket log <ad>      Paketin son çalıştırma günlüğünü gösterir.
  mio apt-fix             apt/dpkg sorunlarını onarır ve test eder (tek komut)
  mio teshis              Komutların kurulu olup olmadığını ve sürümünü gösterir.
  mio menuler             Yan menüleri gösterir/gizler.
  mio oturum              Yeni oturum açar.
  mio ses + | -           Medya sesini artırır/azaltır.
  mio yardim              Bu yardımı gösterir.

Arka plan medyası (fotoğraf/video):  swset <dosya>   swset off
Videonun sesi:                       so   so off   so stop
EOF
}


# ---------------------------------------------------------------------------------------------
# apt depoları: sources.list bir dosya olmalı. Bozuk kurulumlarda klasör olarak kalabiliyor
# ("E: Read error - read (21: Is a directory)"), bu yüzden pkg'den önce onarılır.


# ---------------------------------------------------------------------------------------------
# apt yapılandırmasını sabitle
#
# Ekran çıktısındaki iki satır birlikte geliyor:
#   N: Ignoring file 'sources.list' in directory '.../etc/apt' as it has an invalid filename extension
#   E: Read error - read (21: Is a directory)
# Yani apt, `.../etc/apt` klasörünü "sourceparts" dizini sanıp içindeki sources.list'i arıyor.
# Çözüm: yolları apt.conf.d içinde açıkça sabitlemek ve geçerli bir `*.list` dosyası bırakmak.
# ---------------------------------------------------------------------------------------------
ensure_apt_config() {
    apt_dir="$PREFIX/etc/apt"
    sources="$apt_dir/sources.list"
    parts="$apt_dir/sources.list.d"
    conf_dir="$apt_dir/apt.conf.d"
    mkdir -p "$apt_dir" "$parts" "$conf_dir" 2>/dev/null

    # 1) sources.list her zaman normal bir dosya
    if [ -L "$sources" ] || { [ -e "$sources" ] && [ ! -f "$sources" ]; } || { [ -f "$sources" ] && [ ! -s "$sources" ]; }; then
        fix_sources >/dev/null 2>&1
    fi

    # 2) sourceparts gerçekten bir klasör olmalı; apt onu "sourceparts" olarak okuyor.
    #    Symlink kendini gösteriyorsa (ör. -> ..) apt "Ignoring file 'sources.list'" der.
    if [ -L "$parts" ]; then
        rm -f "$parts" 2>/dev/null
        mkdir -p "$parts" 2>/dev/null
    elif [ -e "$parts" ] && [ ! -d "$parts" ]; then
        rm -rf "$parts" 2>/dev/null
        mkdir -p "$parts" 2>/dev/null
    fi

    # 2b) sources.list içinde birden fazla `deb` satırı varsa ilkini bırak (yavaş ayna kalmasın)
    if [ -f "$sources" ]; then
        deb_count=$(grep -c '^deb ' "$sources" 2>/dev/null || true)
        [ -n "$deb_count" ] || deb_count=0
        if [ "$deb_count" -gt 1 ]; then
            first_url=$(grep '^deb ' "$sources" 2>/dev/null | head -n 1 | awk '{print $2}')
            if [ -n "$first_url" ]; then
                printf '# %s tarafından yazıldı\ndeb %s stable main\n' "mio" "$first_url" > "$sources.tmp" 2>/dev/null &&
                    mv "$sources.tmp" "$sources" 2>/dev/null
            fi
        fi
    fi

    # 3) sources.list.d içinde AYNI depoyu tekrar eden dosya bırakma: apt
    #    "Target Packages is configured multiple times" uyarısı veriyor
    for dup in "$parts"/*.list; do
        [ -f "$dup" ] || continue
        case "$(basename "$dup")" in
            mio.list|main.list) rm -f "$dup" 2>/dev/null ;;
        esac
    done

    # 3b) apt.conf.d içinde kaynak yollarını bozan artıkları kaldır.
    #     Bir dosya `sources.list` geçiyor ama doğru `Dir::Etc::` anahtarını kullanmıyorsa (ör. yanlış
    #     yazılmış `Dir::Etc "sources.list";`), apt yolu klasör olarak çözer ve ekrandaki hatayı verir.
    if [ -d "$conf_dir" ]; then
        for f in "$conf_dir"/*; do
            [ -f "$f" ] || continue
            base=$(basename "$f")
            [ "$base" = "zz-mio-sources.conf" ] && continue
            if grep -q "sources\.list" "$f" 2>/dev/null && ! grep -q "Dir::Etc::sourcelist" "$f" 2>/dev/null; then
                rm -f "$f" 2>/dev/null && printf 'mio: bozuk apt yapılandırması silindi: %s\n' "$f" >&2
            fi
        done
    fi

    # 3c) apt indirme yöntemleri çalıştırılabilir olmalı, yoksa "Failed to exec method ... https"
    methods="$PREFIX/lib/apt/methods"
    if [ -d "$methods" ]; then
        for m in "$methods"/*; do
            [ -f "$m" ] || continue
            [ -x "$m" ] || chmod 755 "$m" 2>/dev/null
        done
    fi

    # 3d) apt'nin çalışma klasörleri (yoksa "List directory .../var/lib/apt is missing")
    for d in "$PREFIX/var/lib/apt/lists/partial" "$PREFIX/var/cache/apt/archives/partial" \
             "$PREFIX/var/lib/dpkg" "$PREFIX/var/log/apt" "$PREFIX/etc/apt/trusted.gpg.d" \
             "$PREFIX/tmp"; do
        [ -d "$d" ] || mkdir -p "$d" 2>/dev/null
    done
    [ -f "$PREFIX/var/lib/dpkg/status" ] || : > "$PREFIX/var/lib/dpkg/status" 2>/dev/null

    # 4) yolları sabitle (bu dosya apt tarafından her zaman okunur, atomik yazılır)
    conf="$conf_dir/zz-mio-sources.conf"
    {
        printf '# mio: pin the apt source locations\n'
        printf 'Dir::Etc::sourcelist "%s";\n' "$sources"
        printf 'Dir::Etc::sourceparts "%s";\n' "$parts"
    } > "$conf.tmp" 2>/dev/null
    if [ -s "$conf.tmp" ]; then
        mv "$conf.tmp" "$conf" 2>/dev/null
        chmod 644 "$conf" 2>/dev/null
    fi

    # 5) `pkg` kendi argüman ayrıştırıcısını kullandığı için `-o` geçemiyor; aynı yollar APT_CONFIG
    #    ile dayatılır (apt bu dosyayı her çağrıda okur)
    apc="$conf_dir/mio-apt.conf"
    {
        printf '# mio: apt yolları (APT_CONFIG)\n'
        printf 'Dir::Etc "%s/etc/apt";\n' "$PREFIX"
        printf 'Dir::Etc::sourcelist "%s";\n' "$sources"
        printf 'Dir::Etc::sourceparts "%s";\n' "$parts"
        printf 'Dir::Etc::trusted "%s/etc/apt/trusted.gpg";\n' "$PREFIX"
        printf 'Dir::Etc::trustedparts "%s/etc/apt/trusted.gpg.d";\n' "$PREFIX"
        printf 'Dir::State "%s/var/lib/apt";\n' "$PREFIX"
        printf 'Dir::State::lists "%s/var/lib/apt/lists";\n' "$PREFIX"
        printf 'Dir::State::status "%s/var/lib/dpkg/status";\n' "$PREFIX"
        printf 'Dir::Cache "%s/var/cache/apt";\n' "$PREFIX"
        printf 'Dir::Cache::archives "%s/var/cache/apt/archives";\n' "$PREFIX"
        printf 'Dir::Log "%s/var/log/apt";\n' "$PREFIX"
        printf 'Dir::Bin::methods "%s/lib/apt/methods";\n' "$PREFIX"
        printf 'Dir::State::extended_states "%s/var/lib/apt/extended_states";\n' "$PREFIX"
        printf 'DPkg::Path "%s/bin:/system/bin:/system/xbin";\n' "$PREFIX"
        printf 'Acquire::ForceIPv4 "true";\n'
        printf 'Acquire::Languages "none";\n'
    } > "$apc.tmp" 2>/dev/null
    if [ -s "$apc.tmp" ]; then
        mv "$apc.tmp" "$apc" 2>/dev/null
        chmod 644 "$apc" 2>/dev/null
    fi
    return 0
}

# ---------------------------------------------------------------------------------------------
# Teşhis: sources.list dosyasının gerçek durumu (klasör/symlink/boş/izin)
# ---------------------------------------------------------------------------------------------
sources_report() {
    sources="$PREFIX/etc/apt/sources.list"
    printf 'Dizin: %s\n' "$PREFIX/etc/apt"
    if [ -L "$sources" ]; then
        printf 'sources.list: SYMLINK -> %s\n' "$(readlink "$sources" 2>/dev/null)"
    elif [ -d "$sources" ]; then
        printf 'sources.list: KLASÖR (bozuk)\n'
        ls -la "$sources" 2>/dev/null | sed 's/^/  /'
    elif [ -f "$sources" ]; then
        if [ -s "$sources" ]; then
            printf 'sources.list: DOSYA, %s bayt (ok)\n' "$(wc -c < "$sources" 2>/dev/null | tr -d ' ')"
            sed 's/^/  /' "$sources" 2>/dev/null
        else
            printf 'sources.list: DOSYA ama BOŞ (bozuk)\n'
        fi
    elif [ -e "$sources" ]; then
        printf 'sources.list: başka bir tür (bozuk)\n'
    else
        printf 'sources.list: YOK\n'
    fi

    printf 'pkg: '
    if [ -f "$PREFIX/bin/pkg.mio-real" ]; then printf 'sarmalayıcı kurulu\n'; else printf 'sarmalayıcı YOK\n'; fi
    printf 'apt: '
    if [ -f "$PREFIX/bin/apt.mio-real" ]; then printf 'sarmalayıcı kurulu\n'; else printf 'sarmalayıcı YOK\n'; fi
    printf 'apt-get: '
    if [ -f "$PREFIX/bin/apt-get.mio-real" ]; then printf 'sarmalayıcı kurulu\n'; else printf 'sarmalayıcı YOK\n'; fi
    printf 'termux-change-repo: '
    if grep -q "mio guvenli surum" "$PREFIX/bin/termux-change-repo" 2>/dev/null; then
        printf 'güvenli sürüm\n'
    else
        printf 'ORİJİNAL (depoyu bozabilir)\n'
    fi
    printf 'sources.list.d: '
    if [ -d "$PREFIX/etc/apt/sources.list.d" ]; then
        printf 'klasör (ok), %s dosya\n' "$(ls -1 "$PREFIX/etc/apt/sources.list.d" 2>/dev/null | wc -l | tr -d ' ')"
        ls -l "$PREFIX/etc/apt/sources.list.d" 2>/dev/null | sed 's/^/  /'
    else
        printf 'YOK (bozuk)\n'
    fi
    printf 'apt.conf.d/zz-mio-sources.conf: '
    if [ -f "$PREFIX/etc/apt/apt.conf.d/zz-mio-sources.conf" ]; then
        printf 'var\n'
        sed 's/^/  /' "$PREFIX/etc/apt/apt.conf.d/zz-mio-sources.conf" 2>/dev/null
    else
        printf 'YOK\n'
    fi
    printf 'apt.conf.d/ diğer dosyalar: '
    if [ -d "$PREFIX/etc/apt/apt.conf.d" ]; then
        printf '%s\n' "$(ls -1 "$PREFIX/etc/apt/apt.conf.d" 2>/dev/null | tr '\n' ' ')"
    else
        printf 'klasör YOK\n'
    fi

    # apt.conf.d içindeki her dosyayı tek tek dene: hata veren dosya adını yaz
    if [ -d "$PREFIX/etc/apt/apt.conf.d" ]; then
        printf 'apt.conf.d taraması: '
        bad=""
        for f in "$PREFIX/etc/apt/apt.conf.d"/*; do
            [ -f "$f" ] || continue
            if grep -q "sources.list" "$f" 2>/dev/null && ! grep -q "Dir::Etc::sourcelist" "$f" 2>/dev/null; then
                bad="$bad $f"
            fi
        done
        if [ -n "$bad" ]; then
            printf 'ŞÜPHELİ:%s\n' "$bad"
        else
            printf 'sorun görünmüyor\n'
        fi
    fi
    printf 'etc/apt içeriği:\n'
    ls -la "$PREFIX/etc/apt" 2>/dev/null | sed 's/^/  /'

    # Gerçek apt'ye sor: hangi dosyaları kaynak olarak görüyor?
    apt_bin=""
    for candidate in "$PREFIX/bin/apt" "$PREFIX/bin/apt-get"; do
        [ -f "$candidate" ] || continue
        apt_bin="$candidate"
        break
    done
    printf '\napt çalışma klasörleri:\n'
    for d in "$PREFIX/var/lib/apt/lists/partial" "$PREFIX/var/cache/apt/archives/partial" \
             "$PREFIX/var/lib/dpkg" "$PREFIX/tmp"; do
        if [ -d "$d" ]; then printf '  VAR   %s\n' "$d"; else printf '  YOK   %s (bozuk)\n' "$d"; fi
    done
    printf 'APT_CONFIG dosyası: %s\n' "$PREFIX/etc/apt/apt.conf.d/mio-apt.conf"
    if [ -f "$PREFIX/etc/apt/apt.conf.d/mio-apt.conf" ]; then
        sed 's/^/  /' "$PREFIX/etc/apt/apt.conf.d/mio-apt.conf" 2>/dev/null
    else
        printf '  YOK\n'
    fi

    printf '\napt methods (lib/apt/methods): '
    if [ -d "$PREFIX/lib/apt/methods" ]; then
        broken_m=""
        for m in "$PREFIX/lib/apt/methods"/*; do
            [ -f "$m" ] || continue
            [ -x "$m" ] || broken_m="$broken_m $(basename "$m")"
        done
        if [ -n "$broken_m" ]; then
            printf 'ÇALIŞTIRILAMIYOR:%s\n' "$broken_m"
        else
            printf 'tamam\n'
        fi
        ls -l "$PREFIX/lib/apt/methods" 2>/dev/null | sed 's/^/  /'
    else
        printf 'klasör YOK\n'
    fi

    printf '\napt kaynak yapılandırması (apt-config dump):\n'
    if [ -n "$apt_bin" ]; then
        cfg_out=$(apt-config dump 2>/dev/null | grep -a -i "^Dir::Etc::source")
        if [ -n "$cfg_out" ]; then
            printf '%s\n' "$cfg_out" | sed 's/^/  /'
        else
            printf '  okunamadı (config dump desteklenmiyor)\n'
        fi
    else
        printf '  apt bulunamadı\n'
    fi

    printf 'methods tanılama (https):\n'
    hm="$PREFIX/lib/apt/methods/https"
    if [ -e "$hm" ]; then
        ls -l "$hm" 2>/dev/null | sed 's/^/  /'
        readlink -f "$hm" 2>/dev/null | sed 's/^/  hedef: /'
        if [ -x "$hm" ]; then printf '  çalıştırılabilir: evet\n'; else printf '  çalıştırılabilir: HAYIR\n'; fi
        ht=$("$PREFIX/lib/apt/methods/https" --version 2>&1 | head -n 3)
        hrc=$?
        if [ -n "$ht" ]; then
            printf '  çalıştırma denemesi (çıkış=%s):\n' "$hrc"
            printf '%s\n' "$ht" | sed 's/^/    /'
        else
            printf '  çalıştırma denemesi: çıktı yok, çıkış=%s\n' "$hrc"
        fi
    else
        printf '  %s YOK\n' "$hm"
    fi

    # NOT: burada `apt update` ÇALIŞTIRILMAZ. Ağa çıktığı için rapor dakikalarca asılı kalıyordu.

    printf '\nKurulu apt sürümü: '
    dpkg -s apt 2>/dev/null | sed -n 's/^Version: //p' | head -n 1
    printf '\n'
}

# ---------------------------------------------------------------------------------------------
# apt depoları onarımı
#
# `sources.list` bir DOSYA olmalı. Bozuk kurulumlarda klasör, symlink veya başka bir şey olarak
# kalabiliyor ve apt "E: Read error - read (21: Is a directory)" veriyor. `termux-change-repo`
# bazen bu bozuk girdiyi kendisi oluşturduğu için pkg'den hemen önce tekrar onarılır.
# ---------------------------------------------------------------------------------------------

# $PREFIX/bin/pkg sarmalayıcısı: her pkg çağrısından önce depoyu onarır


# `termux-change-repo` betiğini güvenli sürümümüzle değiştir: orijinali bu fork'ta sources.list'i
# bozuyor (klasör olarak kalıyor). Orijinal bir kez `.orj` olarak saklanır.
install_change_repo_replacement() {
    tool="$PREFIX/bin/termux-change-repo"
    backup="$PREFIX/bin/termux-change-repo.orj"
    [ -d "$PREFIX/bin" ] || return 0
    [ -f "$tool" ] || return 0

    if [ ! -f "$backup" ] && ! grep -q "mio guvenli surum" "$tool" 2>/dev/null; then
        cp "$tool" "$backup" 2>/dev/null
    fi

    cat > "$tool" <<'MIO_EOF'
#!/data/data/com.mio/files/usr/bin/sh
# mio guvenli surum: depo dosyasini atomik yazar, bozuk birakmaz
prefix="${PREFIX:-/data/data/com.mio/files/usr}"
[ -x "$prefix/bin/mio" ] || prefix=$(dirname "$(dirname "$0")")
exec "$prefix/bin/mio" depo sec "$@"
MIO_EOF
    chmod 755 "$tool" 2>/dev/null
}

# ---------------------------------------------------------------------------------------------
# Depo değiştirici (termux-change-repo yerine)
#
# Orijinal betik `sources.list`'i yeniden yazarken dosyayı bozuyor (klasör/symlink kalıyor) ve apt
# "E: Read error - read (21: Is a directory)" veriyor. Bu sürüm her zaman geçici bir dosyaya yazıp
# atomik olarak yerine koyar; bozuk bir girdi kalırsa tekrar dener.
# ---------------------------------------------------------------------------------------------
MIRROR_FILE="$PREFIX/etc/apt/sources.list"
MIRROR_MAIN_DEFAULT="https://packages-cf.termux.dev/apt/termux-main"
MIRRORS="
Termux (CF)|https://packages-cf.termux.dev/apt/termux-main
Termux (Asya)|https://mirror.termux.dev/termux/termux-main
SJTU (Çin)|https://mirror.sjtu.edu.cn/termux/apt/termux-main
Tsinghua (Çin)|https://mirrors.tuna.tsinghua.edu.cn/termux/apt/termux-main
USTC (Çin)|https://mirrors.ustc.edu.cn/termux/apt/termux-main
Astra (Rusya)|https://mirrors.astra.in.ua/termux/termux-main
"

write_sources() {
    url="$1"
    apt_dir="$PREFIX/etc/apt"
    mkdir -p "$apt_dir" 2>/dev/null
    tmp="$apt_dir/.sources.list.mio-new"
    printf '# %s tarafından yazıldı\ndeb %s stable main\n' "mio" "$url" > "$tmp" 2>/dev/null || return 1
    rm -rf "$MIRROR_FILE" 2>/dev/null
    mv "$tmp" "$MIRROR_FILE" 2>/dev/null || return 1
    chmod 644 "$MIRROR_FILE" 2>/dev/null
    # Gerçekten dosya olduğunu doğrula (bozuk kurulumda şart)
    [ -f "$MIRROR_FILE" ] && [ ! -L "$MIRROR_FILE" ] || {
        fix_sources
        [ -f "$MIRROR_FILE" ] || return 1
    }
    # seçimi kalıcı olarak sakla, böylece her açılışta aynı depo kullanılır
    printf '%s\n' "$url" > "$apt_dir/.mio-mirror" 2>/dev/null

    # aynı depoyu ikinci kez yazan dosyaları kaldır (çift kayıt uyarısı çıkmasın)
    parts_dir="$apt_dir/sources.list.d"
    mkdir -p "$parts_dir" 2>/dev/null
    rm -f "$parts_dir/mio.list" "$parts_dir/main.list" 2>/dev/null
    # zz-mio-sources.conf yolları sabitler; yoksa oluştur
    conf_file="$apt_dir/apt.conf.d/zz-mio-sources.conf"
    if [ ! -s "$conf_file" ]; then
        mkdir -p "$apt_dir/apt.conf.d" 2>/dev/null
        {
            printf '# mio: pin the apt source locations\n'
            printf 'Dir::Etc::sourcelist "%s";\n' "$MIRROR_FILE"
            printf 'Dir::Etc::sourceparts "%s";\n' "$parts_dir"
        } > "$conf_file.tmp" 2>/dev/null
        [ -s "$conf_file.tmp" ] && mv "$conf_file.tmp" "$conf_file" 2>/dev/null
        chmod 644 "$conf_file" 2>/dev/null
    fi
    return 0
}

mirror_choose() {
    if [ -n "${1:-}" ]; then
        case "$1" in
            cf|termux|varsayilan|default) write_sources "$MIRROR_MAIN_DEFAULT" && printf 'Depo: %s\n' "$MIRROR_MAIN_DEFAULT"; return $? ;;
            asya|asia) write_sources "https://mirror.termux.dev/termux/termux-main" && printf 'Depo: mirror.termux.dev\n'; return $? ;;
            sjtu) write_sources "https://mirror.sjtu.edu.cn/termux/apt/termux-main" && printf 'Depo: SJTU\n'; return $? ;;
            tuna|tsinghua) write_sources "https://mirrors.tuna.tsinghua.edu.cn/termux/apt/termux-main" && printf 'Depo: Tsinghua\n'; return $? ;;
            ustc) write_sources "https://mirrors.ustc.edu.cn/termux/apt/termux-main" && printf 'Depo: USTC\n'; return $? ;;
            astra) write_sources "https://mirrors.astra.in.ua/termux/termux-main" && printf 'Depo: Astra\n'; return $? ;;
            *) # URL verilmişse doğrudan kullan
               case "$1" in
                   http*) write_sources "$1" && printf 'Depo: %s\n' "$1"; return $? ;;
               esac
               printf 'Bilinmeyen depo: %s\n' "$1" >&2
               return 2 ;;
        esac
    fi

    printf 'Depo seçin:\n'
    printf '%s' "$MIRRORS" | while IFS='|' read -r label url; do
        [ -n "$label" ] || continue
        idx=$((idx+1))
        printf '  %s) %s\n' "$idx" "$label"
    done
    printf 'Seçim [1]: '
    read -r choice || choice=""
    [ -z "$choice" ] && choice=1

    n=0
    url=""
    printf '%s' "$MIRRORS" | while IFS='|' read -r label u; do
        [ -n "$label" ] || continue
        n=$((n+1))
        if [ "$n" = "$choice" ]; then printf '%s' "$u"; fi
    done > "$HOME/.mio/.mirror-choice" 2>/dev/null

    url=$(cat "$HOME/.mio/.mirror-choice" 2>/dev/null)
    rm -f "$HOME/.mio/.mirror-choice" 2>/dev/null
    [ -n "$url" ] || url="$MIRROR_MAIN_DEFAULT"

    if write_sources "$url"; then
        printf 'Depo: %s\n' "$url"
        printf 'Şimdi "pkg update" çalıştırabilirsin.\n'
        return 0
    fi
    printf 'Depo yazılamadı: %s\n' "$MIRROR_FILE" >&2
    return 1
}

install_apt_wrapper() {
    name="$1"
    real="$PREFIX/bin/$name.mio-real"
    wrapper="$PREFIX/bin/$name"
    [ -d "$PREFIX/bin" ] || return 0

    # Sarmalayıcı silinmiş ama gerçek araç duruyorsa sıfırdan kurulur (apt-fix sonrası kurtarma)
    if [ ! -f "$wrapper" ] && [ ! -f "$real" ]; then
        return 0
    fi
    if [ ! -f "$wrapper" ] && [ -f "$real" ]; then
        case "$name" in
            pkg|apt|apt-get) : ;;   # devam: aşağıda yeniden yazılır
            *) return 0 ;;
        esac
    fi

    # Zaten güncel sarmalayıcı varsa dokunma (sürüm damgası ile)
    if grep -q "MIO_WRAPPER_VERSION=19" "$wrapper" 2>/dev/null; then
        return 0
    fi

    # Gerçek aracı bir kez sakla (sarmalayıcı kendini çağırmasın)
    if [ ! -f "$real" ]; then
        if grep -q "MIO_WRAPPER_VERSION" "$wrapper" 2>/dev/null; then
            # Daha önce sarmalanmış ama gerçek araç kaybolmuş: kurtarılamaz
            printf 'mio: %s.mio-real yok, sarmalayıcı kurulmadı\n' "$name" >&2
            return 1
        fi
        cp "$wrapper" "$real" 2>/dev/null || return 1
        chmod 755 "$real" 2>/dev/null
    fi
    [ -x "$real" ] || return 1

    # Sarmalayıcı kendi konumundan çalışır (PREFIX'e ihtiyaç duymaz), onarımı kendi yapar
    cat > "$wrapper" <<'MIO_EOF'
#!@@PREFIX@@/bin/sh
# mio apt sarmalayıcısı: apt yollarını düzeltir, sonra gerçek aracı çalıştırır
MIO_WRAPPER_VERSION=19
NAME=@@NAME@@
bin=$(dirname "$0")
prefix=$(dirname "$bin")
apt_dir="$prefix/etc/apt"
sources="$apt_dir/sources.list"
parts="$apt_dir/sources.list.d"
conf_dir="$apt_dir/apt.conf.d"

mkdir -p "$apt_dir" "$parts" "$conf_dir" 2>/dev/null

# 1) sources.list normal, boş olmayan bir dosya olmalı
broken=0
if [ -L "$sources" ]; then
    broken=1
elif [ -e "$sources" ] && [ ! -f "$sources" ]; then
    broken=1
elif [ ! -e "$sources" ]; then
    broken=1
elif [ ! -s "$sources" ]; then
    broken=1
fi
if [ "$broken" -eq 1 ]; then
    tmp="$apt_dir/sources.list.mio-tmp"
    found=""
    if [ -d "$sources" ]; then
        for candidate in "$sources"/*; do
            [ -f "$candidate" ] || continue
            found="$candidate"
            break
        done
    fi
    rm -f "$tmp" 2>/dev/null
    if [ -n "$found" ]; then cp "$found" "$tmp" 2>/dev/null; fi
    [ -s "$tmp" ] || printf 'deb https://packages-cf.termux.dev/apt/termux-main stable main\n' > "$tmp"
    rm -rf "$sources" 2>/dev/null
    mv "$tmp" "$sources" 2>/dev/null
    chmod 644 "$sources" 2>/dev/null
    printf 'mio: bozuk sources.list onarıldı\n' >&2
fi

# 2) sourceparts gerçek bir klasör olmalı (klasör değilse apt "Is a directory" verir)
if [ -L "$parts" ] || { [ -e "$parts" ] && [ ! -d "$parts" ]; }; then
    rm -rf "$parts" 2>/dev/null
    mkdir -p "$parts" 2>/dev/null
    printf 'mio: sources.list.d onarıldı\n' >&2
fi

# 3) aynı depoyu tekrar eden dosyaları kaldır ("configured multiple times" uyarısı biter)
rm -f "$parts/mio.list" "$parts/main.list" 2>/dev/null

# 4) yolları apt.conf.d içinde de sabitle (bazı apt çağrıları dosyayı okumadan geçebiliyor)
conf="$conf_dir/zz-mio-sources.conf"
{
    printf '# mio: pin the apt source locations\n'
    printf 'Dir::Etc::sourcelist "%s";\n' "$sources"
    printf 'Dir::Etc::sourceparts "%s";\n' "$parts"
} > "$conf" 2>/dev/null

# 5) apt'nin indirme yöntemleri (lib/apt/methods/http, https) çalıştırılabilir olmalı; aksi halde
#    apt "Failed to exec method ..." verir ve hiçbir depo okunamaz.
methods="$prefix/lib/apt/methods"
if [ -d "$methods" ]; then
    for m in "$methods"/*; do
        [ -e "$m" ] || continue
        if [ ! -x "$m" ]; then chmod 755 "$m" 2>/dev/null; fi
    done
    # kırık symlink (ör. https -> http hedefi yok) yerine gerçek kopya
    for m in "$methods"/*; do
        [ -L "$m" ] || continue
        [ -e "$m" ] && continue
        base=$(basename "$m")
        target=""
        case "$base" in
            https|tor+https) target="$methods/http" ;;
            tor+http) target="$methods/http" ;;
        esac
        if [ -n "$target" ] && [ -f "$target" ]; then
            rm -f "$m" 2>/dev/null
            cp "$target" "$m" 2>/dev/null
            chmod 755 "$m" 2>/dev/null
            printf 'mio: apt yöntemi onarıldı: %s\n' "$m" >&2
        fi
    done
fi

# 6) apt'nin çalışma klasörleri eksikse apt hiçbir şey okuyamaz:
#    "E: List directory .../usr/var/lib/apt is missing" (bu, "sources.list" hatasından sonraki adım)
for d in "$prefix/var/lib/apt/lists/partial" "$prefix/var/cache/apt/archives/partial" \
         "$prefix/var/lib/dpkg" "$prefix/var/log/apt" "$prefix/etc/apt/trusted.gpg.d" "$prefix/tmp"; do
    [ -d "$d" ] || mkdir -p "$d" 2>/dev/null
done
touch "$prefix/var/lib/dpkg/status" 2>/dev/null

# 7) Yolları APT_CONFIG ile dayat: bu dosya apt'nin kendisi tarafından okunur ve `pkg` gibi
#    sarmalayıcılar `-o` geçirmese de geçerli olur.
export APT_CONFIG="$conf_dir/mio-apt.conf"
{
    printf '# mio: apt yolları (APT_CONFIG)\n'
    printf 'Dir::Etc "%s/etc/apt";\n' "$prefix"
    printf 'Dir::Etc::sourcelist "%s";\n' "$sources"
    printf 'Dir::Etc::sourceparts "%s";\n' "$parts"
    printf 'Dir::Etc::trusted "%s/etc/apt/trusted.gpg";\n' "$prefix"
    printf 'Dir::Etc::trustedparts "%s/etc/apt/trusted.gpg.d";\n' "$prefix"
    printf 'Dir::State "%s/var/lib/apt";\n' "$prefix"
    printf 'Dir::State::lists "%s/var/lib/apt/lists";\n' "$prefix"
    printf 'Dir::State::status "%s/var/lib/dpkg/status";\n' "$prefix"
    printf 'Dir::Cache "%s/var/cache/apt";\n' "$prefix"
    printf 'Dir::Cache::archives "%s/var/cache/apt/archives";\n' "$prefix"
    printf 'Dir::Log "%s/var/log/apt";\n' "$prefix"
    printf 'Dir::Bin::methods "%s/lib/apt/methods";\n' "$prefix"
    printf 'Dir::State::extended_states "%s/var/lib/apt/extended_states";\n' "$prefix"
    printf 'DPkg::Path "%s/bin:/system/bin:/system/xbin";\n' "$prefix"
    printf 'Acquire::ForceIPv4 "true";\n'
    printf 'Acquire::Languages "none";\n'
} > "$APT_CONFIG" 2>/dev/null

# 8) Tüm apt kök yollarını dayat. Bu apt yapısında `Dir` öneğe ayarlı olmadığı için göreli
#    varsayılanlar kök dosya sistemine çözülüyor ("E: List directory .../var/lib/apt is missing"),
#    sourcelist/sourceparts da okunmadığı için "The list of sources could not be read" çıkıyor.
#    Önek yolu boşluk içermez, bu yüzden seçenekler tek bir değişkende toplanabilir.
#    NOT: `Dir` kökü bilerek ayarlanmaz; bu apt sürümünde `Dir` verilince mutlak bir
#    `Dir::Bin::methods` bile göreli hale geliyor ve yöntemler başlatılamıyor.
apt_opts="-o Dir::Etc=$prefix/etc/apt"
apt_opts="$apt_opts -o Dir::Etc::sourcelist=$sources -o Dir::Etc::sourceparts=$parts"
apt_opts="$apt_opts -o Dir::Etc::trusted=$prefix/etc/apt/trusted.gpg"
apt_opts="$apt_opts -o Dir::Etc::trustedparts=$prefix/etc/apt/trusted.gpg.d"
apt_opts="$apt_opts -o Dir::State=$prefix/var/lib/apt -o Dir::State::lists=$prefix/var/lib/apt/lists"
apt_opts="$apt_opts -o Dir::State::status=$prefix/var/lib/dpkg/status"
apt_opts="$apt_opts -o Dir::Cache=$prefix/var/cache/apt"
apt_opts="$apt_opts -o Dir::Cache::archives=$prefix/var/cache/apt/archives"
apt_opts="$apt_opts -o Dir::Log=$prefix/var/log/apt"
# apt, indirme yöntemlerini `Dir::Bin::methods` altında arar; bu değer mutlak değilse
# `Dir` köküyle birleşip var olmayan bir yola dönüşür ("Method ... did not start correctly")
apt_opts="$apt_opts -o Dir::Bin::methods=$prefix/lib/apt/methods"
apt_opts="$apt_opts -o Dir::State::extended_states=$prefix/var/lib/apt/extended_states"
apt_opts="$apt_opts -o Dir::Bin::dpkg=$prefix/bin/dpkg"
# dpkg, yardımcı programlarını (sh, rm, tar, diff, dpkg-deb) `DPkg::Path` içinde arar; apt bu değeri
# boş bulursa çocuk sürece kendi PATH'ini veriyor ve "N expected programs not found in PATH" çıkıyor.
apt_opts="$apt_opts -o DPkg::Path=$prefix/bin:/system/bin:/system/xbin"
# Hız: IPv4 zorla (IPv6 Türkiye'de sık sık takılıyor), çeviri dosyalarını indirme, 3 kez dene
apt_opts="$apt_opts -o Acquire::ForceIPv4=true -o Acquire::Languages=none"
apt_opts="$apt_opts -o Acquire::Retries=3 -o Acquire::http::Pipeline-Depth=0"
arch=$(dpkg --print-architecture 2>/dev/null)
[ -n "$arch" ] && apt_opts="$apt_opts -o APT::Architecture=$arch"

if [ "$NAME" = "pkg" ]; then
    # `pkg` kendi argüman ayrıştırıcısını kullanır, `-o` kabul etmez; ama `apt`/`apt-get`'i PATH'ten
    # çağırdığı için onlar bu sarmalayıcıdan geçer ve yollar orada dayatılır.
    export APT_CONFIG="$conf_dir/mio-apt.conf"
    # `pkg` her çağrıda rastgele ayna seçip sources.list'i eziyordu; seçili depo korunsun
    export TERMUX_PKG_NO_MIRROR_SELECT=1
    exec "$bin/$NAME.mio-real" "$@"
fi
# 9) termux-exec ön yükleyicisi apt'nin başlattığı indirme yöntemi süreçlerini bozabiliyor:
#    "E: Sub-process https returned an error code (100)" / "Method ... did not start correctly".
#    apt ve alt süreçleri kendi yollarını bildiği için ön yükleyici olmadan çalıştırılır.
if [ -n "${LD_PRELOAD:-}" ]; then
    MIO_LD_PRELOAD="$LD_PRELOAD"
    unset LD_PRELOAD
fi
# dpkg, paket betiklerini ve yardımcı programları PATH'te arar; önek her zaman başta olsun
case ":$PATH:" in
    *":$prefix/bin:"*) ;;
    *) PATH="$prefix/bin:$PATH" ;;
esac
export PATH
# shellcheck disable=SC2086
exec "$bin/$NAME.mio-real" $apt_opts "$@"
MIO_EOF
    sed -e "s|@@NAME@@|$name|g" -e "s|@@PREFIX@@|$PREFIX|g" "$wrapper" > "$wrapper.tmp" 2>/dev/null && mv "$wrapper.tmp" "$wrapper"
    chmod 755 "$wrapper" 2>/dev/null
    printf 'mio: %s sarmalayıcısı kuruldu\n' "$name"
}

install_apt_wrappers() {
    install_apt_wrapper pkg
    install_apt_wrapper apt
    install_apt_wrapper apt-get
    return 0
}

install_pkg_wrapper() {
    install_apt_wrappers
}

fix_sources() {
    apt_dir="$PREFIX/etc/apt"
    sources="$apt_dir/sources.list"
    [ -d "$apt_dir" ] || return 0

    # Ne olduğu önemli değil: dosya değilse (klasör, symlink, fifo...) ya da okunamıyorsa yeniden yaz
    broken=0
    if [ -L "$sources" ]; then
        broken=1
    elif [ -e "$sources" ] && [ ! -f "$sources" ]; then
        broken=1
    elif [ -f "$sources" ] && [ ! -r "$sources" ]; then
        broken=1
    elif [ -f "$sources" ] && [ ! -s "$sources" ]; then
        broken=1
    elif [ ! -e "$sources" ]; then
        broken=1
    fi

    if [ "$broken" -eq 1 ]; then
        printf 'mio: bozuk sources.list onarılıyor...\n'
        found=""
        if [ -d "$sources" ]; then
            for candidate in "$sources"/*; do
                [ -f "$candidate" ] || continue
                case "$candidate" in
                    *sources.list*) found="$candidate"; break ;;
                esac
            done
        fi
        tmp="$apt_dir/sources.list.mio-tmp"
        rm -f "$tmp" 2>/dev/null
        if [ -n "$found" ]; then
            cp "$found" "$tmp" 2>/dev/null
        fi
        if [ ! -s "$tmp" ]; then
            printf 'deb https://packages-cf.termux.dev/apt/termux-main stable main\n' > "$tmp"
        fi
        rm -rf "$sources" 2>/dev/null
        mv "$tmp" "$sources" 2>/dev/null
        chmod 644 "$sources" 2>/dev/null
        printf 'mio: sources.list dosyası yeniden oluşturuldu:\n'
        sed 's/^/  /' "$sources" 2>/dev/null
    fi

    # sources.list.d içinde dosya olmayan girdiler apt'yi bozar
    if [ -d "$apt_dir/sources.list.d" ]; then
        for entry in "$apt_dir/sources.list.d"/*; do
            [ -e "$entry" ] || continue
            if [ -L "$entry" ] || { [ -d "$entry" ]; }; then
                printf 'mio: bozuk depo girdisi siliniyor: %s\n' "$entry"
                rm -rf "$entry" 2>/dev/null
            fi
        done
    fi

    install_apt_wrappers
    install_change_repo_replacement
    if [ "${MIO_NO_APT_CONFIG:-0}" != "1" ]; then
        MIO_NO_APT_CONFIG=1 ensure_apt_config
    fi
    return 0
}

run_am() {
    if [ -x "$PREFIX/bin/termux-am" ]; then
        "$PREFIX/bin/termux-am" "$@" 2>/dev/null && return 0
    fi
    if command -v termux-am >/dev/null 2>&1; then
        termux-am "$@" 2>/dev/null && return 0
    fi
    if [ -x /system/bin/am ]; then
        /system/bin/am "$@" >/dev/null 2>&1 && return 0
    fi
    return 1
}

send_command() {
    # `am` prints "Broadcast completed" when the broadcast really reached the app
    out=$(run_am broadcast "$@" 2>&1)
    case "$out" in
        *"Broadcast completed"*) return 0 ;;
    esac
    if [ -n "$out" ] && ! printf '%s' "$out" | grep -qi "security\|denied\|exception"; then
        return 0
    fi
    if run_am startservice -n com.mio/com.termux.app.TermuxService "$@" >/dev/null 2>&1; then
        return 0
    fi
    # Son çare: niyeti doğrudan etkinliğe gönder (bazı Android sürümleri am broadcast/startservice'i
    # kısıtlar, ama etkinlik başlatma izinli olduğu için komut yine de iletilir)
    run_am start -n com.mio/com.termux.app.TermuxActivity "$@" >/dev/null 2>&1
}

write_request() {
    mkdir -p "$REQUEST_DIR" 2>/dev/null
    {
        printf 'created=%s\n' "$(date +%s 2>/dev/null || echo 0)"
        printf '%s\n' "$@"
    } > "$REQUEST_FILE" 2>/dev/null
}

# Komutu çalıştır: $1 eylem, kalanı --es anahtar değer çiftleri
# Önce yayın denenir; olmazsa istek dosyası yazılır ve uygulama servisi dosyayı görüp komutu
# kendisi çalıştırır (am bazı cihazlarda kabuk kullanıcısına kapalı olabiliyor).
send() {
    action="$1"
    shift

    # --es mode up --es size 20 ... -> "mode up size 20" (uygulama istek dosyasından okur)
    args=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --es|--ei|--ez|--el)
                if [ $# -ge 3 ]; then
                    args="$args${args:+ }$2 $3"
                    shift 3
                else
                    shift
                fi
                ;;
            *) shift ;;
        esac
    done

    if [ -n "$args" ]; then
        write_request "command=mio" "action=$action" "args=$args"
    else
        write_request "command=mio" "action=$action"
    fi

    if send_command -a "$action" "$@"; then
        return 0
    fi

    # `am` çıktısı güvenilir değil: başarılı olsa bile bazen "Broadcast completed" yazmıyor.
    # Uygulama isteği aldığında dosyayı siliyor, o yüzden dosyanın YOK olması komutun ulaştığı anlamına
    # gelir (eskiden bu durum yanlışlıkla "iletilemedi" diye raporlanıyordu).
    if [ ! -f "$REQUEST_FILE" ]; then
        return 0
    fi

    # Dosya hâlâ duruyor: yayın engellenmiş olabilir, ama uygulama açıkken 600 ms'de bir yokluyor.
    sleep 1 2>/dev/null || sleep 1
    if [ ! -f "$REQUEST_FILE" ]; then
        return 0
    fi
    printf 'mio: komut uygulamaya iletilemedi (yayın engellendi), istek dosyasına yazıldı: %s\n' "$REQUEST_FILE"
    printf 'mio: uygulama açıkken bu dosya 600 ms içinde okunur; menü açılmazsa uygulamayı bir kez aç.\n'
    return 0
}

