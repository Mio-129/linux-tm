pkg_log() {
    dir=$(pkg_find "$1") || {
        printf 'mio: paket bulunamadı: %s\n' "$1" >&2
        return 1
    }
    name=${dir##*/}
    log="$PKG_LOG_DIR/$name.log"
    if [ ! -f "$log" ]; then
        printf 'mio: %s için günlük yok, önce "mio paket kur %s" çalıştır.\n' "$name" "$name"
        return 1
    fi
    cat "$log"
}

# ---------------------------------------------------------------------------------------------
# Terminal menüsü: ~/.mio/menu.d/*.menu dosyaları
# Her satır:  etiket|komut        (# ile başlayan satırlar açıklama)
# ---------------------------------------------------------------------------------------------
MENU_DIR="$HOME/.mio/menu.d"

menu_run() {
    mkdir -p "$MENU_DIR" 2>/dev/null
    if [ ! -f "$MENU_DIR/varsayilan.menu" ]; then
        cat > "$MENU_DIR/varsayilan.menu" <<'MIO_EOF'
# Mio terminal menüsü — her satır: etiket|komut
Kar animasyonu|mio kar
Parçacık animasyonu|mio parcacik
Yazı boyutu +|mio yazi +
Yazı boyutu -|mio yazi -
Matrix teması|mio tema matrix
Tam ekran|mio tam ekran
Ses açma tuşu menüsü|mio ses
Paketleri listele|mio paket
Paketleri güncelle|mio paket guncelle
Yedek al|cd ~ && tar -czf ~/termux-yedek-$(date +%Y%m%d-%H%M).tar.gz -C /data/data/com.mio/files home usr
Depo değiştir|termux-change-repo
Teşhis|mio teshis
MIO_EOF
    fi

    n=0
    labels=""
    commands=""
    files=""
    for file in "$MENU_DIR"/*.menu "$MENU_DIR"/*.d/*.menu; do
        [ -f "$file" ] || continue
        files="$files $file"
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ''|'#'*) continue ;;
            esac
            label=${line%%|*}
            command=${line#*|}
            [ "$label" = "$line" ] && continue
            n=$((n + 1))
            labels="$labels$n) $label
"
            commands="$commands$command
"
        done < "$file"
    done

    if [ "$n" -eq 0 ]; then
        printf 'Menü boş: %s\n' "$MENU_DIR"
        return 1
    fi

    printf 'Mio terminal menüsü (%s)\n' "$MENU_DIR"
    printf '%s' "$labels"
    printf '0) Çıkış\n'
    printf 'Seçim: '
    read -r choice || return 1
    [ "$choice" = "0" ] && return 0
    case "$choice" in
        ''|*[!0-9]*) printf 'Geçersiz seçim.\n' >&2; return 2 ;;
    esac

    selected=$(printf '%s' "$commands" | sed -n "${choice}p")
    if [ -z "$selected" ]; then
        printf 'Geçersiz seçim.\n' >&2
        return 2
    fi
    printf '> %s\n' "$selected"
    # shellcheck disable=SC2086
    sh -c "$selected"
}

menu_list() {
    mkdir -p "$MENU_DIR" 2>/dev/null
    if [ -z "$(ls -A "$MENU_DIR" 2>/dev/null)" ]; then
        printf 'Menü yok: %s\n' "$MENU_DIR"
        return 1
    fi
    for file in "$MENU_DIR"/*.menu; do
        [ -f "$file" ] || continue
        printf '%s:\n' "${file##*/}"
        grep -v '^#' "$file" 2>/dev/null | grep -v '^$' | sed 's/^/  /'
    done
}

if [ $# -eq 0 ]; then
    send "$ACTION_MENU"
    exit $?
fi

COMMAND="$1"
shift

# Önek dizinlerinin iznini ONARIMDAN ÖNCE ölç: fix_sources -> install_apt_wrappers ->
# mio_fix_prefix_perms zinciri izinleri düzeltiyor, bu yüzden ölçüm burada yapılmalı.
MIO_PREFIX_RO=0
for _pd in "$PREFIX/share" "$PREFIX/bin" "$PREFIX/lib" "$PREFIX/etc" "$PREFIX/var" "$PREFIX/tmp"; do
    [ -d "$_pd" ] || continue
    [ -w "$_pd" ] || MIO_PREFIX_RO=$((MIO_PREFIX_RO + 1))
done
export MIO_PREFIX_RO

# Her komuttan önce depo dosyasını doğrula/onar: bozuksa pkg ve apt hiç çalışmaz.
# Ancak deb-cevir (dpkg-deb içinden çalışır), yardım ve sürüm komutlarında atla:
# özellikle dpkg çalışırken mio_repair_dpkg_db tetiklenirse updates/tmp.i silinir.
case "$COMMAND" in
    -h|--help|help|yardim|yardım|-v|--version|version|surum|sürüm|deb-cevir|debcevir|convert-deb|resolve-deps)
        : ;;
    *)
        if [ "${MIO_DEB_CONVERTING:-0}" != "1" ] && [ "${MIO_DPKG_RUNNING:-0}" != "1" ] && [ -d "${PREFIX:-}/etc/apt" ]; then
            fix_sources >/dev/null 2>&1
        fi
        ;;
esac

case "$COMMAND" in
    -h|--help|help|yardim|yardım)
        usage
        exit 0
        ;;
    -v|--version|version|surum|sürüm)
        app_version=$(sed -n '1s/^v//p' /data/data/com.mio/files/.mio-commands-version 2>/dev/null)
        printf 'mio sürüm: 44 (uygulama: %s)\n' "${app_version:-bilinmiyor}"
        exit 0
        ;;
    resolve-deps)
        mio_resolve_install_deps "$@"
        exit $?
        ;;
    deps-upgrade|bagimlilik|bağımlılık|bagimliliklar|bağımlılıklar)
        mio_deps_upgrade
        exit $?
        ;;
    elf-fix|so-fix)
        _ef=$(mio_repair_elf_libs)
        printf 'mio: %s ELF/.so dosyası com.mio yollarına yamalandı.\n' "${_ef:-0}"
        exit 0
        ;;
    gui|panel|pencere)
        send "$ACTION_MENU"
        exit $?
        ;;
    kar|snow|kay)
        send "$ACTION_ANIMATION" --es mode snow
        exit $?
        ;;
    parcacik|parçacık|particle|particles|partikul)
        send "$ACTION_ANIMATION" --es mode particles
        exit $?
        ;;
    animasyon|anim|stop|durdur)
        send "$ACTION_ANIMATION" --es mode off
        exit $?
        ;;
    yazi|yazı|font)
        if [ $# -eq 0 ]; then
            send "$ACTION_FONT_SIZE" --es mode status
            exit $?
        fi
        case "$1" in
            +|buyut|büyüt|up)
                send "$ACTION_FONT_SIZE" --es mode increase
                ;;
            -|kucult|küçült|down)
                send "$ACTION_FONT_SIZE" --es mode decrease
                ;;
