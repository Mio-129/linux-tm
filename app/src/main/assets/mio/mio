# ---------------------------------------------------------------------------------------------
# Paketler: ~/.mio/pkgs/<paket> içindeki *.a.sh, *.b.sh ve *.start-up.sh betikleri
# ---------------------------------------------------------------------------------------------
PKG_DIR="$HOME/.mio/pkgs"
PKG_STATE_DIR="$HOME/.mio/state"
PKG_LOG_DIR="$HOME/.mio/log"

pkg_find() {
    # Paket klasörünü bul: tam ad, sonra büyük/küçük harf duyarsız
    for dir in "$PKG_DIR"/*; do
        [ -d "$dir" ] || continue
        name=${dir##*/}
        if [ "$name" = "$1" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
    done
    for dir in "$PKG_DIR"/*; do
        [ -d "$dir" ] || continue
        name=${dir##*/}
        lower_name=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')
        lower_arg=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
        if [ "$lower_name" = "$lower_arg" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
    done
    return 1
}

pkg_installed_version() {
    file="$PKG_STATE_DIR/$1.installed"
    [ -f "$file" ] && head -n 1 "$file"
}

pkg_version() {
    file="$PKG_DIR/$1/VERSION"
    [ -f "$file" ] && head -n 1 "$file"
}

pkg_is_enabled() {
    [ ! -f "$PKG_STATE_DIR/$1.disabled" ]
}

pkg_has_update() {
    installed=$(pkg_installed_version "$1")
    version=$(pkg_version "$1")
    [ -z "$installed" ] && return 0
    [ -z "$version" ] && return 1
    [ "$installed" != "$version" ]
}

pkg_list() {
    mkdir -p "$PKG_DIR" "$PKG_STATE_DIR" "$PKG_LOG_DIR" 2>/dev/null
    if [ -z "$(ls -A "$PKG_DIR" 2>/dev/null)" ]; then
        printf 'Paket yok. Klasör: %s\n' "$PKG_DIR"
        printf 'Örnek oluşturmak için: mio paket sifirla\n'
        return 0
    fi
    printf 'Paketler (%s):\n' "$PKG_DIR"
    for dir in "$PKG_DIR"/*; do
        [ -d "$dir" ] || continue
        name=${dir##*/}
        installed=$(pkg_installed_version "$name")
        version=$(pkg_version "$name")
        state="kurulmadı"
        if [ -n "$installed" ]; then
            state="kurulu v$installed"
            if [ -n "$version" ] && [ "$installed" != "$version" ]; then
                state="kurulu v$installed (güncelleme: v$version)"
            fi
        fi
        pkg_is_enabled "$name" || state="$state • kapalı"
        [ -f "$dir/URL" ] && state="$state • uzaktan"
        printf '  %-20s %s\n' "$name" "$state"
        for script in "$dir"/*.sh; do
            [ -f "$script" ] || continue
            printf '      %s\n' "${script##*/}"
        done
    done
}

# Paketin URL dosyası varsa uzak betiği çalıştırır (bash <(curl -s URL))
pkg_url() {
    file="$PKG_DIR/$1/URL"
    [ -f "$file" ] && head -n 1 "$file" | tr -d '\r'
}

pkg_install_remote() {
    fix_sources
    dir=$(pkg_find "$1") || {
        printf 'mio: paket bulunamadı: %s\n' "$1" >&2
        return 1
    }
    name=${dir##*/}
    url=$(pkg_url "$name")
    if [ -z "$url" ]; then
        return 2
    fi
    mkdir -p "$PKG_STATE_DIR" 2>/dev/null
    printf 'Paket kuruluyor (uzaktan): %s\nKaynak: %s\n' "$name" "$url"
    printf '> bash <(curl -s %s)\n' "$url"

    if ! command -v curl >/dev/null 2>&1; then
        printf 'mio: curl kuruluyor...\n'
        pkg install -y curl >/dev/null 2>&1 || {
            printf 'mio: curl kurulamadı.\n' >&2
            return 1
        }
    fi

    # Betik indirilip çalıştırılır; boru yerine dosya kullanılıyor ki çıkış kodu doğru olsun
    script="$HOME/.mio/tmp-remote-$$.sh"
    if ! curl -fsSL "$url" -o "$script"; then
        printf 'mio: betik indirilemedi: %s\n' "$url" >&2
        rm -f "$script"
        return 1
    fi

    bash "$script"
    status=$?
    rm -f "$script"

    if [ $status -ne 0 ]; then
        printf 'mio: betik hata verdi (çıkış kodu %s), paket kurulmadı.\n' "$status" >&2
        return $status
    fi

    version=$(pkg_version "$name")
    printf '%s\n' "${version:-1}" > "$PKG_STATE_DIR/$name.installed"
    printf 'Paket kuruldu: %s%s\n' "$name" "${version:+ (v$version)}"
    return 0
}

pkg_install() {
    fix_sources
    dir=$(pkg_find "$1") || {
        printf 'mio: paket bulunamadı: %s\n' "$1" >&2
        printf 'Klasör: %s\n' "$PKG_DIR" >&2
        return 1
    }
    name=${dir##*/}
    url=$(pkg_url "$name")
    if [ -n "$url" ]; then
        pkg_install_remote "$name"
        return $?
    fi

    mkdir -p "$PKG_STATE_DIR" "$PKG_LOG_DIR" 2>/dev/null
    log="$PKG_LOG_DIR/$name.log"

    printf 'Paket kuruluyor: %s\n' "$name"
    {
        printf '# %s — %s\n' "$name" "$(date 2>/dev/null)"
    } > "$log"

    # Ortak harf sırası: .a.sh, .b.sh, .c.sh, .d.sh, .e.sh
    for letter in a b c d e; do
        for script in "$dir"/*.$letter.sh; do
            [ -f "$script" ] || continue
            printf '\n>>> %s\n' "${script##*/}" >> "$log"
            printf '\n>>> %s\n' "${script##*/}"

            # Çıkış kodu borudan değil, doğrudan betikten alınmalı, yoksa tee'nin koduna bakılır
            ( cd "$dir" && sh "$script" ) > "$PKG_LOG_DIR/.last-run" 2>&1
            status=$?
            cat "$PKG_LOG_DIR/.last-run" >> "$log"
            cat "$PKG_LOG_DIR/.last-run"
            rm -f "$PKG_LOG_DIR/.last-run"

            if [ $status -ne 0 ]; then
                printf 'mio: %s betiği hata verdi (çıkış kodu %s), paket kurulmadı.\n' \
                    "${script##*/}" "$status" >&2
                printf 'Sonraki aşama (.b.sh) çalıştırılmadı. Günlük: %s\n' "$log" >&2
                return $status
            fi
        done
    done

    version=$(pkg_version "$name")
    printf '%s\n' "${version:-1}" > "$PKG_STATE_DIR/$name.installed"
    printf 'Paket kuruldu: %s%s\n' "$name" "${version:+ (v$version)}"
    [ -f "$dir"/*.start-up.sh ] 2>/dev/null && printf 'start-up betiği bir sonraki açılışta çalışacak.\n'
    return 0
}

pkg_update_all() {
    found=0
    status=0
    for dir in "$PKG_DIR"/*; do
        [ -d "$dir" ] || continue
        name=${dir##*/}
        if pkg_has_update "$name"; then
            found=1
            pkg_install "$name" || status=1
        fi
    done
    [ $found -eq 0 ] && printf 'Güncellenecek paket yok.\n'
    return $status
}

pkg_startup_all() {
    status=0
    for dir in "$PKG_DIR"/*; do
        [ -d "$dir" ] || continue
        name=${dir##*/}
        [ -f "$PKG_STATE_DIR/$name.installed" ] || continue
        pkg_is_enabled "$name" || continue
        for script in "$dir"/*.start-up.sh; do
            [ -f "$script" ] || continue
            printf '>>> %s / %s\n' "$name" "${script##*/}"
            ( cd "$dir" && sh "$script" ) || status=1
        done
    done
    return $status
}

pkg_create_template() {
    mkdir -p "$PKG_DIR/Older-Pack" 2>/dev/null || return 1
    dir="$PKG_DIR/Older-Pack"
    if [ ! -f "$dir/Older-Pack.a.sh" ]; then
        cat > "$dir/Older-Pack.a.sh" <<'MIO_EOF'
