    cat <<EOF
Kullanım: mio [komut]

  mio                     Menüyü açar (arka plan, animasyon, yazı boyutu, renkler, tam ekran...)
  mio kay                 Kar animasyonunu açar/kapatır.
  mio parcacik            Parçacık animasyonunu açar/kapatır.
  mio yazi +|-            Yazı boyutunu büyütür/küçültür.
  mio yazi <sayı>         Yazı boyutunu ayarlar, örnek: mio yazi 14
  mio tema <ad>           Hazır tema uygular: varsayilan, matrix, gece, mor, sicak
  mio renk <ad> <#RRGGBB> Tek rengi değiştirir, örnek: mio renk foreground #00FF66
  mio tam ekran           Tam ekranı açar/kapatır.
  mio ses                 Ses tuşlarını medya sesi <-> terminal kısayolu yapar.
  mio ses +|-             Medya sesini arttırır/azaltır.
  mio paket               Paketleri listeler (~/.mio/pkgs/<paket>).
  mio paket kur <ad>      Paketin .a.sh, .b.sh ve .start-up.sh betiklerini çalıştırır.
  mio paket guncelle      Güncellenebilir tüm paketleri kurar.
  mio paket baslat        Kurulu paketlerin .start-up.sh betiklerini çalıştırır.
  mio paket sifirla       Örnek paketi (Older-Pack) oluşturur.
  mio paket log <ad>      Paketin son çalıştırma günlüğünü gösterir.
  mio apt-fix             apt/dpkg sorunlarını onarır, test eder, en hızlı depoyu seçer
  mio depo hizli          Depoları ölçüp en hızlısını seçer
  mio teshis              Komutların kurulu olup olmadığını ve sürümünü gösterir.
  mio menuler             Yan menüleri gösterir/gizler.
  mio oturum              Yeni oturum açar.
  mio ses + | -           Medya sesini artırır/azaltır.
  mio yardim              Bu yardımı gösterir.

Arka plan medyası (fotoğraf/video):  swset <dosya>   swset off
Videonun sesi:                       so   so off   so stop
EOF
}


# ---------------------------------------------------------------------------------------------
# apt depoları: sources.list bir dosya olmalı. Bozuk kurulumlarda klasör olarak kalabiliyor
# ("E: Read error - read (21: Is a directory)"), bu yüzden pkg'den önce onarılır.


# ---------------------------------------------------------------------------------------------
# apt yapılandırmasını sabitle
#
# Ekran çıktısındaki iki satır birlikte geliyor:
#   N: Ignoring file 'sources.list' in directory '.../etc/apt' as it has an invalid filename extension
#   E: Read error - read (21: Is a directory)
# Yani apt, `.../etc/apt` klasörünü "sourceparts" dizini sanıp içindeki sources.list'i arıyor.
# Çözüm: yolları apt.conf.d içinde açıkça sabitlemek ve geçerli bir `*.list` dosyası bırakmak.
# ---------------------------------------------------------------------------------------------
ensure_apt_config() {
    apt_dir="$PREFIX/etc/apt"
    sources="$apt_dir/sources.list"
    parts="$apt_dir/sources.list.d"
    conf_dir="$apt_dir/apt.conf.d"
    mkdir -p "$apt_dir" "$parts" "$conf_dir" 2>/dev/null

    # 1) sources.list her zaman normal bir dosya
    if [ -L "$sources" ] || { [ -e "$sources" ] && [ ! -f "$sources" ]; } || { [ -f "$sources" ] && [ ! -s "$sources" ]; }; then
        fix_sources >/dev/null 2>&1
    fi

    # 2) sourceparts gerçekten bir klasör olmalı; apt onu "sourceparts" olarak okuyor.
    #    Symlink kendini gösteriyorsa (ör. -> ..) apt "Ignoring file 'sources.list'" der.
    if [ -L "$parts" ]; then
        rm -f "$parts" 2>/dev/null
        mkdir -p "$parts" 2>/dev/null
    elif [ -e "$parts" ] && [ ! -d "$parts" ]; then
        rm -rf "$parts" 2>/dev/null
        mkdir -p "$parts" 2>/dev/null
    fi

    # 2b) sources.list içinde birden fazla `deb` satırı varsa ilkini bırak (yavaş ayna kalmasın)
    if [ -f "$sources" ]; then
        deb_count=$(grep -c '^deb ' "$sources" 2>/dev/null || true)
        [ -n "$deb_count" ] || deb_count=0
        if [ "$deb_count" -gt 1 ]; then
            first_url=$(grep '^deb ' "$sources" 2>/dev/null | head -n 1 | awk '{print $2}')
            if [ -n "$first_url" ]; then
                printf '# %s tarafından yazıldı\ndeb %s stable main\n' "mio" "$first_url" > "$sources.tmp" 2>/dev/null &&
                    mv "$sources.tmp" "$sources" 2>/dev/null
            fi
        fi
    fi

    # 3) sources.list.d içinde AYNI depoyu tekrar eden dosya bırakma: apt
    #    "Target Packages is configured multiple times" uyarısı veriyor
    for dup in "$parts"/*.list; do
        [ -f "$dup" ] || continue
        case "$(basename "$dup")" in
            mio.list|main.list) rm -f "$dup" 2>/dev/null ;;
        esac
    done

    # 3b) apt.conf.d içinde kaynak yollarını bozan artıkları kaldır.
    #     Bir dosya `sources.list` geçiyor ama doğru `Dir::Etc::` anahtarını kullanmıyorsa (ör. yanlış
    #     yazılmış `Dir::Etc "sources.list";`), apt yolu klasör olarak çözer ve ekrandaki hatayı verir.
    if [ -d "$conf_dir" ]; then
        for f in "$conf_dir"/*; do
            [ -f "$f" ] || continue
            base=$(basename "$f")
            [ "$base" = "zz-mio-sources.conf" ] && continue
            if grep -q "sources\.list" "$f" 2>/dev/null && ! grep -q "Dir::Etc::sourcelist" "$f" 2>/dev/null; then
                rm -f "$f" 2>/dev/null && printf 'mio: bozuk apt yapılandırması silindi: %s\n' "$f" >&2
            fi
        done
    fi

    # 3c) apt indirme yöntemleri çalıştırılabilir olmalı, yoksa "Failed to exec method ... https"
    methods="$PREFIX/lib/apt/methods"
    if [ -d "$methods" ]; then
        for m in "$methods"/*; do
            [ -f "$m" ] || continue
            [ -x "$m" ] || chmod 755 "$m" 2>/dev/null
        done
    fi

    # 3d) apt'nin çalışma klasörleri (yoksa "List directory .../var/lib/apt is missing")
    for d in "$PREFIX/var/lib/apt/lists/partial" "$PREFIX/var/cache/apt/archives/partial" \
             "$PREFIX/var/lib/dpkg" "$PREFIX/var/log/apt" "$PREFIX/etc/apt/trusted.gpg.d" \
             "$PREFIX/tmp"; do
        [ -d "$d" ] || mkdir -p "$d" 2>/dev/null
    done
    [ -f "$PREFIX/var/lib/dpkg/status" ] || : > "$PREFIX/var/lib/dpkg/status" 2>/dev/null

    # 4) yolları sabitle (bu dosya apt tarafından her zaman okunur, atomik yazılır)
    conf="$conf_dir/zz-mio-sources.conf"
    {
        printf '# mio: pin the apt source locations\n'
        printf 'Dir::Etc::sourcelist "%s";\n' "$sources"
        printf 'Dir::Etc::sourceparts "%s";\n' "$parts"
    } > "$conf.tmp" 2>/dev/null
    if [ -s "$conf.tmp" ]; then
        mv "$conf.tmp" "$conf" 2>/dev/null
        chmod 644 "$conf" 2>/dev/null
    fi

    # 5) `pkg` kendi argüman ayrıştırıcısını kullandığı için `-o` geçemiyor; aynı yollar APT_CONFIG
    #    ile dayatılır (apt bu dosyayı her çağrıda okur)
    apc="$conf_dir/mio-apt.conf"
    {
        printf '# mio: apt yolları (APT_CONFIG)\n'
        printf 'Dir::Etc "%s/etc/apt";\n' "$PREFIX"
        printf 'Dir::Etc::sourcelist "%s";\n' "$sources"
        printf 'Dir::Etc::sourceparts "%s";\n' "$parts"
        printf 'Dir::Etc::trusted "%s/etc/apt/trusted.gpg";\n' "$PREFIX"
        printf 'Dir::Etc::trustedparts "%s/etc/apt/trusted.gpg.d";\n' "$PREFIX"
        printf 'Dir::State "%s/var/lib/apt";\n' "$PREFIX"
        printf 'Dir::State::lists "%s/var/lib/apt/lists";\n' "$PREFIX"
        printf 'Dir::State::status "%s/var/lib/dpkg/status";\n' "$PREFIX"
        printf 'Dir::Cache "%s/var/cache/apt";\n' "$PREFIX"
        printf 'Dir::Cache::archives "%s/var/cache/apt/archives";\n' "$PREFIX"
        printf 'Dir::Log "%s/var/log/apt";\n' "$PREFIX"
        printf 'Dir::Bin::methods "%s/lib/apt/methods";\n' "$PREFIX"
        printf 'Dir::State::extended_states "%s/var/lib/apt/extended_states";\n' "$PREFIX"
        printf 'DPkg::Path "%s/bin:/system/bin:/system/xbin";\n' "$PREFIX"
        printf 'Acquire::ForceIPv4 "true";\n'
        printf 'Acquire::Languages "none";\n'
    } > "$apc.tmp" 2>/dev/null
    if [ -s "$apc.tmp" ]; then
        mv "$apc.tmp" "$apc" 2>/dev/null
        chmod 644 "$apc" 2>/dev/null
    fi
    return 0
}

# ---------------------------------------------------------------------------------------------
# Teşhis: sources.list dosyasının gerçek durumu (klasör/symlink/boş/izin)
# ---------------------------------------------------------------------------------------------
sources_report() {
    sources="$PREFIX/etc/apt/sources.list"
    printf 'Dizin: %s\n' "$PREFIX/etc/apt"
    if [ -L "$sources" ]; then
        printf 'sources.list: SYMLINK -> %s\n' "$(readlink "$sources" 2>/dev/null)"
    elif [ -d "$sources" ]; then
        printf 'sources.list: KLASÖR (bozuk)\n'
        ls -la "$sources" 2>/dev/null | sed 's/^/  /'
    elif [ -f "$sources" ]; then
        if [ -s "$sources" ]; then
            printf 'sources.list: DOSYA, %s bayt (ok)\n' "$(wc -c < "$sources" 2>/dev/null | tr -d ' ')"
            sed 's/^/  /' "$sources" 2>/dev/null
        else
            printf 'sources.list: DOSYA ama BOŞ (bozuk)\n'
        fi
    elif [ -e "$sources" ]; then
        printf 'sources.list: başka bir tür (bozuk)\n'
    else
        printf 'sources.list: YOK\n'
    fi

    printf 'pkg: '
    if [ -f "$PREFIX/bin/pkg.mio-real" ]; then printf 'sarmalayıcı kurulu\n'; else printf 'sarmalayıcı YOK\n'; fi
    printf 'apt: '
    if [ -f "$PREFIX/bin/apt.mio-real" ]; then printf 'sarmalayıcı kurulu\n'; else printf 'sarmalayıcı YOK\n'; fi
    printf 'apt-get: '
    if [ -f "$PREFIX/bin/apt-get.mio-real" ]; then printf 'sarmalayıcı kurulu\n'; else printf 'sarmalayıcı YOK\n'; fi
    printf 'termux-change-repo: '
    if grep -q "mio guvenli surum" "$PREFIX/bin/termux-change-repo" 2>/dev/null; then
        printf 'güvenli sürüm\n'
    else
        printf 'ORİJİNAL (depoyu bozabilir)\n'
    fi
    printf 'sources.list.d: '
    if [ -d "$PREFIX/etc/apt/sources.list.d" ]; then
        printf 'klasör (ok), %s dosya\n' "$(ls -1 "$PREFIX/etc/apt/sources.list.d" 2>/dev/null | wc -l | tr -d ' ')"
        ls -l "$PREFIX/etc/apt/sources.list.d" 2>/dev/null | sed 's/^/  /'
    else
        printf 'YOK (bozuk)\n'
    fi
    printf 'apt.conf.d/zz-mio-sources.conf: '
    if [ -f "$PREFIX/etc/apt/apt.conf.d/zz-mio-sources.conf" ]; then
        printf 'var\n'
        sed 's/^/  /' "$PREFIX/etc/apt/apt.conf.d/zz-mio-sources.conf" 2>/dev/null
    else
        printf 'YOK\n'
    fi
    printf 'apt.conf.d/ diğer dosyalar: '
    if [ -d "$PREFIX/etc/apt/apt.conf.d" ]; then
        printf '%s\n' "$(ls -1 "$PREFIX/etc/apt/apt.conf.d" 2>/dev/null | tr '\n' ' ')"
    else
        printf 'klasör YOK\n'
    fi

    # apt.conf.d içindeki her dosyayı tek tek dene: hata veren dosya adını yaz
    if [ -d "$PREFIX/etc/apt/apt.conf.d" ]; then
        printf 'apt.conf.d taraması: '
        bad=""
        for f in "$PREFIX/etc/apt/apt.conf.d"/*; do
            [ -f "$f" ] || continue
            if grep -q "sources.list" "$f" 2>/dev/null && ! grep -q "Dir::Etc::sourcelist" "$f" 2>/dev/null; then
                bad="$bad $f"
            fi
        done
        if [ -n "$bad" ]; then
            printf 'ŞÜPHELİ:%s\n' "$bad"
        else
            printf 'sorun görünmüyor\n'
        fi
    fi
    printf 'etc/apt içeriği:\n'
    ls -la "$PREFIX/etc/apt" 2>/dev/null | sed 's/^/  /'

    # Gerçek apt'ye sor: hangi dosyaları kaynak olarak görüyor?
    apt_bin=""
    for candidate in "$PREFIX/bin/apt" "$PREFIX/bin/apt-get"; do
        [ -f "$candidate" ] || continue
        apt_bin="$candidate"
        break
    done
    printf '\napt çalışma klasörleri:\n'
    for d in "$PREFIX/var/lib/apt/lists/partial" "$PREFIX/var/cache/apt/archives/partial" \
             "$PREFIX/var/lib/dpkg" "$PREFIX/tmp"; do
        if [ -d "$d" ]; then printf '  VAR   %s\n' "$d"; else printf '  YOK   %s (bozuk)\n' "$d"; fi
    done
    printf 'APT_CONFIG dosyası: %s\n' "$PREFIX/etc/apt/apt.conf.d/mio-apt.conf"
    if [ -f "$PREFIX/etc/apt/apt.conf.d/mio-apt.conf" ]; then
        sed 's/^/  /' "$PREFIX/etc/apt/apt.conf.d/mio-apt.conf" 2>/dev/null
    else
        printf '  YOK\n'
    fi

    printf '\napt methods (lib/apt/methods): '
    if [ -d "$PREFIX/lib/apt/methods" ]; then
        broken_m=""
        for m in "$PREFIX/lib/apt/methods"/*; do
            [ -f "$m" ] || continue
            [ -x "$m" ] || broken_m="$broken_m $(basename "$m")"
        done
        if [ -n "$broken_m" ]; then
            printf 'ÇALIŞTIRILAMIYOR:%s\n' "$broken_m"
        else
            printf 'tamam\n'
        fi
        ls -l "$PREFIX/lib/apt/methods" 2>/dev/null | sed 's/^/  /'
    else
        printf 'klasör YOK\n'
    fi

    printf '\napt kaynak yapılandırması (apt-config dump):\n'
    if [ -n "$apt_bin" ]; then
        cfg_out=$(apt-config dump 2>/dev/null | grep -a -i "^Dir::Etc::source")
        if [ -n "$cfg_out" ]; then
            printf '%s\n' "$cfg_out" | sed 's/^/  /'
        else
            printf '  okunamadı (config dump desteklenmiyor)\n'
        fi
    else
        printf '  apt bulunamadı\n'
    fi

    printf 'methods tanılama (https):\n'
    hm="$PREFIX/lib/apt/methods/https"
    if [ -e "$hm" ]; then
        ls -l "$hm" 2>/dev/null | sed 's/^/  /'
        readlink -f "$hm" 2>/dev/null | sed 's/^/  hedef: /'
        if [ -x "$hm" ]; then printf '  çalıştırılabilir: evet\n'; else printf '  çalıştırılabilir: HAYIR\n'; fi
        ht=$("$PREFIX/lib/apt/methods/https" --version 2>&1 | head -n 3)
        hrc=$?
        if [ -n "$ht" ]; then
            printf '  çalıştırma denemesi (çıkış=%s):\n' "$hrc"
            printf '%s\n' "$ht" | sed 's/^/    /'
        else
            printf '  çalıştırma denemesi: çıktı yok, çıkış=%s\n' "$hrc"
        fi
    else
        printf '  %s YOK\n' "$hm"
    fi

    # NOT: burada `apt update` ÇALIŞTIRILMAZ. Ağa çıktığı için rapor dakikalarca asılı kalıyordu.

    printf '\nKurulu apt sürümü: '
    dpkg -s apt 2>/dev/null | sed -n 's/^Version: //p' | head -n 1
    printf '\n'
}

# ---------------------------------------------------------------------------------------------
# apt depoları onarımı
#
# `sources.list` bir DOSYA olmalı. Bozuk kurulumlarda klasör, symlink veya başka bir şey olarak
# kalabiliyor ve apt "E: Read error - read (21: Is a directory)" veriyor. `termux-change-repo`
# bazen bu bozuk girdiyi kendisi oluşturduğu için pkg'den hemen önce tekrar onarılır.
# ---------------------------------------------------------------------------------------------

# $PREFIX/bin/pkg sarmalayıcısı: her pkg çağrısından önce depoyu onarır


# `termux-change-repo` betiğini güvenli sürümümüzle değiştir: orijinali bu fork'ta sources.list'i
# bozuyor (klasör olarak kalıyor). Orijinal bir kez `.orj` olarak saklanır.
install_change_repo_replacement() {
    tool="$PREFIX/bin/termux-change-repo"
    backup="$PREFIX/bin/termux-change-repo.orj"
    [ -d "$PREFIX/bin" ] || return 0
    [ -f "$tool" ] || return 0

    if [ ! -f "$backup" ] && ! grep -q "mio guvenli surum" "$tool" 2>/dev/null; then
        cp "$tool" "$backup" 2>/dev/null
    fi

    cat > "$tool" <<'MIO_EOF'
#!/data/data/com.mio/files/usr/bin/sh
# mio guvenli surum: depo dosyasini atomik yazar, bozuk birakmaz
prefix="${PREFIX:-/data/data/com.mio/files/usr}"
[ -x "$prefix/bin/mio" ] || prefix=$(dirname "$(dirname "$0")")
exec "$prefix/bin/mio" depo sec "$@"
MIO_EOF
    chmod 755 "$tool" 2>/dev/null
}

# ---------------------------------------------------------------------------------------------
# Depo değiştirici (termux-change-repo yerine)
#
# Orijinal betik `sources.list`'i yeniden yazarken dosyayı bozuyor (klasör/symlink kalıyor) ve apt
# "E: Read error - read (21: Is a directory)" veriyor. Bu sürüm her zaman geçici bir dosyaya yazıp
# atomik olarak yerine koyar; bozuk bir girdi kalırsa tekrar dener.
# ---------------------------------------------------------------------------------------------
