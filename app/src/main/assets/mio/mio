#!/data/data/com.termux/files/usr/bin/sh
#
# mio - Termux'un bu çatalının (fork) menüsünü ve ayarlarını terminalden yönetir.
#
# Kullanım:
#   mio                     Menüyü aç
#   mio kay                 Kar animasyonunu aç/kapat
#   mio parcacik            Parçacık animasyonunu aç/kapat
#   mio yazi +              Yazı boyutunu büyüt
#   mio yazi -              Yazı boyutunu küçült
#   mio tema matrix         Hazır bir tema uygula
#   mio renk red #FF0000    Tek bir rengi değiştir
#   mio tam ekran           Tam ekranı aç/kapat
#   mio ses tuslari         Ses tuşlarını medya sesi / terminal kısayolu arasında değiştir
#   mio paket               Paketleri listeler (~/.mio/pkgs)
#   mio paket kur <ad>      Paketin .a.sh / .b.sh betiklerini sırayla çalıştırır
#   mio paket guncelle      Güncellenebilir tüm paketleri kurar
#   mio paket baslat        Kurulu paketlerin .start-up.sh betiklerini çalıştırır
#   mio paket sifirla       Örnek paketi (Older-Pack) oluşturur
#   mio teshis              Kurulu komutları ve sürümü kontrol eder (menü açılmıyorsa)
#   mio menuler             Yan menüleri aç/kapat
#   mio oturum              Yeni oturum aç
#   mio yardim              Bu yardımı gösterir
#
# Notlar:
#   * Komutlar uygulamanın kendi yayın alıcısına (broadcast) mesaj yollar, termux-api gerekmez.
#   * Ekran görüntüsü/medya komutları için: swset <dosya>, swset off, so, so off.

if [ -z "${PREFIX:-}" ]; then
    PREFIX=/data/data/com.termux/files/usr
fi

ACTION_MENU="com.termux.mio.action.MENU"
ACTION_ANIMATION="com.termux.mio.action.ANIMATION"
ACTION_FONT_SIZE="com.termux.mio.action.FONT_SIZE"
ACTION_COLORS="com.termux.mio.action.COLORS"
ACTION_FULLSCREEN="com.termux.mio.action.FULLSCREEN"
ACTION_SESSION="com.termux.mio.action.SESSION"
ACTION_STYLE="com.termux.mio.action.STYLE"
ACTION_VOLUME_KEYS="com.termux.mio.action.VOLUME_KEYS"

REQUEST_DIR="$HOME/.termux/mio"
REQUEST_FILE="$REQUEST_DIR/request"

usage() {
    cat <<EOF
Kullanım: mio [komut]

  mio                     Menüyü açar (arka plan, animasyon, yazı boyutu, renkler, tam ekran...)
  mio kay                 Kar animasyonunu açar/kapatır.
  mio parcacik            Parçacık animasyonunu açar/kapatır.
  mio yazi +|-            Yazı boyutunu büyütür/küçültür.
  mio yazi <sayı>         Yazı boyutunu ayarlar, örnek: mio yazi 14
  mio tema <ad>           Hazır tema uygular: varsayilan, matrix, gece, mor, sicak
  mio renk <ad> <#RRGGBB> Tek rengi değiştirir, örnek: mio renk foreground #00FF66
  mio tam ekran           Tam ekranı açar/kapatır.
  mio ses                 Ses tuşlarını medya sesi <-> terminal kısayolu yapar.
  mio ses +|-             Medya sesini arttırır/azaltır.
  mio paket               Paketleri listeler (~/.mio/pkgs/<paket>).
  mio paket kur <ad>      Paketin .a.sh, .b.sh ve .start-up.sh betiklerini çalıştırır.
  mio paket guncelle      Güncellenebilir tüm paketleri kurar.
  mio paket baslat        Kurulu paketlerin .start-up.sh betiklerini çalıştırır.
  mio paket sifirla       Örnek paketi (Older-Pack) oluşturur.
  mio paket log <ad>      Paketin son çalıştırma günlüğünü gösterir.
  mio teshis              Komutların kurulu olup olmadığını ve sürümünü gösterir.
  mio menuler             Yan menüleri gösterir/gizler.
  mio oturum              Yeni oturum açar.
  mio yardim              Bu yardımı gösterir.

Arka plan medyası (fotoğraf/video):  swset <dosya>   swset off
Videonun sesi:                       so   so off   so stop
EOF
}

run_am() {
    if [ -x "$PREFIX/bin/termux-am" ]; then
        "$PREFIX/bin/termux-am" "$@"
    elif command -v termux-am >/dev/null 2>&1; then
        termux-am "$@"
    else
        /system/bin/am "$@"
    fi
}

send_command() {
    if run_am broadcast "$@" >/dev/null 2>&1; then
        return 0
    fi
    run_am startservice -n com.mio/com.termux.app.TermuxService "$@" >/dev/null 2>&1
}

write_request() {
    mkdir -p "$REQUEST_DIR" 2>/dev/null
    {
        printf 'created=%s\n' "$(date +%s 2>/dev/null || echo 0)"
        printf '%s\n' "$@"
    } > "$REQUEST_FILE" 2>/dev/null
}

# Komutu çalıştır: $1 eylem, kalanı --es anahtar değer çiftleri
send() {
    action="$1"
    shift
    write_request "command=mio" "action=$action"
    if ! send_command -a "$action" "$@"; then
        printf 'mio: komut uygulamaya iletilemedi, Termux açık mı?\n' >&2
        return 1
    fi
    return 0
}

diagnose() {
    printf 'mio sürüm: 5 (menü, animasyon, yazı, renk, tam ekran, ses tuşları, paketler)\n'
    printf 'PREFIX: %s\n' "$PREFIX"
    printf 'HOME:   %s\n' "$HOME"
    printf '\nKurulu komutlar:\n'
    for cmd in swset so mio; do
        path="$PREFIX/bin/$cmd"
        if [ -x "$path" ]; then
            size=$(wc -c < "$path" 2>/dev/null | tr -d ' ')
            printf '  %-6s VAR  (%s bayt)  %s\n' "$cmd" "${size:-?}" "$path"
        else
            printf '  %-6s YOK  %s\n' "$cmd" "$path"
        fi
    done

    printf '\nUygulama paketi: com.mio\n'
    printf 'Uygulama verisi: /data/data/com.mio  (dosya yöneticisinde Android/data/com.mio)\n'
    if [ -f /data/data/com.mio/files/.mio-migrated ]; then
        printf 'Eski com.termux verileri: taşındı (%s)\n' "$(cat /data/data/com.mio/files/.mio-migrated 2>/dev/null)"
    elif [ -d /data/data/com.termux/files/home ]; then
        printf 'Eski com.termux verileri: TAŞINMADI - menü > Veriler > "Eski verileri taşı"\n'
    else
        printf 'Eski com.termux verileri: yok\n'
    fi
    if [ -x "$PREFIX/bin/termux-am" ]; then
        printf 'termux-am: var\n'
    else
        printf 'termux-am: YOK (am kullanılacak)\n'
    fi

    printf '\nUygulama çalışıyor mu (servis):\n'
    if command -v pidof >/dev/null 2>&1; then
        pidof com.mio >/dev/null 2>&1 && printf '  evet\n' || printf '  hayır\n'
    else
        printf '  pidof yok, kontrol edilemedi\n'
    fi

    printf '\nMenü testi gönderiliyor...\n'
    if send "$ACTION_MENU"; then
        printf '  menü komutu gönderildi; ekran açıksa menü görünmeli.\n'
    else
        printf '  menü komutu GÖNDERİLEMEDİ. Uygulamayı aç ve tekrar dene.\n'
    fi

    printf '\nKısayol: ses açma tuşuna kısa basmak da menüyü açar (uzun basış Fn olarak kalır).\n'
    if [ -f "$HOME/.termux/termux.properties" ] && grep -q '^mio-menu-on-volume-up=false' "$HOME/.termux/termux.properties" 2>/dev/null; then
        printf 'UYARI: ses açma tuşu kısayolu kapalı (termux.properties > mio-menu-on-volume-up=false).\n'
    fi

    printf '\nNot: menü hâlâ açılmıyorsa uygulamanın bu sürümü kurulu olmayabilir.\n'
    printf 'APK: Termux > uzun bas > Sürüm ve teşhis (Mio menü içinde)\n'
}

# ---------------------------------------------------------------------------------------------
# Paketler: ~/.mio/pkgs/<paket> içindeki *.a.sh, *.b.sh ve *.start-up.sh betikleri
# ---------------------------------------------------------------------------------------------
PKG_DIR="$HOME/.mio/pkgs"
PKG_STATE_DIR="$HOME/.mio/state"
PKG_LOG_DIR="$HOME/.mio/log"

pkg_find() {
    # Paket klasörünü bul: tam ad, sonra büyük/küçük harf duyarsız
    for dir in "$PKG_DIR"/*; do
        [ -d "$dir" ] || continue
        name=${dir##*/}
        if [ "$name" = "$1" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
    done
    for dir in "$PKG_DIR"/*; do
        [ -d "$dir" ] || continue
        name=${dir##*/}
        lower_name=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')
        lower_arg=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
        if [ "$lower_name" = "$lower_arg" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
    done
    return 1
}

pkg_installed_version() {
    file="$PKG_STATE_DIR/$1.installed"
    [ -f "$file" ] && head -n 1 "$file"
}

pkg_version() {
    file="$PKG_DIR/$1/VERSION"
    [ -f "$file" ] && head -n 1 "$file"
}

pkg_is_enabled() {
    [ ! -f "$PKG_STATE_DIR/$1.disabled" ]
}

pkg_has_update() {
    installed=$(pkg_installed_version "$1")
    version=$(pkg_version "$1")
    [ -z "$installed" ] && return 0
    [ -z "$version" ] && return 1
    [ "$installed" != "$version" ]
}

pkg_list() {
    mkdir -p "$PKG_DIR" "$PKG_STATE_DIR" "$PKG_LOG_DIR" 2>/dev/null
    if [ -z "$(ls -A "$PKG_DIR" 2>/dev/null)" ]; then
        printf 'Paket yok. Klasör: %s\n' "$PKG_DIR"
        printf 'Örnek oluşturmak için: mio paket sifirla\n'
        return 0
    fi
    printf 'Paketler (%s):\n' "$PKG_DIR"
    for dir in "$PKG_DIR"/*; do
        [ -d "$dir" ] || continue
        name=${dir##*/}
        installed=$(pkg_installed_version "$name")
        version=$(pkg_version "$name")
        state="kurulmadı"
        if [ -n "$installed" ]; then
            state="kurulu v$installed"
            if [ -n "$version" ] && [ "$installed" != "$version" ]; then
                state="kurulu v$installed (güncelleme: v$version)"
            fi
        fi
        pkg_is_enabled "$name" || state="$state • kapalı"
        [ -f "$dir/URL" ] && state="$state • uzaktan"
        printf '  %-20s %s\n' "$name" "$state"
        for script in "$dir"/*.sh; do
            [ -f "$script" ] || continue
            printf '      %s\n' "${script##*/}"
        done
    done
}

# Paketin URL dosyası varsa uzak betiği çalıştırır (bash <(curl -s URL))
pkg_url() {
    file="$PKG_DIR/$1/URL"
    [ -f "$file" ] && head -n 1 "$file" | tr -d '\r'
}

pkg_install_remote() {
    dir=$(pkg_find "$1") || {
        printf 'mio: paket bulunamadı: %s\n' "$1" >&2
        return 1
    }
    name=${dir##*/}
    url=$(pkg_url "$name")
    if [ -z "$url" ]; then
        return 2
    fi
    mkdir -p "$PKG_STATE_DIR" 2>/dev/null
    printf 'Paket kuruluyor (uzaktan): %s\nKaynak: %s\n' "$name" "$url"
    printf '> bash <(curl -s %s)\n' "$url"

    if ! command -v curl >/dev/null 2>&1; then
        printf 'mio: curl kuruluyor...\n'
        pkg install -y curl >/dev/null 2>&1 || {
            printf 'mio: curl kurulamadı.\n' >&2
            return 1
        }
    fi

    # Betik indirilip çalıştırılır; boru yerine dosya kullanılıyor ki çıkış kodu doğru olsun
    script="$HOME/.mio/tmp-remote-$$.sh"
    if ! curl -fsSL "$url" -o "$script"; then
        printf 'mio: betik indirilemedi: %s\n' "$url" >&2
        rm -f "$script"
        return 1
    fi

    bash "$script"
    status=$?
    rm -f "$script"

    if [ $status -ne 0 ]; then
        printf 'mio: betik hata verdi (çıkış kodu %s), paket kurulmadı.\n' "$status" >&2
        return $status
    fi

    version=$(pkg_version "$name")
    printf '%s\n' "${version:-1}" > "$PKG_STATE_DIR/$name.installed"
    printf 'Paket kuruldu: %s%s\n' "$name" "${version:+ (v$version)}"
    return 0
}

pkg_install() {
    dir=$(pkg_find "$1") || {
        printf 'mio: paket bulunamadı: %s\n' "$1" >&2
        printf 'Klasör: %s\n' "$PKG_DIR" >&2
        return 1
    }
    name=${dir##*/}
    url=$(pkg_url "$name")
    if [ -n "$url" ]; then
        pkg_install_remote "$name"
        return $?
    fi

    mkdir -p "$PKG_STATE_DIR" "$PKG_LOG_DIR" 2>/dev/null
    log="$PKG_LOG_DIR/$name.log"

    printf 'Paket kuruluyor: %s\n' "$name"
    {
        printf '# %s — %s\n' "$name" "$(date 2>/dev/null)"
    } > "$log"

    # Ortak harf sırası: .a.sh, .b.sh, .c.sh, .d.sh, .e.sh
    for letter in a b c d e; do
        for script in "$dir"/*.$letter.sh; do
            [ -f "$script" ] || continue
            printf '\n>>> %s\n' "${script##*/}" >> "$log"
            printf '\n>>> %s\n' "${script##*/}"

            # Çıkış kodu borudan değil, doğrudan betikten alınmalı, yoksa tee'nin koduna bakılır
            ( cd "$dir" && sh "$script" ) > "$PKG_LOG_DIR/.last-run" 2>&1
            status=$?
            cat "$PKG_LOG_DIR/.last-run" >> "$log"
            cat "$PKG_LOG_DIR/.last-run"
            rm -f "$PKG_LOG_DIR/.last-run"

            if [ $status -ne 0 ]; then
                printf 'mio: %s betiği hata verdi (çıkış kodu %s), paket kurulmadı.\n' \
                    "${script##*/}" "$status" >&2
                printf 'Sonraki aşama (.b.sh) çalıştırılmadı. Günlük: %s\n' "$log" >&2
                return $status
            fi
        done
    done

    version=$(pkg_version "$name")
    printf '%s\n' "${version:-1}" > "$PKG_STATE_DIR/$name.installed"
    printf 'Paket kuruldu: %s%s\n' "$name" "${version:+ (v$version)}"
    [ -f "$dir"/*.start-up.sh ] 2>/dev/null && printf 'start-up betiği bir sonraki açılışta çalışacak.\n'
    return 0
}

pkg_update_all() {
    found=0
    status=0
    for dir in "$PKG_DIR"/*; do
        [ -d "$dir" ] || continue
        name=${dir##*/}
        if pkg_has_update "$name"; then
            found=1
            pkg_install "$name" || status=1
        fi
    done
    [ $found -eq 0 ] && printf 'Güncellenecek paket yok.\n'
    return $status
}

pkg_startup_all() {
    status=0
    for dir in "$PKG_DIR"/*; do
        [ -d "$dir" ] || continue
        name=${dir##*/}
        [ -f "$PKG_STATE_DIR/$name.installed" ] || continue
        pkg_is_enabled "$name" || continue
        for script in "$dir"/*.start-up.sh; do
            [ -f "$script" ] || continue
            printf '>>> %s / %s\n' "$name" "${script##*/}"
            ( cd "$dir" && sh "$script" ) || status=1
        done
    done
    return $status
}

pkg_create_template() {
    mkdir -p "$PKG_DIR/Older-Pack" 2>/dev/null || return 1
    dir="$PKG_DIR/Older-Pack"
    if [ ! -f "$dir/Older-Pack.a.sh" ]; then
        cat > "$dir/Older-Pack.a.sh" <<'MIO_EOF'
#!/data/data/com.termux/files/usr/bin/sh
# Older-Pack — birinci aşama betiği (.a.sh), kurulacak komutlar buraya yazılır
set -u
echo "Older-Pack: birinci aşama başladı"
echo "Ev dizini: $HOME"
# Örnek: pkg install -y git
echo "Older-Pack: birinci aşama tamam"
MIO_EOF
        chmod +x "$dir/Older-Pack.a.sh"
    fi
    if [ ! -f "$dir/Older-Tool.b.sh" ]; then
        cat > "$dir/Older-Tool.b.sh" <<'MIO_EOF'
#!/data/data/com.termux/files/usr/bin/sh
# Older-Tool — ikinci aşama betiği (.b.sh), .a.sh başarılı olursa çalışır
set -u
echo "Older-Tool: ikinci aşama başladı"
echo "Older-Tool: ikinci aşama tamam"
MIO_EOF
        chmod +x "$dir/Older-Tool.b.sh"
    fi
    if [ ! -f "$dir/Older-Pack.start-up.sh" ]; then
        cat > "$dir/Older-Pack.start-up.sh" <<'MIO_EOF'
#!/data/data/com.termux/files/usr/bin/sh
# Older-Pack — başlangıç betiği (.start-up.sh), Termux her açıldığında çalışır
set -u
echo "Older-Pack: start-up çalıştı ($(date 2>/dev/null))"
MIO_EOF
        chmod +x "$dir/Older-Pack.start-up.sh"
    fi
    [ -f "$dir/VERSION" ] || printf '1\n' > "$dir/VERSION"
    [ -f "$dir/URL" ] || printf '%s\n' \
        "https://raw.githubusercontent.com/Mio-129/tm-pkg/refs/heads/main/older-pack" > "$dir/URL"
    printf 'Örnek paket hazır: %s\n' "$dir"
    printf 'Dosyalar: URL, Older-Pack.a.sh, Older-Tool.b.sh, Older-Pack.start-up.sh, VERSION\n'
}

pkg_log() {
    dir=$(pkg_find "$1") || {
        printf 'mio: paket bulunamadı: %s\n' "$1" >&2
        return 1
    }
    name=${dir##*/}
    log="$PKG_LOG_DIR/$name.log"
    if [ ! -f "$log" ]; then
        printf 'mio: %s için günlük yok, önce "mio paket kur %s" çalıştır.\n' "$name" "$name"
        return 1
    fi
    cat "$log"
}

# ---------------------------------------------------------------------------------------------
# Terminal menüsü: ~/.mio/menu.d/*.menu dosyaları
# Her satır:  etiket|komut        (# ile başlayan satırlar açıklama)
# ---------------------------------------------------------------------------------------------
MENU_DIR="$HOME/.mio/menu.d"

menu_run() {
    mkdir -p "$MENU_DIR" 2>/dev/null
    if [ ! -f "$MENU_DIR/varsayilan.menu" ]; then
        cat > "$MENU_DIR/varsayilan.menu" <<'MIO_EOF'
# Mio terminal menüsü — her satır: etiket|komut
Kar animasyonu|mio kar
Parçacık animasyonu|mio parcacik
Yazı boyutu +|mio yazi +
Yazı boyutu -|mio yazi -
Matrix teması|mio tema matrix
Tam ekran|mio tam ekran
Ses açma tuşu menüsü|mio ses
Paketleri listele|mio paket
Paketleri güncelle|mio paket guncelle
Yedek al|cd ~ && tar -czf ~/termux-yedek-$(date +%Y%m%d-%H%M).tar.gz -C /data/data/com.termux/files home usr
Depo değiştir|termux-change-repo
Teşhis|mio teshis
MIO_EOF
    fi

    n=0
    labels=""
    commands=""
    files=""
    for file in "$MENU_DIR"/*.menu "$MENU_DIR"/*.d/*.menu; do
        [ -f "$file" ] || continue
        files="$files $file"
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ''|'#'*) continue ;;
            esac
            label=${line%%|*}
            command=${line#*|}
            [ "$label" = "$line" ] && continue
            n=$((n + 1))
            labels="$labels$n) $label
"
            commands="$commands$command
"
        done < "$file"
    done

    if [ "$n" -eq 0 ]; then
        printf 'Menü boş: %s\n' "$MENU_DIR"
        return 1
    fi

    printf 'Mio terminal menüsü (%s)\n' "$MENU_DIR"
    printf '%s' "$labels"
    printf '0) Çıkış\n'
    printf 'Seçim: '
    read -r choice || return 1
    [ "$choice" = "0" ] && return 0
    case "$choice" in
        ''|*[!0-9]*) printf 'Geçersiz seçim.\n' >&2; return 2 ;;
    esac

    selected=$(printf '%s' "$commands" | sed -n "${choice}p")
    if [ -z "$selected" ]; then
        printf 'Geçersiz seçim.\n' >&2
        return 2
    fi
    printf '> %s\n' "$selected"
    # shellcheck disable=SC2086
    sh -c "$selected"
}

menu_list() {
    mkdir -p "$MENU_DIR" 2>/dev/null
    if [ -z "$(ls -A "$MENU_DIR" 2>/dev/null)" ]; then
        printf 'Menü yok: %s\n' "$MENU_DIR"
        return 1
    fi
    for file in "$MENU_DIR"/*.menu; do
        [ -f "$file" ] || continue
        printf '%s:\n' "${file##*/}"
        grep -v '^#' "$file" 2>/dev/null | grep -v '^$' | sed 's/^/  /'
    done
}

if [ $# -eq 0 ]; then
    send "$ACTION_MENU"
    exit $?
fi

COMMAND="$1"
shift

case "$COMMAND" in
    -h|--help|help|yardim|yardım)
        usage
        exit 0
        ;;
    gui|panel|pencere)
        send "$ACTION_MENU"
        exit $?
        ;;
    kar|snow|kay)
        send "$ACTION_ANIMATION" --es mode snow
        exit $?
        ;;
    parcacik|parçacık|particle|particles|partikul)
        send "$ACTION_ANIMATION" --es mode particles
        exit $?
        ;;
    animasyon|anim|stop|durdur)
        send "$ACTION_ANIMATION" --es mode off
        exit $?
        ;;
    yazi|yazı|font)
        if [ $# -eq 0 ]; then
            send "$ACTION_FONT_SIZE" --es mode status
            exit $?
        fi
        case "$1" in
            +|buyut|büyüt|up)
                send "$ACTION_FONT_SIZE" --es mode increase
                ;;
            -|kucult|küçült|down)
                send "$ACTION_FONT_SIZE" --es mode decrease
                ;;
            varsayilan|varsayılan|default|reset)
                send "$ACTION_FONT_SIZE" --es mode reset
                ;;
            *)
                send "$ACTION_FONT_SIZE" --es mode set --es size "$1"
                ;;
        esac
        exit $?
        ;;
    renk|color|renkler|colors)
        if [ $# -eq 0 ]; then
            send "$ACTION_COLORS" --es mode status
            exit $?
        fi
        case "$1" in
            sifirla|sıfırla|reset|varsayilan|varsayılan)
                send "$ACTION_COLORS" --es mode reset
                exit $?
                ;;
            *)
                if [ $# -lt 2 ]; then
                    printf 'mio: kullanım: mio renk <ad> <#RRGGBB>\n' >&2
                    exit 2
                fi
                send "$ACTION_COLORS" --es mode set --es key "$1" --es value "$2"
                exit $?
                ;;
        esac
        ;;
    tema|theme)
        if [ $# -eq 0 ]; then
            printf 'mio: temalar: varsayilan, matrix, gece, mor, sicak\n' >&2
            exit 2
        fi
        send "$ACTION_COLORS" --es mode theme --es name "$1"
        exit $?
        ;;
    tam|tamekran|fullscreen|full)
        send "$ACTION_FULLSCREEN"
        exit $?
        ;;
    ses|ses-tuslari|volume|vol)
        case "$1" in
            +|arttir|arttır|up)
                send "$ACTION_AUDIO_STREAM" --es mode volume-up
                ;;
            -|azalt|down)
                send "$ACTION_AUDIO_STREAM" --es mode volume-down
                ;;
            *)
                send "$ACTION_VOLUME_KEYS"
                ;;
        esac
        exit $?
        ;;
    paket|paketler|packages|pkg)
        if [ $# -eq 0 ]; then
            pkg_list
            exit $?
        fi
        PKG_ACTION="$1"
        shift
        case "$PKG_ACTION" in
            kur|kur-fix|install|ekle|add|yukle|yükle)
                if [ $# -eq 0 ]; then
                    printf 'mio: kullanım: mio paket kur <ad>\n' >&2
                    exit 2
                fi
                pkg_install "$1"
                exit $?
                ;;
            guncelle|güncelle|update|upgrade)
                pkg_update_all
                exit $?
                ;;
            baslat|başlat|start|startup|start-up)
                pkg_startup_all
                exit $?
                ;;
            sifirla|sıfırla|ornek|örnek|template|init)
                pkg_create_template
                exit $?
                ;;
            log|gunluk|günlük)
                if [ $# -eq 0 ]; then
                    printf 'mio: kullanım: mio paket log <ad>\n' >&2
                    exit 2
                fi
                pkg_log "$1"
                exit $?
                ;;
            liste|list|durum|status)
                pkg_list
                exit $?
                ;;
            *)
                printf 'mio: bilinmeyen paket komutu \"%s\"\n' "$PKG_ACTION" >&2
                printf 'Kullanım: mio paket [liste|kur <ad>|guncelle|baslat|sifirla|log <ad>]\n' >&2
                exit 2
                ;;
        esac
        ;;
    teshis|teşhis|diagnose|check|doctor)
        diagnose
        exit 0
        ;;
    menuler|menüler|menu-bar|bar)
        send "$ACTION_STYLE" --es mode toggle-bars
        exit $?
        ;;
    menu|menü|terminal-menu|tmenu)
        if [ "${1:-}" = "liste" ] || [ "${1:-}" = "list" ]; then
            menu_list
            exit $?
        fi
        if [ "${1:-}" = "sifirla" ] || [ "${1:-}" = "reset" ]; then
            rm -f "$MENU_DIR/varsayilan.menu"
            menu_run
            exit $?
        fi
        menu_run
        exit $?
        ;;
    oturum|session|new)
        send "$ACTION_SESSION" --es mode new
        exit $?
        ;;
    durum|status)
        send "$ACTION_STYLE" --es mode status
        exit $?
        ;;
    *)
        printf 'mio: bilinmeyen komut "%s"\n\n' "$COMMAND" >&2
        usage
        exit 2
        ;;
esac
