set -u
echo "Older-Pack: start-up çalıştı ($(date 2>/dev/null))"
MIO_EOF
        chmod +x "$dir/Older-Pack.start-up.sh"
    fi
    [ -f "$dir/VERSION" ] || printf '1\n' > "$dir/VERSION"
    [ -f "$dir/URL" ] || printf '%s\n' \
        "https://raw.githubusercontent.com/Mio-129/tm-pkg/refs/heads/main/older-pack" > "$dir/URL"
    printf 'Örnek paket hazır: %s\n' "$dir"
    printf 'Dosyalar: URL, Older-Pack.a.sh, Older-Tool.b.sh, Older-Pack.start-up.sh, VERSION\n'
}

pkg_log() {
    dir=$(pkg_find "$1") || {
        printf 'mio: paket bulunamadı: %s\n' "$1" >&2
        return 1
    }
    name=${dir##*/}
    log="$PKG_LOG_DIR/$name.log"
    if [ ! -f "$log" ]; then
        printf 'mio: %s için günlük yok, önce "mio paket kur %s" çalıştır.\n' "$name" "$name"
        return 1
    fi
    cat "$log"
}

# ---------------------------------------------------------------------------------------------
# Terminal menüsü: ~/.mio/menu.d/*.menu dosyaları
# Her satır:  etiket|komut        (# ile başlayan satırlar açıklama)
# ---------------------------------------------------------------------------------------------
MENU_DIR="$HOME/.mio/menu.d"

menu_run() {
    mkdir -p "$MENU_DIR" 2>/dev/null
    if [ ! -f "$MENU_DIR/varsayilan.menu" ]; then
        cat > "$MENU_DIR/varsayilan.menu" <<'MIO_EOF'
# Mio terminal menüsü — her satır: etiket|komut
Kar animasyonu|mio kar
Parçacık animasyonu|mio parcacik
Yazı boyutu +|mio yazi +
Yazı boyutu -|mio yazi -
Matrix teması|mio tema matrix
Tam ekran|mio tam ekran
Ses açma tuşu menüsü|mio ses
Paketleri listele|mio paket
Paketleri güncelle|mio paket guncelle
Yedek al|cd ~ && tar -czf ~/termux-yedek-$(date +%Y%m%d-%H%M).tar.gz -C /data/data/com.mio/files home usr
Depo değiştir|termux-change-repo
Teşhis|mio teshis
MIO_EOF
    fi

    n=0
    labels=""
    commands=""
    files=""
    for file in "$MENU_DIR"/*.menu "$MENU_DIR"/*.d/*.menu; do
        [ -f "$file" ] || continue
        files="$files $file"
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ''|'#'*) continue ;;
            esac
            label=${line%%|*}
            command=${line#*|}
            [ "$label" = "$line" ] && continue
            n=$((n + 1))
            labels="$labels$n) $label
"
            commands="$commands$command
"
        done < "$file"
    done

    if [ "$n" -eq 0 ]; then
        printf 'Menü boş: %s\n' "$MENU_DIR"
        return 1
    fi

    printf 'Mio terminal menüsü (%s)\n' "$MENU_DIR"
    printf '%s' "$labels"
    printf '0) Çıkış\n'
    printf 'Seçim: '
    read -r choice || return 1
    [ "$choice" = "0" ] && return 0
    case "$choice" in
        ''|*[!0-9]*) printf 'Geçersiz seçim.\n' >&2; return 2 ;;
    esac

    selected=$(printf '%s' "$commands" | sed -n "${choice}p")
    if [ -z "$selected" ]; then
        printf 'Geçersiz seçim.\n' >&2
        return 2
    fi
    printf '> %s\n' "$selected"
    # shellcheck disable=SC2086
    sh -c "$selected"
}

menu_list() {
    mkdir -p "$MENU_DIR" 2>/dev/null
    if [ -z "$(ls -A "$MENU_DIR" 2>/dev/null)" ]; then
        printf 'Menü yok: %s\n' "$MENU_DIR"
        return 1
    fi
    for file in "$MENU_DIR"/*.menu; do
        [ -f "$file" ] || continue
        printf '%s:\n' "${file##*/}"
        grep -v '^#' "$file" 2>/dev/null | grep -v '^$' | sed 's/^/  /'
    done
}

if [ $# -eq 0 ]; then
    send "$ACTION_MENU"
    exit $?
fi

COMMAND="$1"
shift

# Her komuttan önce depo dosyasını doğrula/onar: bozuksa pkg ve apt hiç çalışmaz
if [ -d "${PREFIX:-}/etc/apt" ]; then
    fix_sources >/dev/null 2>&1
fi

case "$COMMAND" in
    -h|--help|help|yardim|yardım)
        usage
        exit 0
        ;;
    gui|panel|pencere)
        send "$ACTION_MENU"
        exit $?
        ;;
    kar|snow|kay)
        send "$ACTION_ANIMATION" --es mode snow
        exit $?
        ;;
    parcacik|parçacık|particle|particles|partikul)
        send "$ACTION_ANIMATION" --es mode particles
        exit $?
        ;;
    animasyon|anim|stop|durdur)
        send "$ACTION_ANIMATION" --es mode off
        exit $?
        ;;
    yazi|yazı|font)
        if [ $# -eq 0 ]; then
            send "$ACTION_FONT_SIZE" --es mode status
            exit $?
        fi
        case "$1" in
            +|buyut|büyüt|up)
                send "$ACTION_FONT_SIZE" --es mode increase
                ;;
            -|kucult|küçült|down)
                send "$ACTION_FONT_SIZE" --es mode decrease
                ;;
            varsayilan|varsayılan|default|reset)
                send "$ACTION_FONT_SIZE" --es mode reset
                ;;
            *)
                send "$ACTION_FONT_SIZE" --es mode set --es size "$1"
                ;;
        esac
        exit $?
        ;;
    renk|color|renkler|colors)
        if [ $# -eq 0 ]; then
            send "$ACTION_COLORS" --es mode status
            exit $?
        fi
        case "$1" in
            sifirla|sıfırla|reset|varsayilan|varsayılan)
                send "$ACTION_COLORS" --es mode reset
                exit $?
                ;;
            *)
                if [ $# -lt 2 ]; then
                    printf 'mio: kullanım: mio renk <ad> <#RRGGBB>\n' >&2
                    exit 2
                fi
                send "$ACTION_COLORS" --es mode set --es key "$1" --es value "$2"
                exit $?
                ;;
        esac
        ;;
    tema|theme)
        if [ $# -eq 0 ]; then
            printf 'mio: temalar: varsayilan, matrix, gece, mor, sicak\n' >&2
            exit 2
        fi
        send "$ACTION_COLORS" --es mode theme --es name "$1"
        exit $?
        ;;
    tam|tamekran|fullscreen|full)
        send "$ACTION_FULLSCREEN"
        exit $?
        ;;
    ses|ses-tuslari|volume|vol)
        case "$1" in
            +|arttir|arttır|up)
                send "$ACTION_AUDIO_STREAM" --es mode volume-up
                ;;
            -|azalt|down)
                send "$ACTION_AUDIO_STREAM" --es mode volume-down
                ;;
            *)
                send "$ACTION_VOLUME_KEYS"
                ;;
        esac
        exit $?
        ;;
    paket|paketler|packages|pkg)
        if [ $# -eq 0 ]; then
            pkg_list
            exit $?
        fi
        PKG_ACTION="$1"
        shift
        case "$PKG_ACTION" in
            kur|kur-fix|install|ekle|add|yukle|yükle)
                if [ $# -eq 0 ]; then
                    printf 'mio: kullanım: mio paket kur <ad>\n' >&2
                    exit 2
                fi
                pkg_install "$1"
                exit $?
                ;;
            guncelle|güncelle|update|upgrade)
                pkg_update_all
                exit $?
                ;;
            baslat|başlat|start|startup|start-up)
                pkg_startup_all
                exit $?
                ;;
            sifirla|sıfırla|ornek|örnek|template|init)
                pkg_create_template
                exit $?
                ;;
            log|gunluk|günlük)
                if [ $# -eq 0 ]; then
                    printf 'mio: kullanım: mio paket log <ad>\n' >&2
                    exit 2
                fi
                pkg_log "$1"
                exit $?
                ;;
            liste|list|durum|status)
                pkg_list
                exit $?
                ;;
            *)
                printf 'mio: bilinmeyen paket komutu \"%s\"\n' "$PKG_ACTION" >&2
                printf 'Kullanım: mio paket [liste|kur <ad>|guncelle|baslat|sifirla|log <ad>]\n' >&2
                exit 2
                ;;
        esac
        ;;
    teshis|teşhis|diagnose|check|doctor)
        diagnose
        exit 0
        ;;
    menuler|menüler|menu-bar|bar)
        send "$ACTION_STYLE" --es mode toggle-bars
        exit $?
        ;;
    ses|volume|vol)
        case "${1:-}" in
            +|artir|arttir|up) send "$ACTION_VOLUME_KEYS" --es mode up ;;
            -|azalt|down) send "$ACTION_VOLUME_KEYS" --es mode down ;;
            durum|status) send "$ACTION_VOLUME_KEYS" --es mode status ;;
            *) printf 'Kullanım: mio ses + | - | durum\n'; exit 1 ;;
        esac
        exit $?
        ;;
    apt-fix|aptfix|onar)
        # Her şeyi sırayla onarır ve ağa çıkmadan doğrular. Tek komutla "çalışıyor/çalışmıyor" der.
        printf '=== mio apt onarımı ===\n'

        # 1) eksik dizinler
        for d in "$PREFIX/var/lib/apt/lists/partial" "$PREFIX/var/cache/apt/archives/partial" \
                 "$PREFIX/var/lib/dpkg" "$PREFIX/var/log/apt" "$PREFIX/etc/apt/trusted.gpg.d" \
                 "$PREFIX/etc/apt/apt.conf.d" "$PREFIX/etc/apt/sources.list.d" "$PREFIX/tmp"; do
            [ -d "$d" ] || { mkdir -p "$d" 2>/dev/null && printf '  oluşturuldu: %s\n' "$d"; }
        done
        [ -f "$PREFIX/var/lib/dpkg/status" ] || : > "$PREFIX/var/lib/dpkg/status"

        # 2) kaynak dosyası
        if [ ! -s "$PREFIX/etc/apt/sources.list" ] || [ -d "$PREFIX/etc/apt/sources.list" ]; then
            fix_sources
            printf '  sources.list yeniden yazıldı\n'
        fi

        # 3) apt yöntemleri çalıştırılabilir mi
        bad=0
        for m in "$PREFIX/lib/apt/methods"/*; do
            [ -f "$m" ] || continue
            [ -x "$m" ] || chmod 755 "$m" 2>/dev/null
            [ -x "$m" ] || bad=$((bad + 1))
        done
        [ "$bad" -eq 0 ] && printf '  apt yöntemleri: tamam\n' || printf '  apt yöntemleri: %s dosya çalıştırılamıyor\n' "$bad"

        # 4) dpkg'nin aradığı programlar (apt kaynağında DPkg::Path'e bakıyor)
        missing_path=""
        for prog in sh rm tar diff dpkg-deb start-stop-daemon; do
            if [ ! -e "$PREFIX/bin/$prog" ]; then
                missing_path="$missing_path $prog"
            elif [ ! -x "$PREFIX/bin/$prog" ]; then
                chmod 755 "$PREFIX/bin/$prog" 2>/dev/null
            fi
        done
        if [ -n "$missing_path" ]; then
            printf '  EKSİK PROGRAM:%s\n' "$missing_path"
        else
            printf '  dpkg yardımcı programları: tamam (DPkg::Path=%s/bin)\n' "$PREFIX"
        fi

        # 4b) dpkg dosya listeleri: "files list file ... is missing final newline"
        #     hatası kurulumu tamamen durdurur; sonu satır sonuyla bitmeyen
        #     *.list dosyalarına satır sonu ekle
        if [ -d "$PREFIX/var/lib/dpkg/info" ]; then
            fixed_lists=0
            for lf in "$PREFIX"/var/lib/dpkg/info/*.list; do
                [ -f "$lf" ] || continue
                if [ -s "$lf" ]; then
                    lastc=$(tail -c 1 "$lf" 2>/dev/null | od -An -tx1 | tr -d ' \n')
                    [ "$lastc" = "0a" ] && continue
                    # son satır tam bir yol ise sadece satır sonu ekle,
                    # kesikse (yarım yol) o satırı at
                    lastline=$(tail -n 1 "$lf" 2>/dev/null)
                    case "$lastline" in
                        /*) printf '\n' >> "$lf" 2>/dev/null ;;
                        *)  awk 'NR > 1 { print prev } { prev = $0 } END { if (NR > 1) print prev }' \
                                "$lf" > "$lf.mio-tmp" 2>/dev/null &&
                                mv "$lf.mio-tmp" "$lf" 2>/dev/null
                            [ -s "$lf" ] && tail -c 1 "$lf" | od -An -tx1 | grep -q 0a || printf '\n' >> "$lf" 2>/dev/null ;;
                    esac
                    [ -s "$lf" ] || printf '/.\n' > "$lf" 2>/dev/null
                    fixed_lists=$((fixed_lists + 1))
                else
                    printf '/.\n' >> "$lf" 2>/dev/null && fixed_lists=$((fixed_lists + 1))
                fi
            done
            [ "$fixed_lists" -gt 0 ] && printf '  dpkg dosya listeleri onarıldı: %s\n' "$fixed_lists" \
                || printf '  dpkg dosya listeleri: tamam\n'
        fi

        # 5) apt.conf.d dosyalarını yeniden yaz
        rm -f "$PREFIX/etc/apt/apt.conf.d/zz-mio-sources.conf" "$PREFIX/etc/apt/apt.conf.d/mio-apt.conf" 2>/dev/null
        MIO_NO_APT_CONFIG=0 ensure_apt_config >/dev/null 2>&1
        printf '  apt yapılandırması yazıldı\n'

        # 6) sarmalayıcıları tazele (SİLEREK DEĞİL: silinirse gerçek araç `*.mio-real` yedeğinden gelir)
        install_apt_wrappers >/dev/null 2>&1
        for n in pkg apt apt-get; do
            if [ -x "$PREFIX/bin/$n" ]; then
                printf '  %s: hazır\n' "$n"
            elif [ -x "$PREFIX/bin/$n.mio-real" ]; then
                # sarmalayıcı yazılamadıysa gerçek aracı eski yerine bağla
                cp "$PREFIX/bin/$n.mio-real" "$PREFIX/bin/$n" 2>/dev/null &&
                    chmod 755 "$PREFIX/bin/$n" 2>/dev/null &&
                    printf '  %s: yedekten geri getirildi\n' "$n"
            else
                printf '  %s: YOK (%s.mio-real da yok)\n' "$n" "$n"
            fi
        done
        # dpkg sarmalayıcısı: deb içindeki com.termux yollarını com.mio ya çevirir (unpack hatası)
        if [ -x "$PREFIX/bin/dpkg" ] && grep -q "MIO_DPKG_WRAPPER_VERSION" "$PREFIX/bin/dpkg" 2>/dev/null; then
            printf '  dpkg: sarmalayıcı hazır (com.termux yolları com.mio ya çevrilir)\n'
        elif [ -x "$PREFIX/bin/dpkg" ]; then
            printf '  dpkg: sarmalayıcı YOK, com.termux yolu olan paketler kurulamaz\n'
        fi

        # 7) AĞA ÇIKMADAN test: apt yöntemi + dpkg + indeks üretimi
        printf '\n=== test ===\n'
        printf 'dpkg: '
        if [ ! -x "$PREFIX/bin/dpkg" ]; then
            printf 'YOK (%s/bin/dpkg)\n' "$PREFIX"
        elif "$PREFIX/bin/dpkg" --print-architecture >/dev/null 2>&1; then
            printf 'çalışıyor (%s)\n' "$("$PREFIX/bin/dpkg" --print-architecture 2>/dev/null | head -n 1)"
        else
            printf 'ÇALIŞMIYOR (çıkış=%s)\n' "$?"
        fi

        printf 'apt yöntemi (https): '
        if env -u LD_PRELOAD "$PREFIX/lib/apt/methods/https" </dev/null 2>/dev/null | head -n 1 | grep -q Capabilities; then
            printf 'çalışıyor\n'
        else
            printf 'ÇALIŞMIYOR\n'
        fi

        printf 'depo okuma: '
        print_tool=""
        for t in apt-get apt; do
            [ -x "$PREFIX/bin/$t" ] && { print_tool="$PREFIX/bin/$t"; break; }
        done
        if [ -z "$print_tool" ]; then
            printf 'BAŞARISIZ (ne apt ne apt-get var)\n'
            uris=0
        else
        uri_out=$(env -u LD_PRELOAD "$print_tool" -o Debug::NoLocking=1 --print-uris update 2>&1 </dev/null || true)
        uris=$(printf '%s\n' "$uri_out" | grep -c "InRelease" || true)
        [ -n "$uris" ] || uris=0
        fi
        if [ "${uris:-0}" -gt 0 ]; then
            printf 'ok (%s adres)\n' "$uris"
        else
            printf 'BAŞARISIZ\n'
            env -u LD_PRELOAD apt-get --print-uris update 2>&1 </dev/null | head -n 6 | sed 's/^/   /'
        fi

        # 8) en hızlı depoyu seç (indirme yavaşlığının asıl sebebi rastgele ayna seçimiydi)
        printf '\n'
        mirror_pick_fast

        # 7b) GERÇEK kurulum provası (ağa çıkmadan): depodaki paketler com.termux önekiyle
        #     derlendiği için dpkg "error creating directory './.data/data/com.termux': Permission
        #     denied" veriyordu. Prova, com.termux yollu küçük bir deb dosyasını gerçek köke kurar:
        #     dpkg sarmalayıcısı çalışıyorsa yol com.mio ya çevrilir ve kurulum başarılı olur.
        #     Dönüştürme olmazsa dpkg tam olarak cihazdaki hatayı verir.
        printf 'paket kurma provası: '
        probe_dir="$PREFIX/tmp/mio-probe"
        probe_admin="$probe_dir/admin"
        probe_marker="$PREFIX/share/mio-probe"
        probe_ok=0
        probe_ran=0
        probe_done=0
        # dpkg yardımcı programları PATH içinde olmalı; eksikse dpkg "N expected programs not
        # found in PATH" deyip unpack etmeden durur.
        PATH="$PREFIX/bin:$PATH" ; export PATH
        rm -rf "$probe_dir" "$probe_marker" 2>/dev/null
        if [ -x "$PREFIX/bin/dpkg" ] && [ -x "$PREFIX/bin/dpkg-deb" ]; then
            probe_ran=1
            mkdir -p "$probe_dir/root/DEBIAN" "$probe_dir/root/data/data/com.termux/files/usr/share/mio-probe" "$probe_admin/info" "$probe_admin/updates" 2>/dev/null
            printf 'Package: mio-probe\nVersion: 1.0\nArchitecture: all\nMaintainer: mio <mio@local>\nDescription: mio install probe\n' \
                > "$probe_dir/root/DEBIAN/control" 2>/dev/null
            printf 'probe\n' > "$probe_dir/root/data/data/com.termux/files/usr/share/mio-probe/probe" 2>/dev/null
            : > "$probe_admin/status"
            : > "$probe_admin/available"
            if "$PREFIX/bin/dpkg-deb" -b "$probe_dir/root" "$probe_dir/probe.deb" >/dev/null 2>&1; then
                probe_done=1
                "$PREFIX/bin/dpkg" --admindir="$probe_admin" --instdir=/ \
                    --force-not-root --force-script-chrootless --force-depends \
                    --unpack "$probe_dir/probe.deb" >"$probe_dir/log" 2>&1 && probe_ok=1
                # Kurulan dosya gerçekten com.mio önekinde mi?
                if [ -f "$probe_marker/probe" ]; then
                    probe_ok=1
                elif [ "$probe_ok" -eq 1 ]; then
                    probe_ok=2
                fi
            fi
        fi
        if [ "$probe_ok" -eq 1 ]; then
            printf 'tamam (depodaki paketler com.mio yollarına çevrilerek kuruluyor)\n'
        elif [ "$probe_ok" -eq 2 ]; then
            printf 'BAŞARISIZ (kurulum oldu ama dosya com.mio önekinde değil)\n'
        elif [ "$probe_ran" -eq 0 ]; then
            printf 'ATLANDI (dpkg-deb ya da dpkg yok)\n'
        elif [ "$probe_done" -eq 0 ]; then
            printf 'ATLANDI (prova paketi oluşturulamadı)\n'
        else
            printf 'BAŞARISIZ (ayrıntı: %s)\n' "$(grep -m1 -i "error\|denied" "$probe_dir/log" 2>/dev/null)"
        fi
        rm -rf "$probe_dir" "$probe_marker" 2>/dev/null

        printf '\nSONUÇ: '
        if [ -z "$missing_path" ] && [ "${uris:-0}" -gt 0 ]; then
            printf 'apt çalışıyor.\n'
            printf 'Paket listelerini indirmek için: apt update\n'
            printf 'Sonra: apt install <paket> -y\n'
        else
            printf 'yukarıdaki satırlara bak (eksik program ya da depo okuma hatası)\n'
        fi
        exit 0
        ;;
    apt-test|methods|method-test)
        # https yöntemi neden başlamıyor? Ağa ÇIKMAZ, saniyeler içinde biter.
        m="$PREFIX/lib/apt/methods/https"
        printf 'Dosya: %s\n' "$m"
        ls -l "$m" 2>/dev/null | sed 's/^/  /'
        printf 'hedef: %s\n' "$(readlink -f "$m" 2>/dev/null)"

        printf '\nLD_PRELOAD: %s\n' "${LD_PRELOAD:-<yok>}"

        printf '\n1) normal ortamda çalıştırma:\n'
        out=$("$m" </dev/null 2>&1 | head -n 3)
        printf '   çıkış kodu: %s\n' "$?"
        [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/   /'

        printf '\n2) LD_PRELOAD olmadan çalıştırma:\n'
        out=$(env -u LD_PRELOAD "$m" </dev/null 2>&1 | head -n 3)
        printf '   çıkış kodu: %s\n' "$?"
        [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/   /'

        printf '\n3) apt gerçekte hangi yolu kullanıyor:\n'
        env -u LD_PRELOAD apt-config dump 2>/dev/null | grep -a -E '^Dir::Bin::methods|^Dir::State|^Dir::Etc' | sed 's/^/   /'

        printf '\n3b) dpkg ve yardımcı programları:\n'
        printf '   dpkg: %s\n' "$(command -v dpkg || echo YOK)"
        printf '   sh: %s\n' "$(command -v sh || echo YOK)"
        printf '   rm: %s\n' "$(command -v rm || echo YOK)"
        printf '   tar: %s\n' "$(command -v tar || echo YOK)"
        printf '   PATH: %s\n' "$PATH"
        dpkg --print-architecture 2>/dev/null | sed 's/^/   mimari: /'

        printf '\n4) apt-get kuru çalıştırma (indirme yok):\n'
        out=$(env -u LD_PRELOAD apt-get -o Debug::NoLocking=1 --print-uris update 2>&1 </dev/null | head -n 5)
        printf '%s\n' "$out" | sed 's/^/   /'
        printf '\nNOT: 4. adımda "did not start correctly" yoksa apt yöntemi başlatabiliyor demektir.\n'
        exit 0
        ;;
    apt|sources-durum|apt-neden)
        sources_report
        exit 0
        ;;
    depo|repo|sources|duzelt|fix)
        if [ "${1:-}" = "sec" ] || [ "${1:-}" = "degistir" ] || [ "${1:-}" = "switch" ]; then
            shift
            mirror_choose "${1:-}"
            exit $?
        fi
        if [ "${1:-}" = "hizli" ] || [ "${1:-}" = "hızlı" ] || [ "${1:-}" = "fast" ]; then
            mirror_pick_fast
            exit $?
        fi
        if [ "${1:-}" = "liste" ] || [ "${1:-}" = "list" ]; then
            printf 'Depo seçenekleri:\n'
            n=0
            printf '%s' "$MIRRORS" | while IFS='|' read -r label url; do
                [ -n "$label" ] || continue
                n=$((n+1))
                printf '  %s) %-16s %s\n' "$n" "$label" "$url"
            done
            printf 'Kullanım: mio depo sec <numara ya da ad>\n'
            exit 0
        fi
        fix_sources
        if [ -L "$PREFIX/etc/apt/sources.list" ] || { [ -e "$PREFIX/etc/apt/sources.list" ] && [ ! -f "$PREFIX/etc/apt/sources.list" ]; }; then
            printf 'Depo dosyası HÂLÂ BOZUK: %s\n' "$PREFIX/etc/apt/sources.list" >&2
            exit 1
        fi
        printf 'Depo dosyası: %s\n' "$PREFIX/etc/apt/sources.list"
        sed 's/^/  /' "$PREFIX/etc/apt/sources.list" 2>/dev/null
        exit $?
        ;;
    menu|menü|terminal-menu|tmenu)
        if [ "${1:-}" = "liste" ] || [ "${1:-}" = "list" ]; then
            menu_list
            exit $?
        fi
        if [ "${1:-}" = "sifirla" ] || [ "${1:-}" = "reset" ]; then
            rm -f "$MENU_DIR/varsayilan.menu"
            menu_run
            exit $?
        fi
        menu_run
        exit $?
        ;;
    oturum|session|new)
        send "$ACTION_SESSION" --es mode new
        exit $?
        ;;
    durum|status)
        send "$ACTION_STYLE" --es mode status
        exit $?
        ;;
    *)
        printf 'mio: bilinmeyen komut "%s"\n\n' "$COMMAND" >&2
        usage
        exit 2
        ;;
esac
