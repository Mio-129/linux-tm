#!/data/data/com.mio/files/usr/bin/sh
#
# swset - Fotoğraf veya videoyu terminalin arkasına koyar.
#
# Kullanım:
#   swset <dosya>       Fotoğraf veya videoyu arka plana koyar, örnek: swset foto.png
#   swset               Bulunduğun klasördeki (ve alt klasörlerdeki) ilk fotoğraf/videoyu koyar
#   swset image         İlk fotoğrafı arka plana koyar
#   swset video         İlk videoyu arka plana koyar
#   swset off           Arka planı temizler (siyah arka plan geri gelir)
#   swset status        Arka plandaki medyayı gösterir
#   swset --ses <dosya> Video ile birlikte sesini de açar
#   swset ses           Medya ses akışı oluşturur (video sessizken sesi ayrı akıştan açmak için)
#   swset ses kapat     Medya ses akışını kapatır
#
# Notlar:
#   * Video ilk ayarlandığında sessizdir. Sesi açmak için `so` komutunu kullan.
#   * Dosya adında boşluk varsa tırnak içine alabilirsin ama gerekmez,
#     dosyanın tam yolu uygulamaya istek dosyası ile iletilir.
#   * Fotoğraf/video dosyaları $HOME (Termux ana dizini) altında aranır.
#
# Bu betik termux-api gerektirmez, uygulamanın kendi yayın alıcısına (broadcast) komut yollar.

if [ -z "${PREFIX:-}" ]; then
    PREFIX=/data/data/com.mio/files/usr
fi

ACTION_SET="com.termux.mio.action.SET_WALLPAPER"
ACTION_CLEAR="com.termux.mio.action.CLEAR_WALLPAPER"
ACTION_STATUS="com.termux.mio.action.STATUS"
ACTION_AUDIO_STREAM="com.termux.mio.action.AUDIO_STREAM"

COMMAND_NAME="swset"
REQUEST_DIR="$HOME/.termux/mio"
REQUEST_FILE="$REQUEST_DIR/request"

usage() {
    cat <<EOF
Kullanım: swset [seçenek] [dosya]

  swset <dosya>        Fotoğraf/videoyu terminalin arkasına koyar.
                       Örnek: swset foto.png / swset video.mp4
  swset                Bulunduğun klasördeki ilk fotoğraf/videoyu koyar.
  swset image          Bulunduğun klasördeki ilk fotoğrafı koyar.
  swset video          Bulunduğun klasördeki ilk videoyu koyar.
  swset off            Arka planı temizler.
  swset status         Şu anki arka planı gösterir.
  swset --ses <dosya>  Videoyu sesi açık şekilde koyar.
  swset ses            Ses akışını açar (sesi terminalden tekrar açmak için).
  swset ses kapat      Ses akışını kapatır.
  swset --help         Bu yardımı gösterir.

Sesi açmak için:    so
Sesi kapatmak için: so off
EOF
}

# termux-am varsa onu kullan, yoksa /system/bin/am kullanılır.
# Android 14+ (API 34) üzerinde `am broadcast` çalışmazsa, komut dinleyen servise
# doğrudan startservice ile iletilir (uygulama zaten çalışıyorsa bu her zaman çalışır).
run_am() {
    # Önce sistem `am`: termux-am ikilisi `com.termux` paket kimliğiyle derlenmiş olduğundan
    # yayınları/servis başlatmaları `com.termux` adına yapar ve bu uygulamaya ulaşamaz.
    if [ -x /system/bin/am ] && /system/bin/am "$@" >/dev/null 2>&1; then
        return 0
    fi
    if [ -x "$PREFIX/bin/termux-am" ]; then
        "$PREFIX/bin/termux-am" "$@"
        return $?
    fi
    return 1
}

# İstek dosyasına eylem satırını ekle: yayın engellenirse uygulama komutu dosyadan çalıştırır.
# `--es mode off` gibi anahtar/değer çiftleri `args=` satırına yazılır, böylece uygulama kip
# bilgisini kaybetmez (ör. `so ses kapat` yanlışlıkla sesi açmaz).
note_request_action() {
    [ -n "${REQUEST_FILE:-}" ] || return 0
    # Dosya yoksa (ör. `so ses +` istek yazmıyor) yine de oluştur: yayın engellenirse uygulama
    # komutu bu dosyadan alır.
    if [ ! -f "$REQUEST_FILE" ]; then
        mkdir -p "$REQUEST_DIR" 2>/dev/null
        {
            printf 'created=%s\n' "$(date +%s 2>/dev/null || echo 0)"
            printf 'command=%s\n' "${COMMAND_NAME:-mio}"
        } > "$REQUEST_FILE" 2>/dev/null
    fi
    [ -f "$REQUEST_FILE" ] || return 0
    action=""
    args=""
    key=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -a)
                [ $# -ge 2 ] || break
                action="$2"
                shift 2
                ;;
            --es|--ei|--ez|--el)
                [ $# -ge 2 ] || break
                key="$2"
                shift 2
                ;;
            *)
                if [ -n "$key" ]; then
                    args="$args${args:+ }$key $1"
                    key=""
                fi
                shift
                ;;
        esac
    done
    if [ -n "$action" ] && ! grep -q "^action=" "$REQUEST_FILE" 2>/dev/null; then
        printf 'action=%s\n' "$action" >> "$REQUEST_FILE" 2>/dev/null
    fi
    if [ -n "$args" ] && ! grep -q "^args=" "$REQUEST_FILE" 2>/dev/null; then
        printf 'args=%s\n' "$args" >> "$REQUEST_FILE" 2>/dev/null
    fi
    return 0
}

send_command() {
    note_request_action "$@"
    if run_am broadcast "$@" >/dev/null 2>&1; then
        return 0
    fi
    # Yedek yol: servise startservice ile gönder. Bileşen adı com.mio olmalı; eski com.termux
    # bileşeni bu uygulamada yok ve istek sessizce kaybolurdu.
    if run_am startservice -n com.mio/com.termux.app.TermuxService "$@" >/dev/null 2>&1; then
        return 0
    fi
    # Son çare: istek dosyası yazıldıysa uygulama onu 600 ms içinde okuyup komutu çalıştırır.
    if [ -n "${REQUEST_FILE:-}" ] && [ -f "$REQUEST_FILE" ]; then
        return 0
    fi
    return 1
}

# İstek dosyasını yaz: dosya yollarındaki boşluk gibi karakterlerin
# `am broadcast` tarafından bozulmaması için bilgiler dosyaya yazılır.
write_request() {
    mkdir -p "$REQUEST_DIR" 2>/dev/null
    {
        printf 'created=%s\n' "$(date +%s 2>/dev/null || echo 0)"
        printf '%s\n' "$@"
    } > "$REQUEST_FILE" 2>/dev/null
}

# Dosya yolunu mutlak yola çevir
absolute_path() {
    case "$1" in
        /*) printf '%s' "$1" ;;
        "~/"*) printf '%s/%s' "$HOME" "${1#\~/}" ;;
        *) printf '%s/%s' "$(pwd)" "$1" ;;
    esac
}

if [ $# -eq 0 ]; then
    # Argüman yok: bulunduğumuz klasördeki ilk fotoğraf/video
    write_request "command=swset" "name=" "media_type=" "audio=0" "dir=$(pwd)"
    send_command -a "$ACTION_SET" || exit 1
    exit 0
fi

case "$1" in
    -h|--help|help)
        usage
        exit 0
        ;;
    off|clear|temizle|kapat)
        send_command -a "$ACTION_CLEAR" || exit 1
        exit 0
        ;;
    status|durum)
        send_command -a "$ACTION_STATUS" || exit 1
        exit 0
        ;;
    image|foto|fotograf|resim)
        write_request "command=swset" "name=" "media_type=image" "audio=0" "dir=$(pwd)"
        send_command -a "$ACTION_SET" || exit 1
        exit 0
        ;;
    video)
        write_request "command=swset" "name=" "media_type=video" "audio=0" "dir=$(pwd)"
        send_command -a "$ACTION_SET" || exit 1
        exit 0
        ;;
    ses|audio|sesi-ac|unmute)
        # `swset ses` opens the media audio stream so that the video can be heard while it keeps
        # playing (the video is muted by the player, the audio comes from the player itself), and
        # `swset ses kapat` closes it again.
        if [ "$2" = "kapat" ] || [ "$2" = "off" ] || [ "$2" = "sessiz" ]; then
            write_request "command=swset" "name=" "media_type=" "audio=0" "dir=$(pwd)"
            send_command -a "$ACTION_AUDIO_STREAM" --es mode off || exit 1
            printf 'swset: ses akışı kapatıldı\n'
        else
            write_request "command=swset" "name=" "media_type=" "audio=1" "dir=$(pwd)"
            send_command -a "$ACTION_AUDIO_STREAM" --es mode on || exit 1
            printf 'swset: ses akışı açıldı (video sesi duyulur)\n'
        fi
        exit 0
        ;;
    --ses|--audio|-s)
        shift
        if [ $# -eq 0 ]; then
            printf 'swset: --ses için bir dosya adı gerekli\n' >&2
            exit 2
        fi
        AUDIO="1"
        FILE="$*"
        ;;
    *)
        AUDIO="0"
        FILE="$*"
        ;;
esac

FULL_PATH="$(absolute_path "$FILE")"

if [ ! -f "$FULL_PATH" ]; then
    # Dosya burada yoksa, uygulama $HOME ve alt klasörlerinde arayacak
    printf 'swset: "%s" bu klasörde yok, $HOME altında aranacak\n' "$FILE" >&2
fi

write_request "command=swset" "name=$FULL_PATH" "media_type=" "audio=$AUDIO" "dir=$(pwd)"

if ! send_command -a "$ACTION_SET"; then
    printf 'swset: komut uygulamaya iletilemedi, Termux uygulaması açık mı?\n' >&2
    exit 1
fi

printf 'swset: "%s" arka plana ayarlanıyor\n' "$FILE"
if [ "$AUDIO" = "1" ]; then
    printf 'swset: ses açık\n'
else
    printf 'swset: video sessiz, sesi açmak için: so\n'
fi

exit 0
